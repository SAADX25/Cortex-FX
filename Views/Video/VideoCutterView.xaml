<UserControl x:Class="CortexFX.Views.Video.VideoCutterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
             mc:Ignorable="d" d:DesignHeight="680" d:DesignWidth="1040"
             FontFamily="Segoe UI" Focusable="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             Background="#121212"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CutterTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <ItemsPanelTemplate x:Key="ProjectWrapItemsPanel">
                <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>

            <ItemsPanelTemplate x:Key="ProjectStackItemsPanel">
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>

            <!-- Adobe Premiere Media Bin Card Template (Square/Tile Grid for Video & Audio Assets) -->
            <DataTemplate x:Key="ProjectTileTemplate">
                <Border Width="{Binding ProjectTileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Background="#181A20" CornerRadius="4" Margin="0,0,6,6" Cursor="Hand"
                        PreviewMouseLeftButtonDown="MediaBinCard_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="MediaBinCard_PreviewMouseMove"
                        MouseLeftButtonUp="MediaBinCard_MouseLeftButtonUp"
                        MouseRightButtonUp="MediaBinCard_MouseRightButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#2B2E38"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#4A5568"/>
                                    <Setter Property="Background" Value="#1E2129"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2D8CFF"/>
                                    <Setter Property="Background" Value="#1A293C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 16:9 Thumbnail / Custom Format Audio Emblem Box -->
                        <Border Grid.Row="0" Background="#0D0E12" CornerRadius="3,3,0,0" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding BinThumbnail}" Stretch="UniformToFill"/>

                                <!-- Format-Specific Audio Card Visual (MP3, WAV, FLAC, M4A, AAC, OGG...) -->
                                <Border Visibility="{Binding IsAudioOnly, Converter={StaticResource BoolToVis}}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0D1620" Offset="0"/>
                                            <GradientStop Color="#121C29" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid>
                                        <!-- Decorative Spectrum Bars Behind Audio Icon -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Opacity="0.22" IsHitTestVisible="False">
                                            <Border Width="3" Height="14" CornerRadius="1" Background="{Binding AudioAccentHex}" Margin="1.5,0"/>
                                            <Border Width="3" Height="28" CornerRadius="1" Background="{Binding AudioAccentHex}" Margin="1.5,0"/>
                                            <Border Width="3" Height="20" CornerRadius="1" Background="{Binding AudioAccentHex}" Margin="1.5,0"/>
                                            <Border Width="3" Height="36" CornerRadius="1" Background="{Binding AudioAccentHex}" Margin="1.5,0"/>
                                            <Border Width="3" Height="24" CornerRadius="1" Background="{Binding AudioAccentHex}" Margin="1.5,0"/>
                                            <Border Width="3" Height="32" CornerRadius="1" Background="{Binding AudioAccentHex}" Margin="1.5,0"/>
                                            <Border Width="3" Height="16" CornerRadius="1" Background="{Binding AudioAccentHex}" Margin="1.5,0"/>
                                            <Border Width="3" Height="26" CornerRadius="1" Background="{Binding AudioAccentHex}" Margin="1.5,0"/>
                                        </StackPanel>

                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AudioSymbolGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                                       Foreground="{Binding AudioAccentHex}" HorizontalAlignment="Center"/>
                                            <Border Background="#CC0A1016" BorderBrush="{Binding AudioAccentHex}" BorderThickness="1"
                                                    CornerRadius="2" Padding="5,1" Margin="0,3,0,0" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding FormatExtension}" FontSize="8.5" FontWeight="Bold"
                                                           FontFamily="Consolas" Foreground="{Binding AudioAccentHex}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Subtle Bottom Gradient Scrim -->
                                <Border VerticalAlignment="Bottom" Height="22" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#C8080A0E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Top-Left Media Index Only -->
                                <Border Background="#CC111318" BorderBrush="#40FFFFFF" BorderThickness="1"
                                        CornerRadius="2" Padding="5,1" HorizontalAlignment="Left"
                                        VerticalAlignment="Top" Margin="4">
                                    <TextBlock Text="{Binding BinOrderIndex, StringFormat=#\{0\}}"
                                               Foreground="#F3F4F6" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>

                                <!-- Bottom-Right Duration Pill -->
                                <Border Background="#CC0E1015" CornerRadius="2" Padding="4,1"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4">
                                    <TextBlock Text="{Binding DisplayDuration}" Foreground="#E6ECF5"
                                               FontFamily="Consolas" FontSize="9" FontWeight="SemiBold"/>
                                </Border>

                                <!-- Top-Right Hover/Selected Delete Button Only -->
                                <Button x:Name="TileDeleteBtn" Style="{StaticResource TinyClipButton}"
                                        Content="×" Width="18" Height="18" MinWidth="18" MinHeight="18"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                        Click="MediaBinRemove_Click" Tag="{Binding}"
                                        Background="#D9261619" Foreground="{StaticResource DangerColor}"
                                        ToolTip="Remove media from Project Bin" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Bottom File Name & Spec Caption -->
                        <StackPanel Grid.Row="1" Margin="6,4,6,5">
                            <TextBlock Text="{Binding FileName}" Foreground="#EAECEF"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplaySpec}" Foreground="#8A92A0"
                                           FontSize="9" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#122B30" BorderBrush="{Binding AudioAccentHex}" BorderThickness="1"
                                        CornerRadius="2" Padding="4,0" Margin="3,0,0,0"
                                        Visibility="{Binding IsAudioOnly, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding FormatExtension}" Foreground="{Binding AudioAccentHex}" FontSize="7.5" FontWeight="Bold" FontFamily="Consolas"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="TileDeleteBtn" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="TileDeleteBtn" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Compact List Row Template (Optional Toggle) -->
            <DataTemplate x:Key="ProjectListTemplate">
                <Border Background="#181818" CornerRadius="3" Padding="6,5"
                        Margin="0,0,0,4" Cursor="Hand"
                        PreviewMouseLeftButtonDown="MediaBinCard_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="MediaBinCard_PreviewMouseMove"
                        MouseLeftButtonUp="MediaBinCard_MouseLeftButtonUp"
                        MouseRightButtonUp="MediaBinCard_MouseRightButtonUp">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#2C2C2C"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#2D8CFF"/>
                                    <Setter Property="Background" Value="#1E2A3A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="26" CornerRadius="2"
                                Background="#0D0D0D" BorderBrush="#333333" BorderThickness="1"
                                ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding BinThumbnail}" Stretch="UniformToFill"/>
                                <Border Background="#0F1824"
                                        Visibility="{Binding IsAudioOnly, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding AudioSymbolGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{Binding AudioAccentHex}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="7,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" Foreground="#E2E2E2"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Foreground="#8E8E8E" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                <Run Text="{Binding DisplayDuration, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding DisplaySpec, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource TinyClipButton}" Content="×"
                                Click="MediaBinRemove_Click" Tag="{Binding}" VerticalAlignment="Center"
                                Foreground="{StaticResource DangerColor}"
                                ToolTip="Remove media from Project Bin"/>
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Studio Bar -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="#2B2B2B"
                BorderThickness="0,0,0,1" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource PremiereIconButton}" Click="BackButton_Click"
                            Width="26" Height="24" Padding="0" Margin="0,0,8,0"
                            AutomationProperties.Name="Back to tools"
                            ToolTip="Back to tools · keeps your session active">
                        <Path Data="M15,4 L7,12 L15,20 M7,12 H21" Stroke="#C8C8C8" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                    <TextBlock Text="Video Cutter" Foreground="{StaticResource TextPrimary}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#1B3557" BorderBrush="#2D8CFF" BorderThickness="1"
                            CornerRadius="2" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PRO STUDIO" FontSize="8.5" FontWeight="Bold" Foreground="#9ACAFF"/>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="FileNameText" Grid.Column="1" Text="No media loaded"
                           Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" Margin="14,0,12,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BackgroundJobBadge" Visibility="Collapsed"
                            Background="#193429" BorderBrush="#2E8B64" BorderThickness="1"
                            CornerRadius="3" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="5" Height="5" Fill="#34D399" Margin="0,0,5,0"/>
                            <TextBlock Text="Exporting" FontSize="10.5" Foreground="#A7F3D0" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="WorkspaceLayoutButton" Click="WorkspaceLayoutButton_Click"
                            Style="{StaticResource QuietButton}" Visibility="Collapsed"
                            Width="28" Height="26" MinHeight="26" Padding="0" Margin="0,0,4,0"
                            ToolTip="Customize workspace panels &amp; presets"
                            AutomationProperties.Name="Workspace layout">
                        <Path Data="M3,3 H10 V17 H3 Z M13,3 H21 V9 H13 Z M13,12 H21 V17 H13 Z"
                              Stroke="#E2E2E2" StrokeThickness="1.5" StrokeLineJoin="Round"
                              Width="13" Height="11" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="HeaderAddClipButton" Click="ImportMediaToBin_Click"
                            Style="{StaticResource QuietButton}" Visibility="Collapsed"
                            Width="28" Height="26" MinHeight="26" Padding="0" Margin="0,0,4,0"
                            ToolTip="Import Video or Audio files to Project Bin"
                            AutomationProperties.Name="Import media">
                        <Path Data="M2,4 H13 V15 H2 Z M17,6 V12 M14,9 H20" Stroke="#E2E2E2" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="14" Height="11" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="PreviewFocusButton" Click="PreviewFocusButton_Click"
                            Style="{StaticResource QuietButton}" Visibility="Collapsed"
                            Width="28" Height="26" MinHeight="26" Padding="0" Margin="0,0,4,0"
                            ToolTip="Focus preview (F)"
                            AutomationProperties.Name="Focus preview">
                        <TextBlock x:Name="PreviewFocusIcon" Text="&#xE740;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#E2E2E2"/>
                    </Button>
                    <Button x:Name="HeaderClearButton" Click="ClearFile_Click"
                            Style="{StaticResource DangerButton}" Visibility="Collapsed"
                            Width="28" Height="26" MinHeight="26" Padding="0" Margin="0,0,6,0"
                            ToolTip="Clear project"
                            AutomationProperties.Name="Clear project">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FCA5A5"/>
                    </Button>
                    <Border x:Name="HeaderActionDivider" Visibility="Collapsed"
                            Width="1" Height="16" Background="#323232" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Button x:Name="ExportButton" Click="ExportButton_Click"
                            Style="{StaticResource PremierePrimaryButton}" Visibility="Collapsed"
                            Width="34" Height="26" MinHeight="26" Padding="0"
                            ToolTip="Export Cut"
                            AutomationProperties.Name="Export video">
                        <Path Data="M12,3 V13 M12,3 L7.5,7.5 M12,3 L16.5,7.5 M4,13 V17 A2,2 0 0 0 6,19 H18 A2,2 0 0 0 20,17 V13"
                              Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>
                    <Border x:Name="HeaderReadyPill" Background="#1F1F1F" BorderBrush="#333333" BorderThickness="1"
                            CornerRadius="2" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="ALL RESOLUTIONS · ALL FORMATS" FontSize="9" FontWeight="SemiBold" Foreground="#9A9A9A"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Empty Drop Zone -->
        <Grid x:Name="EmptyStatePanel" Grid.Row="1" Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="DropZoneBorder" CornerRadius="6" Background="#1B1B1B"
                    BorderBrush="#363636" BorderThickness="1.5"
                    AllowDrop="True" Drop="DropZone_Drop"
                    DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                    MouseLeftButtonUp="DropZone_Click" KeyDown="DropZone_KeyDown"
                    Focusable="True" Cursor="Hand"
                    FocusVisualStyle="{StaticResource CutterFocusVisual}"
                    AutomationProperties.Name="Open or drop video files to cut and assemble">
                <Grid>
                    <Rectangle Stroke="#383838" StrokeDashArray="5,5" RadiusX="4" RadiusY="4"
                               Margin="10" IsHitTestVisible="False"/>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                        <Border Width="58" Height="48" Background="#1D2B3D" BorderBrush="#2D8CFF"
                                BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Path Data="M3,5 H18 V19 H3 Z M7,5 V19 M14,5 V19 M18,9 L23,6 V18 L18,15"
                                  Stroke="#4EA1FF" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Width="24" Height="20" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Text="Import media to begin editing"
                                   Foreground="{StaticResource TextPrimary}" FontSize="20" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop one or more video files here to open the timeline workspace."
                                   Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                   HorizontalAlignment="Center" Margin="0,6,0,16"/>
                        <Button Content="Import Media" Click="ChooseVideo_Click"
                                Style="{StaticResource PremierePrimaryButton}" MinWidth="144" Height="34"
                                HorizontalAlignment="Center" FontSize="12.5"
                                AutomationProperties.Name="Import one or more video files"/>
                        <TextBlock Text="MP4 · MOV · MKV · WEBM · AVI · 4K · 9:16 Vertical · 16:9 Landscape · 1:1 Square"
                                   FontSize="11" Foreground="#8C8C8C" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="1" Columns="3" Margin="4,14,4,0">
                <StackPanel Margin="8,0">
                    <TextBlock Text="01  Import any format" Foreground="#DCDCDC" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Combine clips across different resolutions, FPS, or vertical &amp; horizontal ratios."
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="02  Premiere timeline" Foreground="#DCDCDC" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Jog frame-by-frame, Razor (C), Trim In/Out edges, or drag clips to reorder across V1/A1."
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Margin="8,0">
                    <TextBlock Text="03  Fast export" Foreground="#DCDCDC" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="GPU-accelerated Smart Render or instant Fast Copy to MP4, MOV, MKV, WEBM, AVI."
                               Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </UniformGrid>
        </Grid>

        <!-- Adobe Premiere Pro Customizable Dock Workspace -->
        <Grid x:Name="EditorPanel" Grid.Row="1" Visibility="Collapsed" Background="#121212"
              AllowDrop="True" Drop="EditorPanel_Drop">
            <Grid x:Name="FocusPreviewHost" Visibility="Collapsed" Margin="2"/>
            <Grid x:Name="WorkspaceDockHost" Margin="2">
                <!-- Dockable Panels (dynamically arranged & resizable by VideoCutterView.DockLayout.cs) -->

                <!-- PANEL 1: Program Monitor -->
                <Border x:Name="EditorLeftPanel" Style="{StaticResource PremierePanel}" MinWidth="280" MinHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Program Header Tab (Drag to Move/Swap Panel) -->
                        <Border x:Name="MonitorHeaderBar" Grid.Row="0" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="8,0">
                            <Grid>
                                <Border Tag="Program" Background="Transparent" BorderBrush="#2D8CFF" BorderThickness="0,0,0,2"
                                        Padding="2,4,8,3" HorizontalAlignment="Left" Cursor="SizeAll"
                                        MouseLeftButtonDown="DockPanelHeader_MouseLeftButtonDown"
                                        MouseMove="DockPanelHeader_MouseMove"
                                        MouseLeftButtonUp="DockPanelHeader_MouseLeftButtonUp"
                                        ToolTip="Drag tab to move or swap Program panel">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⋮⋮" FontSize="9.5" Foreground="#7A8290" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Program" Foreground="#E6E6E6" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="MonitorMediaHudText" Text="" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="#8C8C8C" FontSize="10.5"/>
                            </Grid>
                        </Border>

                        <!-- Clean Matte-Black Layered Video Stage (V1 + V2 + V3 Overlay + Dedicated A1..A4 Audio Channels) -->
                        <Grid x:Name="ProgramStageGrid" Grid.Row="1" Background="#000000" ClipToBounds="True"
                              MouseLeftButtonUp="MonitorSurface_MouseLeftButtonUp"
                              MouseLeftButtonDown="ProgramStage_MouseLeftButtonDown"
                              MouseMove="ProgramStage_MouseMove"
                              MouseLeave="ProgramStage_MouseLeave"
                              SizeChanged="ProgramStageGrid_SizeChanged">
                            <!-- Hidden FFME Audio Decoders for A1..A4 (synced or independent audio editing) -->
                            <ffme:MediaElement x:Name="Audio1Media" Tag="0" Width="1" Height="1" Opacity="0"
                                              IsHitTestVisible="False" Visibility="Hidden"
                                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                              MediaOpening="AudioChannelMedia_MediaOpening"
                                              MediaOpened="AudioChannelMedia_MediaOpened"
                                              MediaEnded="AudioChannelMedia_MediaEnded"
                                              MediaFailed="AudioChannelMedia_MediaFailed"/>
                            <ffme:MediaElement x:Name="Audio2Media" Tag="1" Width="1" Height="1" Opacity="0"
                                              IsHitTestVisible="False" Visibility="Hidden"
                                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                              MediaOpening="AudioChannelMedia_MediaOpening"
                                              MediaOpened="AudioChannelMedia_MediaOpened"
                                              MediaEnded="AudioChannelMedia_MediaEnded"
                                              MediaFailed="AudioChannelMedia_MediaFailed"/>
                            <ffme:MediaElement x:Name="Audio3Media" Tag="2" Width="1" Height="1" Opacity="0"
                                              IsHitTestVisible="False" Visibility="Hidden"
                                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                              MediaOpening="AudioChannelMedia_MediaOpening"
                                              MediaOpened="AudioChannelMedia_MediaOpened"
                                              MediaEnded="AudioChannelMedia_MediaEnded"
                                              MediaFailed="AudioChannelMedia_MediaFailed"/>
                            <ffme:MediaElement x:Name="AudioOverlayMedia" Tag="3" Width="1" Height="1" Opacity="0"
                                              IsHitTestVisible="False" Visibility="Hidden"
                                              LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                              MediaOpening="AudioChannelMedia_MediaOpening"
                                              MediaOpened="AudioChannelMedia_MediaOpened"
                                              MediaEnded="AudioChannelMedia_MediaEnded"
                                              MediaFailed="AudioChannelMedia_MediaFailed"/>

                            <!-- V1 Base Layer -->
                            <Grid x:Name="V1TransformHost" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <ffme:MediaElement x:Name="PreviewMedia" Background="#000000"
                                                  Stretch="Uniform" ScrubbingEnabled="True"
                                                  LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                  MediaOpening="PreviewMedia_MediaOpening"
                                                  MediaOpened="PreviewMedia_MediaOpened"
                                                  MediaEnded="PreviewMedia_MediaEnded"
                                                  MediaFailed="PreviewMedia_MediaFailed"/>
                            </Grid>

                            <!-- V2 Overlay Video Layer -->
                            <Grid x:Name="V2TransformHost" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                                <ffme:MediaElement x:Name="OverlayVideoMedia" Tag="1" Background="Transparent"
                                                  Stretch="Uniform" ScrubbingEnabled="True"
                                                  LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                  MediaOpening="OverlayVideoMedia_MediaOpening"
                                                  MediaOpened="OverlayVideoMedia_MediaOpened"
                                                  MediaEnded="OverlayVideoMedia_MediaEnded"
                                                  MediaFailed="OverlayVideoMedia_MediaFailed"/>
                            </Grid>

                            <!-- V3 Top Overlay Video Layer -->
                            <Grid x:Name="V3TransformHost" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed" IsHitTestVisible="False">
                                <ffme:MediaElement x:Name="OverlayVideo3Media" Tag="2" Background="Transparent"
                                                  Stretch="Uniform" ScrubbingEnabled="True"
                                                  LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                                  MediaOpening="OverlayVideoMedia_MediaOpening"
                                                  MediaOpened="OverlayVideoMedia_MediaOpened"
                                                  MediaEnded="OverlayVideoMedia_MediaEnded"
                                                  MediaFailed="OverlayVideoMedia_MediaFailed"/>
                            </Grid>

                            <!-- Target Aspect Preview Guide (only when targeting 9:16 or 1:1) -->
                            <Grid x:Name="AspectOverlayRoot" IsHitTestVisible="False" Visibility="Collapsed">
                                <Border x:Name="AspectTargetFrame" BorderBrush="#AA2D8CFF" BorderThickness="1.5"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="#AA141414" CornerRadius="2" Padding="5,1"
                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
                                        <TextBlock x:Name="AspectOverlayLabel" Text="TARGET 9:16"
                                                   FontSize="9" FontWeight="Bold" Foreground="#7AB8FF"/>
                                    </Border>
                                </Border>
                            </Grid>

                            <!-- Interactive Premiere Program Motion / Transform Bounding Overlay -->
                            <Canvas x:Name="ProgramTransformOverlayCanvas" Visibility="Collapsed" ClipToBounds="True" Panel.ZIndex="40">
                                <Line x:Name="TransformCenterGuideV" Stroke="#5538BDF8" StrokeThickness="1" StrokeDashArray="3,3" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <Line x:Name="TransformCenterGuideH" Stroke="#5538BDF8" StrokeThickness="1" StrokeDashArray="3,3" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <Border x:Name="TransformBoundingBox" BorderBrush="#2D8CFF" BorderThickness="1.5"
                                        Background="#01000000" Cursor="SizeAll" Tag="Move">
                                    <TextBlock x:Name="TransformBoxLabel" Text="MOTION"
                                               Foreground="#BFE0FF" Background="#CC0F1622" FontSize="8.5" FontWeight="Bold"
                                               Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2"
                                               IsHitTestVisible="False"/>
                                </Border>
                                <Border x:Name="HandleTL" Width="9" Height="9" Background="#FFFFFF" BorderBrush="#2D8CFF" BorderThickness="1.5" CornerRadius="1" Cursor="SizeNWSE" Tag="TL"/>
                                <Border x:Name="HandleTC" Width="9" Height="9" Background="#FFFFFF" BorderBrush="#2D8CFF" BorderThickness="1.5" CornerRadius="1" Cursor="SizeNS" Tag="TC"/>
                                <Border x:Name="HandleTR" Width="9" Height="9" Background="#FFFFFF" BorderBrush="#2D8CFF" BorderThickness="1.5" CornerRadius="1" Cursor="SizeNESW" Tag="TR"/>
                                <Border x:Name="HandleML" Width="9" Height="9" Background="#FFFFFF" BorderBrush="#2D8CFF" BorderThickness="1.5" CornerRadius="1" Cursor="SizeWE" Tag="ML"/>
                                <Border x:Name="HandleMR" Width="9" Height="9" Background="#FFFFFF" BorderBrush="#2D8CFF" BorderThickness="1.5" CornerRadius="1" Cursor="SizeWE" Tag="MR"/>
                                <Border x:Name="HandleBL" Width="9" Height="9" Background="#FFFFFF" BorderBrush="#2D8CFF" BorderThickness="1.5" CornerRadius="1" Cursor="SizeNESW" Tag="BL"/>
                                <Border x:Name="HandleBC" Width="9" Height="9" Background="#FFFFFF" BorderBrush="#2D8CFF" BorderThickness="1.5" CornerRadius="1" Cursor="SizeNS" Tag="BC"/>
                                <Border x:Name="HandleBR" Width="9" Height="9" Background="#FFFFFF" BorderBrush="#2D8CFF" BorderThickness="1.5" CornerRadius="1" Cursor="SizeNWSE" Tag="BR"/>
                                <Border x:Name="TransformHudPill" Background="#EA12151D" BorderBrush="#2D8CFF" BorderThickness="1"
                                        CornerRadius="3" Padding="7,2" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="TransformHudText" Text="Scale 100%" Foreground="#E6E6E6" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold"/>
                                </Border>
                            </Canvas>

                            <TextBlock x:Name="PreviewPlaceholder" Text="Loading program..."
                                       Foreground="{StaticResource TextSecondary}" FontSize="12.5"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>

                        <!-- Premiere Program Timecode, Scrub Bar, Motion Transform Bar & Transport -->
                        <Border Grid.Row="2" Background="#1D1D1D" BorderBrush="#2C2C2C" BorderThickness="0,1,0,0" Padding="10,4,10,5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="24"/>
                                    <RowDefinition Height="30"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Interactive Program Seek Bar with Clip Boundary Markers -->
                                <Grid Grid.Row="0" VerticalAlignment="Center">
                                    <Canvas x:Name="ProgramClipMarkersCanvas" Height="10" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                    <Slider x:Name="ProgramScrubSlider" Style="{StaticResource StudioSlider}"
                                            Minimum="0" Maximum="1000" Value="0" VerticalAlignment="Center"
                                            IsMoveToPointEnabled="True"
                                            PreviewMouseLeftButtonDown="ProgramScrubSlider_PreviewMouseDown"
                                            PreviewMouseLeftButtonUp="ProgramScrubSlider_PreviewMouseUp"
                                            ValueChanged="ProgramScrubSlider_ValueChanged"
                                            AutomationProperties.Name="Program video scrub timeline"
                                            ToolTip="Drag or click to jump anywhere in video"/>
                                </Grid>

                                <!-- Row 1: Blue SMPTE Timecode + Frame | Premiere Frame Jog Strip | Fit + Total -->
                                <Grid Grid.Row="1" Margin="0,1,0,1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock x:Name="PositionText" Text="00:00:00" Foreground="#4EA1FF"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="#141820" BorderBrush="#2A3444" BorderThickness="1"
                                                CornerRadius="2" Padding="5,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="FrameIndexText" Text="F 0 · 30fps" Foreground="#8FB4DC"
                                                       FontFamily="Consolas" FontSize="9.5" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Premiere Tactile Frame-by-Frame Jog Strip -->
                                    <Border x:Name="JogWheelBorder" Width="168" Height="20" CornerRadius="3"
                                            Background="#121318" BorderBrush="#353945" BorderThickness="1"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Cursor="SizeWE" ClipToBounds="True"
                                            MouseLeftButtonDown="JogWheel_MouseLeftButtonDown"
                                            MouseMove="JogWheel_MouseMove"
                                            MouseLeftButtonUp="JogWheel_MouseLeftButtonUp"
                                            MouseWheel="JogWheel_MouseWheel"
                                            ToolTip="Drag left/right or scroll to scrub frame-by-frame like Premiere Jog Wheel">
                                        <Grid>
                                            <Canvas x:Name="JogTicksCanvas" IsHitTestVisible="False"/>
                                            <Rectangle Width="2" Height="18" Fill="#2D8CFF" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                                            <TextBlock Text="◀  FRAME JOG  ▶" FontSize="8" FontWeight="SemiBold"
                                                       Foreground="#7C8594" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" Opacity="0.72"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="#161616" BorderBrush="#333333" BorderThickness="1"
                                                CornerRadius="2" Padding="7,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="MonitorFitBadgeText" Text="Fit" Foreground="#BDBDBD" FontSize="10"/>
                                        </Border>
                                        <TextBlock x:Name="MonitorTotalText" Text="00:00:00" Foreground="#CFCFCF"
                                                   FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 2: Left Expand + Frame Transform Toggle | Centered Frame Transport | Right Volume -->
                                <Grid Grid.Row="2" Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Button x:Name="MonitorExpandButton" Style="{StaticResource QuietButton}"
                                                Click="PreviewFocusButton_Click" MinHeight="25" Padding="8,2" Margin="0,0,5,0"
                                                ToolTip="Expand video to full view (F · Esc to exit)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="MonitorExpandIcon" Text="&#xE740;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12" Foreground="#4EA1FF" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock x:Name="MonitorExpandLabel" Text="Full view" FontSize="11"
                                                           Foreground="#E6E6E6" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <ToggleButton x:Name="TransformToggleBtn" Style="{StaticResource LoopToggleStyle}"
                                                      Height="25" Padding="7,2" Click="TransformToggle_Click"
                                                      ToolTip="Premiere Motion Controls — Move, Resize/Scale frame, Fit/Fill &amp; Opacity">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE799;" FontFamily="Segoe MDL2 Assets" FontSize="11.5"
                                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="Motion"/>
                                            </StackPanel>
                                        </ToggleButton>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource PremiereIconButton}" Click="NudgeBack_Click"
                                                ToolTip="Back 1 second (J · Shift+J for 0.1s)">
                                            <TextBlock Text="−1s" FontSize="10.5" Foreground="#BDBDBD"/>
                                        </Button>
                                        <RepeatButton Style="{StaticResource PremiereRepeatIconButton}" Click="StepBackFrame_Click"
                                                      Delay="240" Interval="65"
                                                      ToolTip="Step Back 1 Frame — hold to step continuously (Left / , · Shift+Left for 5f)">
                                            <TextBlock Text="◀|" FontSize="10.5" Foreground="#E2E2E2"/>
                                        </RepeatButton>
                                        <Button Style="{StaticResource PremiereIconButton}" Click="PlayPause_Click"
                                                Width="32" ToolTip="Play / Pause (Space / K)">
                                            <TextBlock x:Name="PlayPauseIcon" Text="&#xE768;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                       Foreground="#FFFFFF"/>
                                        </Button>
                                        <RepeatButton Style="{StaticResource PremiereRepeatIconButton}" Click="StepForwardFrame_Click"
                                                      Delay="240" Interval="65"
                                                      ToolTip="Step Forward 1 Frame — hold to step continuously (Right / . · Shift+Right for 5f)">
                                            <TextBlock Text="|▶" FontSize="10.5" Foreground="#E2E2E2"/>
                                        </RepeatButton>
                                        <Button Style="{StaticResource PremiereIconButton}" Click="NudgeForward_Click"
                                                ToolTip="Forward 1 second (L · Shift+L for 0.1s)">
                                            <TextBlock Text="+1s" FontSize="10.5" Foreground="#BDBDBD"/>
                                        </Button>
                                        <Button x:Name="SpeedButton" Style="{StaticResource PremiereIconButton}" Content="1.0×"
                                                Click="CycleSpeed_Click" FontSize="10.5" Foreground="#4EA1FF" Margin="4,0,0,0"
                                                ToolTip="Preview playback speed (0.25×, 0.5×, 1.0×, 1.5×, 2.0×)"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="MuteButton" Style="{StaticResource PremiereIconButton}"
                                                Click="MuteToggle_Click" Width="28" Height="26"
                                                ToolTip="Mute / unmute preview (M)">
                                            <TextBlock x:Name="MuteIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14.5" Foreground="#D4D4D4"/>
                                        </Button>
                                        <Slider x:Name="VolumeSlider" Style="{StaticResource StudioSlider}"
                                                Width="96" Minimum="0" Maximum="1" Value="1" Margin="2,0,5,0"
                                                ValueChanged="VolumeSlider_ValueChanged"
                                                AutomationProperties.Name="Preview volume" ToolTip="Preview volume"/>
                                        <TextBlock x:Name="VolumePercentText" Text="100%" Foreground="#C8C8C8"
                                                   FontFamily="Consolas" FontSize="10.5" Width="34"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Row 3: Expandable Premiere Motion & Frame Control Strip -->
                                <Border x:Name="ProgramTransformBar" Grid.Row="3" Visibility="Collapsed"
                                        Background="#141923" BorderBrush="#2A3B54" BorderThickness="1" CornerRadius="4"
                                        Margin="0,5,0,0" Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <Border Background="#1B3557" BorderBrush="#2D8CFF" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock x:Name="TransformClipBadgeText" Text="V1" Foreground="#9ACAFF" FontSize="8.5" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock x:Name="TransformPosText" Text="X 0 · Y 0" Foreground="#9EB0C7"
                                                       FontFamily="Consolas" FontSize="9.5" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Scale" Foreground="#A5B4C8" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <Slider x:Name="FrameScaleSlider" Style="{StaticResource StudioSlider}"
                                                    Width="92" Minimum="15" Maximum="250" Value="100" VerticalAlignment="Center"
                                                    PreviewMouseLeftButtonDown="FrameTransformSlider_PreviewMouseDown"
                                                    ValueChanged="FrameScaleSlider_ValueChanged"
                                                    PreviewMouseLeftButtonUp="FrameTransformSlider_PreviewMouseUp"
                                                    LostMouseCapture="FrameTransformSlider_LostMouseCapture"
                                                    ToolTip="Scale frame 15% - 250%"/>
                                            <TextBlock x:Name="FrameScaleText" Text="100%" Foreground="#7AB8FF"
                                                       FontFamily="Consolas" FontSize="9.5" Width="36" VerticalAlignment="Center" Margin="4,0,10,0"/>

                                            <TextBlock Text="Opacity" Foreground="#A5B4C8" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <Slider x:Name="FrameOpacitySlider" Style="{StaticResource StudioSlider}"
                                                    Width="68" Minimum="0" Maximum="100" Value="100" VerticalAlignment="Center"
                                                    PreviewMouseLeftButtonDown="FrameTransformSlider_PreviewMouseDown"
                                                    ValueChanged="FrameOpacitySlider_ValueChanged"
                                                    PreviewMouseLeftButtonUp="FrameTransformSlider_PreviewMouseUp"
                                                    LostMouseCapture="FrameTransformSlider_LostMouseCapture"
                                                    ToolTip="Clip opacity (0% - 100%)"/>
                                            <TextBlock x:Name="FrameOpacityText" Text="100%" Foreground="#D4DCE8"
                                                       FontFamily="Consolas" FontSize="9.5" Width="34" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource TinyClipButton}" Content="Fit" Tag="Fit"
                                                    Click="FramePreset_Click" Margin="0,0,3,0" ToolTip="Fit entire video inside screen (100%)"/>
                                            <Button Style="{StaticResource TinyClipButton}" Content="Full" Tag="Fill"
                                                    Click="FramePreset_Click" Margin="0,0,3,0" ToolTip="Fill full monitor screen cleanly"/>
                                            <Button Style="{StaticResource TinyClipButton}" Content="PiP" Tag="PiP"
                                                    Click="FramePreset_Click" Margin="0,0,3,0" ToolTip="Corner Picture-in-Picture (38%)"/>
                                            <Button Style="{StaticResource TinyClipButton}" Content="Reset" Tag="Reset"
                                                    Click="FramePreset_Click" Foreground="#7CE2F7" ToolTip="Reset position, scale &amp; opacity"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <!-- PANEL 2: Project Media Bin (Decoupled Video & Audio Sources — Drag to Timeline) -->
                <Border x:Name="ProjectPanelBorder" Style="{StaticResource PremierePanel}" MinWidth="185" MinHeight="140"
                        AllowDrop="True" DragOver="ProjectPanel_DragOver" Drop="ProjectPanel_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="26"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="8,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Border Tag="Project" Background="Transparent" BorderBrush="#2D8CFF" BorderThickness="0,0,0,2"
                                            Padding="2,4,6,3" Cursor="SizeAll"
                                            MouseLeftButtonDown="DockPanelHeader_MouseLeftButtonDown"
                                            MouseMove="DockPanelHeader_MouseMove"
                                            MouseLeftButtonUp="DockPanelHeader_MouseLeftButtonUp"
                                            ToolTip="Drag tab to move or swap Project panel">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⋮⋮" FontSize="9.5" Foreground="#7A8290" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Project" Foreground="#E6E6E6" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="SegmentsSummaryText" Text="0 · 00:00.0"
                                               Foreground="#8C8C8C" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="6,6,0,6">
                            <ItemsControl x:Name="ClipsList"
                                          ItemsPanel="{StaticResource ProjectWrapItemsPanel}"
                                          ItemTemplate="{StaticResource ProjectTileTemplate}"/>
                        </ScrollViewer>

                        <!-- Premiere Project Bin Bottom Action & View Bar -->
                        <Border Grid.Row="2" Background="#16171B" BorderBrush="#2B2C32" BorderThickness="0,1,0,0" Padding="6,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ToggleButton x:Name="ProjectListViewBtn" Style="{StaticResource PremiereToolToggle}"
                                                  Width="21" Height="19" Margin="0,0,2,0"
                                                  Click="ProjectListViewBtn_Click"
                                                  ToolTip="List view">
                                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="ProjectGridViewBtn" Style="{StaticResource PremiereToolToggle}"
                                                  Width="21" Height="19" IsChecked="True" Margin="0,0,6,0"
                                                  Click="ProjectGridViewBtn_Click"
                                                  ToolTip="Icon thumbnail grid view">
                                        <TextBlock Text="&#xF0E2;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </ToggleButton>
                                    <Slider x:Name="ProjectTileSizeSlider" Style="{StaticResource StudioSlider}"
                                            Width="56" Minimum="96" Maximum="200" Value="128"
                                            VerticalAlignment="Center"
                                            ValueChanged="ProjectTileSizeSlider_ValueChanged"
                                            AutomationProperties.Name="Project tile size"
                                            ToolTip="Resize media tiles"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource TinyClipButton}" Content="+ Media"
                                            Click="ImportMediaToBin_Click" Foreground="#4EA1FF"
                                            ToolTip="Import Video or Audio files to Project Bin — drag onto Timeline"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- PANEL 3: Vertical Premiere Tool Strip + Timeline (V1 & A1) -->
                <Grid x:Name="CutterTimelinePanel" MinWidth="320" MinHeight="205">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vertical Premiere Essential Toolbar -->
                    <Border Grid.Column="0" Style="{StaticResource PremierePanel}" Padding="3,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel HorizontalAlignment="Center">
                                <ToggleButton x:Name="SelectToolBtn" Style="{StaticResource PremiereToolToggle}"
                                              IsChecked="True" Click="SelectTool_Click" Margin="0,0,0,4"
                                              ToolTip="Selection Tool (V) — Scrub frames, trim clip edges, drag clip header to reorder">
                                    <Path Data="M4,2 L4,14 L7.5,11 L10,16 L11.8,15 L9.3,10 L13.5,10 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          Width="12" Height="14" Stretch="Uniform"/>
                                </ToggleButton>
                                <ToggleButton x:Name="RazorToolBtn" Style="{StaticResource PremiereToolToggle}"
                                              Click="RazorTool_Click" Margin="0,0,0,4"
                                              ToolTip="Razor Tool (C) — Click anywhere on a clip to cut at exact frame">
                                    <Path Data="M3,3 L13,13 M13,3 L3,13 M3,13 A2,2 0 1 1 3,16.5 A2,2 0 1 1 3,13 M13,13 A2,2 0 1 1 13,16.5 A2,2 0 1 1 13,13"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/>
                                </ToggleButton>
                                <ToggleButton x:Name="MoveToolBtn" Style="{StaticResource PremiereToolToggle}"
                                              Click="MoveTool_Click" Margin="0,0,0,5"
                                              ToolTip="Reorder Tool (A) — Drag any clip smoothly to move it to another spot">
                                    <Path Data="M8,1 L10.5,3.5 M8,1 L5.5,3.5 M8,15 L10.5,12.5 M8,15 L5.5,12.5 M1,8 L3.5,5.5 M1,8 L3.5,10.5 M15,8 L12.5,5.5 M15,8 L12.5,10.5 M8,1 V15 M1,8 H15"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="13" Height="13" Stretch="Uniform"/>
                                </ToggleButton>
                                <Border Height="1" Background="#323232" Width="22" Margin="0,1,0,5"/>
                                <Button Style="{StaticResource PremiereIconButton}" Click="SplitAtPlayhead_Click"
                                        Width="28" Height="25" Margin="0,0,0,3"
                                        ToolTip="Split clip at playhead (S / Ctrl+B)">
                                    <TextBlock Text="✂" FontSize="12" Foreground="#4EA1FF"/>
                                </Button>
                                <Button Style="{StaticResource PremiereIconButton}" Click="DeleteSelectedClip_Click"
                                        Width="28" Height="25" ToolTip="Delete selected clip (Del)">
                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FCA5A5"/>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Timeline Panel -->
                    <Border Grid.Column="2" Style="{StaticResource PremierePanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Timeline Header -->
                            <Border Grid.Row="0" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Tag="Timeline" Background="Transparent" BorderBrush="#2D8CFF" BorderThickness="0,0,0,2"
                                                Padding="2,4,6,3" Cursor="SizeAll"
                                                MouseLeftButtonDown="DockPanelHeader_MouseLeftButtonDown"
                                                MouseMove="DockPanelHeader_MouseMove"
                                                MouseLeftButtonUp="DockPanelHeader_MouseLeftButtonUp"
                                                ToolTip="Drag tab to move or swap Timeline panel">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⋮⋮" FontSize="9.5" Foreground="#7A8290" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Timeline" Foreground="#E6E6E6" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TimelineTimecodeText" Text="00:00:00" Foreground="#4EA1FF"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                                   Margin="8,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TimelineFrameBadge" Text="F 0" Foreground="#83A6CC"
                                                   FontFamily="Consolas" FontSize="9.5" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <Button x:Name="UndoButton" Style="{StaticResource PremiereIconButton}"
                                                Click="Undo_Click" Width="21" Height="19" Margin="0,0,2,0"
                                                IsEnabled="False" ToolTip="Undo (Ctrl+Z)">
                                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                        </Button>
                                        <Button x:Name="RedoButton" Style="{StaticResource PremiereIconButton}"
                                                Click="Redo_Click" Width="21" Height="19"
                                                IsEnabled="False" ToolTip="Redo (Ctrl+Y)">
                                            <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                        </Button>
                                    </StackPanel>

                                    <Grid Grid.Column="1" ClipToBounds="True" Margin="6,0">
                                        <StackPanel x:Name="TimelineSummaryPanel" Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="CLIP " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SelectedClipDurationText" Text="00:00:00" Foreground="#CFCFCF"
                                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="TOTAL " Foreground="{StaticResource TextMuted}" FontSize="9" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="MontageTotalText" Text="00:00:00" Foreground="#4EA1FF"
                                                       FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border x:Name="RazorModeHint" Visibility="Collapsed"
                                                Background="#2B181A" BorderBrush="#F87171" BorderThickness="1"
                                                CornerRadius="2" Padding="7,1"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="ToolModeHintText" Text="Razor · Click clip · Esc"
                                                       Foreground="#FCA5A5" FontSize="9.5" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border x:Name="TimelineToastBanner" Visibility="Collapsed"
                                                Background="#15283E" BorderBrush="#2D8CFF" BorderThickness="1"
                                                CornerRadius="3" Padding="8,1"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="TimelineToastText" Text=""
                                                       Foreground="#BFE0FF" FontSize="9.5" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton x:Name="SnapToggle" Style="{StaticResource LoopToggleStyle}"
                                                      IsChecked="True" Click="SnapToggle_Click" Margin="0,0,4,0"
                                                      ToolTip="Snap playhead &amp; trims to clip edges (N)">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M3,2 V7 A4,4 0 0 0 11,7 V2 M3,4.5 H5.5 M8.5,4.5 H11"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                      StrokeThickness="1.3" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0"/>
                                                <TextBlock Text="Snap"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <ToggleButton x:Name="LoopToggle" Style="{StaticResource LoopToggleStyle}"
                                                      Content="Loop" Margin="0,0,6,0" ToolTip="Loop montage playback"/>
                                        <Button Style="{StaticResource TinyClipButton}" Content="−" Click="ZoomOut_Click" ToolTip="Zoom out (-)"/>
                                        <Slider x:Name="ZoomSlider" Style="{StaticResource StudioSlider}"
                                                Width="68" Minimum="0" Maximum="100" Value="0" Margin="3,0"
                                                ValueChanged="ZoomSlider_ValueChanged"
                                                AutomationProperties.Name="Timeline zoom"
                                                ToolTip="Zoom timeline from Fit all the way down to individual frames (Ctrl+Wheel)"/>
                                        <Button Style="{StaticResource TinyClipButton}" Content="+" Click="ZoomIn_Click" ToolTip="Zoom in (=)"/>
                                        <TextBlock x:Name="ZoomReadoutText" Text="1.0×" Foreground="#8FA3BA"
                                                   FontFamily="Consolas" FontSize="9.5" Margin="4,0,4,0" VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource TinyClipButton}" Content="Fit" Click="ZoomFit_Click"
                                                ToolTip="Fit full timeline (\)"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Expandable Premiere Audio Level Control Strip (A1 / A2 / A3 / A4) -->
                            <Border x:Name="AudioGainStrip" Grid.Row="1" Visibility="Collapsed"
                                    Background="#151D24" BorderBrush="#28414F" BorderThickness="0,0,0,1" Padding="10,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Border Background="#1B4657" BorderBrush="#41A7C4" BorderThickness="1"
                                                CornerRadius="2" Padding="5,1" Margin="0,0,7,0">
                                            <TextBlock x:Name="AudioGainTrackBadgeText" Text="A1 LEVEL" Foreground="#9CE9FA" FontSize="8.5" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock x:Name="AudioGainClipTitle" Text="Clip #1"
                                                   Foreground="#D6E6EE" FontSize="10.5" FontWeight="SemiBold"
                                                   MaxWidth="140" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="AudioRestoreBtn" Style="{StaticResource TinyClipButton}"
                                                Content="+ Restore Audio" Visibility="Collapsed"
                                                Click="AudioRestoreBtn_Click" Foreground="#38BDF8" Margin="8,0,0,0"
                                                ToolTip="Separate / restore this video's audio onto its dedicated audio track"/>
                                    </StackPanel>

                                    <Grid x:Name="AudioGainControlsHost" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*" MinWidth="75" MaxWidth="175"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton x:Name="AudioClipMuteBtn" Grid.Column="0"
                                                      Style="{StaticResource TrackBadgeToggle}"
                                                      Content="Mute" Width="36" Margin="0,0,7,0"
                                                      Click="AudioClipMuteBtn_Click"
                                                      ToolTip="Mute selected clip audio (-∞ dB)"/>
                                        <TextBlock Grid.Column="1" Text="-∞" Foreground="#6D8490" FontSize="9" FontFamily="Consolas"
                                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Slider x:Name="AudioGainSlider" Grid.Column="2" Style="{StaticResource StudioSlider}"
                                                Minimum="0" Maximum="200" Value="100"
                                                VerticalAlignment="Center"
                                                PreviewMouseLeftButtonDown="AudioGainSlider_PreviewMouseLeftButtonDown"
                                                ValueChanged="AudioGainSlider_ValueChanged"
                                                PreviewMouseLeftButtonUp="AudioGainSlider_PreviewMouseLeftButtonUp"
                                                LostMouseCapture="AudioGainSlider_LostMouseCapture"
                                                AutomationProperties.Name="Clip audio level"
                                                ToolTip="Drag to adjust selected clip audio volume (-∞ dB to +6.0 dB)"/>
                                        <TextBlock Grid.Column="3" Text="+6" Foreground="#7FA8BA" FontSize="9" FontFamily="Consolas"
                                                   VerticalAlignment="Center" Margin="5,0,7,0"/>
                                        <Border Grid.Column="4" Background="#10181F" BorderBrush="#2A4452" BorderThickness="1"
                                                CornerRadius="2" Padding="6,1" MinWidth="78">
                                            <TextBlock x:Name="AudioGainDbText" Text="0.0 dB · 100%"
                                                       Foreground="#7CE2F7" FontFamily="Consolas" FontSize="9.5"
                                                       FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="AudioUnlinkBtn" Style="{StaticResource TinyClipButton}"
                                                Content="Unlink" Visibility="Collapsed"
                                                Click="AudioUnlinkBtn_Click" Foreground="#FBBF24" Margin="0,0,6,0"
                                                ToolTip="Unlink audio track clip from its parent video clip"/>
                                        <Button Style="{StaticResource TinyClipButton}" Content="-6 dB" Tag="-6"
                                                Click="AudioPresetDb_Click" Margin="0,0,3,0" ToolTip="Attenuate -6.0 dB (50%)"/>
                                        <Button Style="{StaticResource TinyClipButton}" Content="0 dB" Tag="0"
                                                Click="AudioPresetDb_Click" Margin="0,0,3,0" Foreground="#7CE2F7"
                                                ToolTip="Reset to unity gain (0.0 dB / 100%)"/>
                                        <Button Style="{StaticResource TinyClipButton}" Content="+3 dB" Tag="3"
                                                Click="AudioPresetDb_Click" Margin="0,0,3,0" ToolTip="Boost +3.0 dB (141%)"/>
                                        <Button Style="{StaticResource TinyClipButton}" Content="+6 dB" Tag="6"
                                                Click="AudioPresetDb_Click" Margin="0,0,6,0" ToolTip="Boost +6.0 dB (200%)"/>
                                        <Button Style="{StaticResource TinyClipButton}" Content="×" Width="20"
                                                Click="AudioStripClose_Click" ToolTip="Collapse audio strip"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Track Headers (V3/V2/V1 Video + A1/A2/A3/A4 Audio) + Scrollable Timeline -->
                            <Grid Grid.Row="2" Background="#141414">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Track Header Column (Synchronized vertical scroll with Timeline) -->
                                <ScrollViewer x:Name="TrackHeaderScrollViewer" Grid.Column="0"
                                              Background="#1D1D1D"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Disabled"
                                              IsHitTestVisible="True"
                                              Focusable="False">
                                    <Grid x:Name="TrackHeadersGrid" Background="#1D1D1D" MinHeight="226">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition x:Name="TrackHeaderV3Row" Height="0"/>
                                            <RowDefinition x:Name="TrackHeaderV2Row" Height="0"/>
                                            <RowDefinition Height="90"/>
                                            <RowDefinition x:Name="TrackHeaderA1Row" Height="60"/>
                                            <RowDefinition x:Name="TrackHeaderA2Row" Height="0"/>
                                            <RowDefinition x:Name="TrackHeaderA3Row" Height="0"/>
                                            <RowDefinition x:Name="TrackHeaderA4Row" Height="48"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#181818" BorderBrush="#2C2C2C" BorderThickness="0,0,1,1">
                                            <TextBlock Text="FPS" x:Name="TrackHeaderFpsText" FontFamily="Consolas" FontSize="8.5"
                                                       Foreground="#7A7A7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="V3TrackHeaderBorder" Grid.Row="1" Visibility="Collapsed" Opacity="0"
                                                Background="#101B27" BorderBrush="#1F364D" BorderThickness="0,0,1,1" Padding="3,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#0369A1" CornerRadius="2" Padding="5,2" Margin="0,0,3,0"
                                                        ToolTip="V3 Top Video Overlay Layer">
                                                    <TextBlock Text="V3" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                                <ToggleButton x:Name="TrackV3MuteButton" Tag="2" Style="{StaticResource TrackBadgeToggle}"
                                                              Content="M" Width="17" Height="17"
                                                              Click="TrackVideoMute_Click"
                                                              ToolTip="Hide / mute V3 video layer"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="V2TrackHeaderBorder" Grid.Row="2" Visibility="Collapsed" Opacity="0"
                                                Background="#141C26" BorderBrush="#243244" BorderThickness="0,0,1,1" Padding="3,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#0284C7" CornerRadius="2" Padding="5,2" Margin="0,0,3,0"
                                                        ToolTip="V2 Overlay Video Layer">
                                                    <TextBlock Text="V2" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                                <ToggleButton x:Name="TrackV2MuteButton" Tag="1" Style="{StaticResource TrackBadgeToggle}"
                                                              Content="M" Width="17" Height="17"
                                                              Click="TrackVideoMute_Click"
                                                              ToolTip="Hide / mute V2 overlay video layer"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="3" BorderBrush="#2F3B4A" BorderThickness="0,0,1,2" Padding="4,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#2D8CFF" CornerRadius="2" Padding="6,2">
                                                    <TextBlock Text="V1" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="4" BorderBrush="#2B2B2B" BorderThickness="0,0,1,1" Padding="3,4">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Border Background="#2D8CFF" CornerRadius="2" Padding="4,2" Margin="0,0,2,0"
                                                            Cursor="Hand" Tag="0" MouseLeftButtonUp="AudioTrackBadge_Click"
                                                            ToolTip="Click A1 to expand audio track &amp; volume line control">
                                                        <TextBlock Text="A1" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>
                                                    <ToggleButton x:Name="TrackMuteButton" Tag="0" Style="{StaticResource TrackBadgeToggle}"
                                                                  Content="M" Width="17" Height="17" Margin="0,0,2,0"
                                                                  Click="TrackAudioMute_Click"
                                                                  ToolTip="Mute / unmute A1 audio track"/>
                                                    <ToggleButton x:Name="AudioStripToggle" Style="{StaticResource TrackBadgeToggle}"
                                                                  Content="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                                  Width="17" Height="17"
                                                                  Click="AudioStripToggle_Click"
                                                                  ToolTip="Expand audio waveform height &amp; open audio strip"/>
                                                </StackPanel>
                                                <TextBlock x:Name="TrackA1ScaleHint" Visibility="Collapsed"
                                                           Text="-∞ · 0dB · +6" FontSize="7.5" FontFamily="Consolas"
                                                           Foreground="#6BA9BD" HorizontalAlignment="Center" Margin="0,5,0,0"
                                                           IsHitTestVisible="False"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="A2TrackHeaderBorder" Grid.Row="5" Visibility="Collapsed" Opacity="0"
                                                Background="#162127" BorderBrush="#223742" BorderThickness="0,0,1,1" Padding="3,2">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#0E7490" CornerRadius="2" Padding="4,2" Margin="0,0,3,0"
                                                        Cursor="Hand" Tag="1" MouseLeftButtonUp="AudioTrackBadge_Click"
                                                        ToolTip="A2 Separated Audio Track for V2 videos">
                                                    <TextBlock Text="A2" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                                <ToggleButton x:Name="TrackA2MuteButton" Tag="1" Style="{StaticResource TrackBadgeToggle}"
                                                              Content="M" Width="17" Height="17"
                                                              Click="TrackAudioMute_Click"
                                                              ToolTip="Mute / unmute A2 track"/>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="A3TrackHeaderBorder" Grid.Row="6" Visibility="Collapsed" Opacity="0"
                                                Background="#131E26" BorderBrush="#1F3444" BorderThickness="0,0,1,1" Padding="3,2">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#0369A1" CornerRadius="2" Padding="4,2" Margin="0,0,3,0"
                                                        Cursor="Hand" Tag="2" MouseLeftButtonUp="AudioTrackBadge_Click"
                                                        ToolTip="A3 Separated Audio Track for V3 videos">
                                                    <TextBlock Text="A3" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                                <ToggleButton x:Name="TrackA3MuteButton" Tag="2" Style="{StaticResource TrackBadgeToggle}"
                                                              Content="M" Width="17" Height="17"
                                                              Click="TrackAudioMute_Click"
                                                              ToolTip="Mute / unmute A3 track"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="7" BorderBrush="#2B2B2B" BorderThickness="0,0,1,1" Padding="3,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Background="#1B7F79" CornerRadius="2" Padding="4,2" Margin="0,0,3,0"
                                                        Cursor="Hand" Tag="3" MouseLeftButtonUp="AudioTrackBadge_Click"
                                                        ToolTip="A4 Music &amp; External Audio Track (drop .mp3/.wav from Project Bin)">
                                                    <TextBlock Text="A4" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                                <ToggleButton x:Name="TrackA4MuteButton" Tag="3" Style="{StaticResource TrackBadgeToggle}"
                                                              Content="M" Width="17" Height="17"
                                                              Click="TrackAudioMute_Click"
                                                              ToolTip="Mute / unmute A4 music &amp; audio track"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="8" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0"/>
                                    </Grid>
                                </ScrollViewer>

                                <!-- Right Scrollable Track Canvas -->
                                <ScrollViewer x:Name="TimelineScrollViewer" Grid.Column="1"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              ScrollChanged="TimelineScrollViewer_ScrollChanged"
                                              PreviewMouseWheel="TimelineScrollViewer_PreviewMouseWheel"
                                              SizeChanged="TimelineScrollViewer_SizeChanged">
                                    <Grid x:Name="TimelineSurface" Height="226" Background="#141414"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          AllowDrop="True"
                                          DragOver="Timeline_DragOver"
                                          DragLeave="Timeline_DragLeave"
                                          Drop="Timeline_Drop"
                                          MouseLeftButtonDown="Timeline_MouseLeftButtonDown"
                                          MouseMove="Timeline_MouseMove"
                                          MouseLeftButtonUp="Timeline_MouseLeftButtonUp"
                                          MouseLeave="Timeline_MouseLeave"
                                          LostMouseCapture="Timeline_LostMouseCapture">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28"/>
                                            <RowDefinition x:Name="TimelineV3Row" Height="0"/>
                                            <RowDefinition x:Name="TimelineV2Row" Height="0"/>
                                            <RowDefinition Height="90"/>
                                            <RowDefinition x:Name="TimelineA1Row" Height="60"/>
                                            <RowDefinition x:Name="TimelineA2Row" Height="0"/>
                                            <RowDefinition x:Name="TimelineA3Row" Height="0"/>
                                            <RowDefinition x:Name="TimelineA4Row" Height="48"/>
                                        </Grid.RowDefinitions>

                                        <!-- Time Ruler -->
                                        <Border Grid.Row="0" Background="#181818" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1"/>
                                        <Canvas x:Name="TimelineRulerCanvas" Grid.Row="0" IsHitTestVisible="False"/>

                                        <!-- Dynamic V3 Top Overlay Video Track -->
                                        <Border x:Name="TimelineV3Bg" Grid.Row="1" Visibility="Collapsed" Opacity="0"
                                                Background="#0D1620" BorderBrush="#1B3247" BorderThickness="0,0,0,1">
                                            <TextBlock x:Name="TimelineV3DropHint" Text="V3 TOP LAYER — DROP VIDEO TO STACK ON TOP"
                                                       Foreground="#4884B0" FontSize="9.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                                        </Border>
                                        <Canvas x:Name="TimelineV3Canvas" Grid.Row="1" ClipToBounds="True"/>

                                        <!-- Dynamic V2 Overlay Video Track -->
                                        <Border x:Name="TimelineV2Bg" Grid.Row="2" Visibility="Collapsed" Opacity="0"
                                                Background="#101720" BorderBrush="#1E2F42" BorderThickness="0,0,0,1">
                                            <TextBlock x:Name="TimelineV2DropHint" Text="V2 OVERLAY LAYER — DROP VIDEO TO STACK"
                                                       Foreground="#3D6B8E" FontSize="9.5" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                                        </Border>
                                        <Canvas x:Name="TimelineV2Canvas" Grid.Row="2" ClipToBounds="True"/>

                                        <!-- V1 Main Video Track -->
                                        <Border Grid.Row="3" Background="#141414" BorderBrush="#2D3948" BorderThickness="0,0,0,2"/>
                                        <Canvas x:Name="TimelineClipsCanvas" Grid.Row="3" ClipToBounds="True"/>

                                        <!-- A1 Audio Track (V1 Audio) -->
                                        <Border Grid.Row="4" Background="#121212" BorderBrush="#252525" BorderThickness="0,0,0,1"/>
                                        <Canvas x:Name="TimelineAudioCanvas" Grid.Row="4" ClipToBounds="True"/>

                                        <!-- Dynamic A2 Audio Track (V2 Audio) -->
                                        <Border x:Name="TimelineA2Bg" Grid.Row="5" Visibility="Collapsed" Opacity="0"
                                                Background="#111A20" BorderBrush="#20323C" BorderThickness="0,0,0,1"/>
                                        <Canvas x:Name="TimelineAudio2Canvas" Grid.Row="5" ClipToBounds="True"/>

                                        <!-- Dynamic A3 Audio Track (V3 Audio) -->
                                        <Border x:Name="TimelineA3Bg" Grid.Row="6" Visibility="Collapsed" Opacity="0"
                                                Background="#0F1820" BorderBrush="#1C303F" BorderThickness="0,0,0,1"/>
                                        <Canvas x:Name="TimelineAudio3Canvas" Grid.Row="6" ClipToBounds="True"/>

                                        <!-- A4 Music & External Audio Overlay Track -->
                                        <Border Grid.Row="7" Background="#101518" BorderBrush="#252525" BorderThickness="0,0,0,1"/>
                                        <Canvas x:Name="TimelineAudio4Canvas" Grid.Row="7" ClipToBounds="True"/>

                                        <TextBlock x:Name="TimelineFramesHint" Grid.Row="3" Text=""
                                                   Foreground="#8C8C8C" FontSize="10" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsHitTestVisible="False" Visibility="Collapsed"/>

                                        <!-- Premiere Blue Playhead + Razor Guide + Animated Drop Target -->
                                        <Canvas x:Name="TimelineOverlayCanvas" Grid.RowSpan="8" IsHitTestVisible="False">
                                            <Border x:Name="MoveSlotPreviewRect" Visibility="Collapsed"
                                                    Height="150" Canvas.Top="31" CornerRadius="3"
                                                    Background="#2238BDF8" BorderBrush="#38BDF8"
                                                    BorderThickness="1.5"/>
                                            <Line x:Name="RazorGuideLine" X1="0" X2="0" Y1="28" Y2="226"
                                                  Stroke="#F87171" StrokeThickness="1.5" StrokeDashArray="3,2"
                                                  Visibility="Collapsed"/>
                                            <Rectangle x:Name="DropInsertionLine" Width="2.5" Height="198"
                                                       Fill="#38BDF8" Canvas.Top="28" Visibility="Collapsed"/>
                                            <Polygon x:Name="PlayheadCap" Points="0,0 13,0 13,9 6.5,15 0,9"
                                                     Fill="#2D8CFF" Stroke="#7CC0FF" StrokeThickness="0.8"
                                                     Width="13" Height="15" Canvas.Left="0" Canvas.Top="13"/>
                                            <Rectangle x:Name="PlayheadLine" Width="1.5" Height="200" Fill="#2D8CFF"
                                                       Canvas.Left="5.75" Canvas.Top="26"/>
                                            <Border x:Name="TimelineDragBadge" Visibility="Collapsed"
                                                    Background="#EA12141A" BorderBrush="#38BDF8" BorderThickness="1"
                                                    CornerRadius="3" Padding="6,2" Canvas.Top="32">
                                                <TextBlock x:Name="TimelineDragBadgeText" Text="00:00:00"
                                                           FontFamily="Consolas" FontSize="10" FontWeight="Bold"
                                                           Foreground="#E6E6E6"/>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Premiere Blue Dock Drop Overlay -->
            <Canvas x:Name="DockDragOverlayCanvas" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="120"/>
        </Grid>

        <!-- Blocking Centered Export Dialog & Rendering Progress Overlay -->
        <Grid x:Name="ExportModalOverlay" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="200"
              Background="#C40A0B10" IsHitTestVisible="True">
            <Border Width="484" Background="#1B1C22" BorderBrush="#333640" BorderThickness="1"
                    CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.78" Color="Black"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Border Grid.Row="0" Background="#17181E" BorderBrush="#292B34" BorderThickness="0,0,0,1"
                            CornerRadius="10,10,0,0" Padding="18,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="6" Background="#1E2C3E" Margin="0,0,10,0">
                                    <Path Data="M12,3 V13 M12,3 L8,7 M12,3 L16,7 M5,14 V17 A2,2 0 0 0 7,19 H17 A2,2 0 0 0 19,17 V14"
                                          Stroke="#4EA1FF" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                                <TextBlock x:Name="ExportModalTitleText" Text="Export Settings"
                                           Foreground="#F3F4F6" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Border Background="#131D29" BorderBrush="#263C57" BorderThickness="1"
                                        CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="EncoderStatusText" Text="GPU Ready"
                                               Foreground="#4EA1FF" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                                <Button x:Name="ExportModalCloseBtn" Width="26" Height="26" Cursor="Hand"
                                        Click="CloseExportModal_Click" ToolTip="Close (Esc)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Foreground="#8A919E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="#2A2D37"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stage Container -->
                    <Grid Grid.Row="1">
                        <!-- STAGE 1: Export Settings Form -->
                        <StackPanel x:Name="ExportOptionsStage">
                            <StackPanel Margin="20,16,20,16">
                                <TextBlock Text="RENDER MODE" Foreground="{StaticResource TextMuted}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,5"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="ModeSmartRender" Grid.Column="0" GroupName="CutMode"
                                                 IsChecked="True" Style="{StaticResource ModeChipRadio}"
                                                 Checked="ExportOption_Changed"
                                                 ToolTip="Frame-accurate cut &amp; montage join across all resolutions &amp; formats (GPU accelerated)">
                                        <TextBlock Text="Smart Render"/>
                                    </RadioButton>
                                    <RadioButton x:Name="ModeFastCopy" Grid.Column="2" GroupName="CutMode"
                                                 Style="{StaticResource ModeChipRadio}"
                                                 Checked="ExportOption_Changed"
                                                 ToolTip="Instant stream copy without re-encoding (keyframe-snapped on single source)">
                                        <TextBlock Text="Fast Copy"/>
                                    </RadioButton>
                                </Grid>

                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="FORMAT" Foreground="{StaticResource TextMuted}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="FormatCombo" Style="{StaticResource StudioComboBox}" Height="30"
                                                  SelectionChanged="ExportOption_Changed"
                                                  AutomationProperties.Name="Output video format">
                                            <ComboBoxItem Content="MP4 (H.264)" Tag="mp4" IsSelected="True"/>
                                            <ComboBoxItem Content="Same as Source" Tag="auto"/>
                                            <ComboBoxItem Content="MOV (QuickTime)" Tag="mov"/>
                                            <ComboBoxItem Content="MKV (Matroska)" Tag="mkv"/>
                                            <ComboBoxItem Content="WEBM (VP9)" Tag="webm"/>
                                            <ComboBoxItem Content="AVI (Legacy)" Tag="avi"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RESOLUTION" Foreground="{StaticResource TextMuted}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="ResolutionCombo" Style="{StaticResource StudioComboBox}" Height="30"
                                                  SelectionChanged="ExportOption_Changed"
                                                  AutomationProperties.Name="Output video resolution">
                                            <ComboBoxItem Content="Original" Tag="Original" IsSelected="True"/>
                                            <ComboBoxItem Content="4K (2160p)" Tag="Uhd4K"/>
                                            <ComboBoxItem Content="1440p (2K)" Tag="Qhd1440"/>
                                            <ComboBoxItem Content="1080p (Full HD)" Tag="Fhd1080"/>
                                            <ComboBoxItem Content="720p (HD)" Tag="Hd720"/>
                                            <ComboBoxItem Content="480p (SD)" Tag="Sd480"/>
                                            <ComboBoxItem Content="9:16 Vertical (1080×1920)" Tag="Vertical1080x1920"/>
                                            <ComboBoxItem Content="1:1 Square (1080×1080)" Tag="Square1080x1080"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SCALING" Foreground="{StaticResource TextMuted}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="AspectFitCombo" Style="{StaticResource StudioComboBox}" Height="30"
                                                  SelectionChanged="ExportOption_Changed"
                                                  AutomationProperties.Name="Aspect ratio scaling mode">
                                            <ComboBoxItem Content="Fit (No Crop)" Tag="FitPad" IsSelected="True"/>
                                            <ComboBoxItem Content="Fill (Crop)" Tag="FillCrop"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="OUTPUT FOLDER" Foreground="{StaticResource TextMuted}" FontSize="9.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#14151A" BorderBrush="#343742" BorderThickness="1"
                                                    CornerRadius="3" Padding="8,0" Height="30">
                                                <TextBlock x:Name="OutputPathText" Text="" Foreground="#D0D4DD"
                                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </Border>
                                            <Button Grid.Column="1" Style="{StaticResource QuietButton}" Content="…"
                                                    Click="ChangeOutput_Click" Width="30" Height="30" MinHeight="30"
                                                    Padding="0" Margin="5,0,0,0" ToolTip="Choose output folder"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#14161C" BorderBrush="#282B35" BorderThickness="1"
                                        CornerRadius="6" Padding="11,8">
                                    <StackPanel>
                                        <TextBlock x:Name="ExportSummaryHint" Text="MP4 · Original · Fit Pad · Frame-accurate"
                                                   Foreground="#C4CAD6" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ExportSequenceInfoText" Text=""
                                                   Foreground="#7E8594" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Background="#16171C" BorderBrush="#292B33" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,10,10" Padding="20,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource QuietButton}" Content="Cancel"
                                            Click="CloseExportModal_Click" MinWidth="88" Height="34" Margin="0,0,10,0"/>
                                    <Button x:Name="StartExportButton" Style="{StaticResource PremierePrimaryButton}"
                                            Click="StartExportButton_Click" MinWidth="136" Height="34" Padding="18,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M2,1 L10,6 L2,11 Z" Fill="White" Width="8" Height="10"
                                                  Stretch="Uniform" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="StartExportButtonLabel" Text="Export Montage"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- STAGE 2: Locked Centered Rendering Progress -->
                        <StackPanel x:Name="ExportProgressStage" Visibility="Collapsed">
                            <StackPanel Margin="24,24,24,22">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,64,0">
                                        <TextBlock x:Name="ProgressStatusText" Text="Rendering montage..."
                                                   Foreground="#F3F4F6" FontSize="15" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ExportTargetFileText" Text=""
                                                   Foreground="#8B92A0" FontSize="11" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="#4EA1FF"
                                               FontFamily="Consolas" FontSize="22" FontWeight="Bold"/>
                                </Grid>

                                <ProgressBar x:Name="ExportProgress" Style="{StaticResource StudioProgressBar}"
                                             Minimum="0" Maximum="100" Value="0" Margin="0,2,0,14"/>

                                <Border Background="#14161B" BorderBrush="#262932" BorderThickness="1"
                                        CornerRadius="6" Padding="11,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Foreground="#7E8696" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Timeline and controls are locked while rendering to keep your export safe."
                                                   Foreground="#9097A5" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Background="#16171C" BorderBrush="#292B33" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,10,10" Padding="20,12">
                                <Button x:Name="CancelButton" Style="{StaticResource DangerButton}"
                                        Content="Cancel Export" Click="CancelExport_Click"
                                        MinWidth="116" Height="33" HorizontalAlignment="Right"/>
                            </Border>
                        </StackPanel>

                        <!-- STAGE 3: Centered Export Result -->
                        <StackPanel x:Name="ExportResultStage" Visibility="Collapsed">
                            <StackPanel Margin="24,20,24,20">
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="40" Height="40" CornerRadius="20" Background="#183326"
                                            BorderBrush="#2C6B4E" BorderThickness="1" Margin="0,0,14,0">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                   Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="ResultTitle" Text="Montage exported" Foreground="#F3F4F6"
                                                   FontWeight="SemiBold" FontSize="16"/>
                                        <TextBlock x:Name="ResultDetailText" Text="" Foreground="#9FA7B5"
                                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Background="#16171C" BorderBrush="#292B33" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,10,10" Padding="20,12">
                                <Grid>
                                    <Button Style="{StaticResource QuietButton}" Content="New project"
                                            Click="CutAnother_Click" Height="33" Padding="12,0" HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource QuietButton}" Content="Close"
                                                Click="CloseExportModal_Click" MinWidth="76" Height="33" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource CutterButton}" Content="Open folder"
                                                Click="OpenOutputFolder_Click" Height="33" Padding="12,0" Margin="0,0,8,0"/>
                                        <Button x:Name="WatchOutputButton" Style="{StaticResource PremierePrimaryButton}"
                                                Content="Watch" Click="PlayOutput_Click" MinWidth="82" Height="33" Padding="14,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
