<UserControl x:Class="CortexFX.Views.Video.VideoCutterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
             mc:Ignorable="d" d:DesignHeight="720" d:DesignWidth="960"
             FontFamily="Segoe UI" Focusable="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <UserControl.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2F7FA"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CB1BF"/>
        <SolidColorBrush x:Key="InfoColor" Color="#58C9EF"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#42D6A4"/>
        <SolidColorBrush x:Key="DangerColor" Color="#F47788"/>
        <Style x:Key="CutterFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="-3" CornerRadius="10" BorderBrush="#7DD3FC"
                                BorderThickness="2" IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CutterButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource CutterFocusVisual}"/>
            <Setter Property="Background" Value="#172631"/>
            <Setter Property="Foreground" Value="#E8F2F7"/>
            <Setter Property="BorderBrush" Value="#365164"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#244052"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#61B8D5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource CutterButton}">
            <Setter Property="Background" Value="#121B25"/>
            <Setter Property="BorderBrush" Value="#2C4050"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource CutterButton}">
            <Setter Property="Background" Value="#2A1C25"/>
            <Setter Property="BorderBrush" Value="#67404C"/>
            <Setter Property="Foreground" Value="#F5AAB5"/>
        </Style>
        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#0A1017">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101B24" BorderBrush="#29404F"
                BorderThickness="0,0,0,1" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="VIDEO CUTTER" Foreground="{StaticResource InfoColor}"
                               FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#123342" BorderBrush="#347D96" BorderThickness="1"
                            CornerRadius="6" Padding="6,2" Margin="8,0,0,0">
                        <TextBlock Text="PRECISION EDIT" FontSize="9" FontWeight="Bold"
                                   Foreground="#A1E6F9"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="FileNameText" Grid.Column="1" Text="Open a video to begin"
                           Foreground="{StaticResource TextPrimary}" FontSize="12"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Margin="16,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviewFocusButton" Click="PreviewFocusButton_Click"
                            Style="{StaticResource QuietButton}" Visibility="Collapsed"
                            Height="28" Margin="0,0,8,0" Padding="8,3"
                            ToolTip="Expand the video preview">
                        <TextBlock x:Name="PreviewFocusButtonLabel" Text="Focus preview"/>
                    </Button>
                    <Border x:Name="BackgroundJobBadge" Visibility="Collapsed"
                            Background="#17332C" BorderBrush="#3E9D78" BorderThickness="1"
                            CornerRadius="8" Padding="8,5" VerticalAlignment="Center">
                        <TextBlock Text="Export running in background" FontSize="11"
                                   Foreground="#88E3BA" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DropZoneBorder" Grid.Row="1" Margin="18"
                Background="#101C25" BorderBrush="#385E70" BorderThickness="1"
                CornerRadius="14" AllowDrop="True" Drop="DropZone_Drop"
                DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                MouseLeftButtonUp="DropZone_Click" Cursor="Hand">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                           Foreground="{StaticResource InfoColor}" HorizontalAlignment="Center"/>
                <TextBlock Text="Open or drop a video" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                           Margin="0,12,0,0"/>
                <TextBlock Text="MP4, MOV, MKV, WEBM, AVI and more"
                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <Grid x:Name="EditorPanel" Grid.Row="1" Visibility="Collapsed" Margin="12,8,12,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.15*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Preview, transport and trim controls share one stable workspace. -->
                <Grid x:Name="EditorLeftPanel" Grid.Column="0" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#03080C" BorderBrush="#315265"
                            BorderThickness="1" CornerRadius="11" ClipToBounds="True">
                        <Grid>
                            <ffme:MediaElement x:Name="PreviewMedia" Background="#03080C"
                                              LoadedBehavior="Manual" UnloadedBehavior="Close"
                                              MediaOpened="PreviewMedia_MediaOpened"
                                              MediaFailed="PreviewMedia_MediaFailed"/>
                            <TextBlock x:Name="PreviewPlaceholder" Text="Opening preview..."
                                       Foreground="{StaticResource TextSecondary}" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#101B24" BorderBrush="#2D4555"
                            BorderThickness="1" CornerRadius="9" Padding="7,4" Margin="0,6,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CutterButton}" Click="PlayPause_Click"
                                        Height="32" Margin="0,0,7,0" ToolTip="Play or pause (Space / K)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="PlayPauseIcon" Text="&#xE768;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource InfoColor}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PlayPauseLabel" Text="Play" Margin="7,0,0,0"
                                                   Foreground="{StaticResource TextPrimary}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource QuietButton}" Content="−1s"
                                        Click="NudgeBack_Click" Height="32" Margin="0,0,5,0" ToolTip="Back 1 second (J)"/>
                                <Button Style="{StaticResource QuietButton}" Content="+1s"
                                        Click="NudgeForward_Click" Height="32" Margin="0,0,5,0" ToolTip="Forward 1 second (L)"/>
                                <Button Style="{StaticResource QuietButton}" Content="−0.1"
                                        Click="NudgeFineBack_Click" Height="32" Margin="0,0,5,0" ToolTip="Back 0.1 second (Shift+J)"/>
                                <Button Style="{StaticResource QuietButton}" Content="+0.1"
                                        Click="NudgeFineForward_Click" Height="32" ToolTip="Forward 0.1 second (Shift+L)"/>
                            </StackPanel>
                            <TextBlock x:Name="PositionText" Grid.Column="1" Text="00:00.0 / 00:00.0"
                                       Foreground="#D4E6EF" FontFamily="Consolas" FontSize="12"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border x:Name="CutterTimelinePanel" Grid.Row="2" Background="#111C26" BorderBrush="#2D4555"
                            BorderThickness="1" CornerRadius="11" Padding="10,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="TIMELINE" Foreground="#EAF3F7" FontSize="11"
                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="IN " Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                    <TextBlock x:Name="InPointText" Text="00:00.0" Foreground="{StaticResource SuccessColor}"
                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                                    <TextBlock Text="OUT " Foreground="{StaticResource TextSecondary}" FontSize="10"/>
                                    <TextBlock x:Name="OutPointText" Text="00:00.0" Foreground="{StaticResource DangerColor}"
                                               FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                            <Grid x:Name="TimelineHitArea" Grid.Row="1" Height="54" Cursor="Hand"
                                  MouseLeftButtonDown="Timeline_MouseLeftButtonDown"
                                  MouseMove="Timeline_MouseMove"
                                  MouseLeftButtonUp="Timeline_MouseLeftButtonUp"
                                  MouseLeave="Timeline_MouseLeave"
                                  SizeChanged="Timeline_SizeChanged"
                                  ToolTip="Click to seek. Drag the green or red edge to adjust In or Out.">
                                <Border CornerRadius="6" Background="#08141B" BorderBrush="#37566A" BorderThickness="1"/>
                                <UniformGrid x:Name="TimelineFrames" Columns="12" Margin="2"
                                             ClipToBounds="True" IsHitTestVisible="False"/>
                                <Border x:Name="SelectionBand" CornerRadius="3" Background="Transparent"
                                        BorderThickness="1,2,1,2" IsHitTestVisible="False"
                                        HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="0,2">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#42D6A4" Offset="0"/>
                                            <GradientStop Color="#77C7E8" Offset="0.5"/>
                                            <GradientStop Color="#F47788" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>
                                <TextBlock x:Name="TimelineFramesHint" Text="Preparing video frames..."
                                           Foreground="#C8DCE6" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <Border x:Name="Playhead" Width="2" Background="#FF9A6F"
                                        HorizontalAlignment="Left" Margin="0,2"/>
                                <Border x:Name="InMarker" Width="4" Background="{StaticResource SuccessColor}"
                                        HorizontalAlignment="Left" Margin="0,1"/>
                                <Border x:Name="OutMarker" Width="4" Background="{StaticResource DangerColor}"
                                        HorizontalAlignment="Left" Margin="0,1"/>
                            </Grid>
                            <WrapPanel Grid.Row="2" Margin="0,7,0,0">
                                <Button Style="{StaticResource CutterButton}" Content="Set In" Click="SetIn_Click"
                                        Foreground="{StaticResource SuccessColor}" Margin="0,0,6,0" ToolTip="Mark start (I)"/>
                                <Button Style="{StaticResource CutterButton}" Content="Set Out" Click="SetOut_Click"
                                        Foreground="{StaticResource DangerColor}" Margin="0,0,6,0" ToolTip="Mark end (O)"/>
                                <Button Style="{StaticResource CutterButton}" Content="+ Keep segment"
                                        Click="AddSegment_Click" Margin="0,0,6,0" ToolTip="Add the marked range to the export"/>
                                <Button Style="{StaticResource QuietButton}" Content="Play In → Out"
                                        Click="PlaySelection_Click" ToolTip="Preview marked range"/>
                            </WrapPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- The segment queue scrolls independently; output controls remain available. -->
                <Grid x:Name="CutterSidePanel" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#111C26" BorderBrush="#2D4555"
                            BorderThickness="1" CornerRadius="11" Padding="12,10" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="KEEP SEGMENTS" Foreground="#EAF3F7" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="SegmentsSummaryText" Text="0 segments · 00:00.0 total"
                                           HorizontalAlignment="Right" Foreground="{StaticResource InfoColor}"
                                           FontSize="10"/>
                            </Grid>
                            <TextBlock x:Name="EmptySegmentsHint" Grid.Row="1"
                                       Text="No segments added. Export uses the current In–Out range."
                                       Foreground="{StaticResource TextSecondary}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" Margin="0,9,0,0">
                                <ItemsControl x:Name="SegmentsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0B151C" BorderBrush="#294657"
                                                    BorderThickness="1" CornerRadius="8"
                                                    Padding="9,7" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayTitle}" Foreground="#EAF3F7"
                                                                   FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding DisplayRange}" Foreground="#9CB1BF"
                                                                   FontSize="10" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource SegmentButton}" Content="↑"
                                                                AutomationProperties.Name="Move segment up"
                                                                Click="SegmentMoveUp_Click" Tag="{Binding}" ToolTip="Move segment up"/>
                                                        <Button Style="{StaticResource SegmentButton}" Content="↓"
                                                                AutomationProperties.Name="Move segment down"
                                                                Click="SegmentMoveDown_Click" Tag="{Binding}" ToolTip="Move segment down"/>
                                                        <Button Style="{StaticResource SegmentButton}" Content="×"
                                                                AutomationProperties.Name="Remove segment"
                                                                Click="SegmentRemove_Click" Tag="{Binding}" ToolTip="Remove segment"
                                                                Margin="0" Foreground="{StaticResource DangerColor}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#111C26" BorderBrush="#2D4555"
                            BorderThickness="1" CornerRadius="11" Padding="12,9" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock Text="OUTPUT FOLDER" Foreground="{StaticResource TextSecondary}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="OutputPathText" Text="" Foreground="#EAF3F7"
                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,7"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource QuietButton}" Content="Change folder"
                                        Click="ChangeOutput_Click" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource DangerButton}" Content="Clear video"
                                        Click="ClearFile_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ProgressPanel" Grid.Row="2" Visibility="Collapsed"
                            Background="#12232D" BorderBrush="#32778B" BorderThickness="1"
                            CornerRadius="10" Padding="11,8" Margin="0,9,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <TextBlock x:Name="ProgressStatusText" Text="Exporting..."
                                           Foreground="#EAF3F7" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right"
                                           Foreground="{StaticResource InfoColor}" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                            <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Value="0"
                                         Height="6" Foreground="{StaticResource InfoColor}"/>
                            <Button x:Name="CancelButton" Style="{StaticResource DangerButton}"
                                    Content="Cancel export" Click="CancelExport_Click"
                                    HorizontalAlignment="Left" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ResultCard" Grid.Row="3" Visibility="Collapsed"
                            Background="#132A27" BorderBrush="#438E72" BorderThickness="1"
                            CornerRadius="10" Padding="11,8" Margin="0,9,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ResultTitle" Text="Cut exported" Foreground="#A2E7C9"
                                       FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="ResultDetailText" Text="" Foreground="#C7DAD3"
                                       FontSize="10" TextWrapping="Wrap" Margin="0,4,0,7"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource CutterButton}" Content="Open folder"
                                        Click="OpenOutputFolder_Click" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource QuietButton}" Content="Cut another"
                                        Click="CutAnother_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border x:Name="CutterExportDock" Grid.Row="1" Background="#111F29" BorderBrush="#2D4555"
                    BorderThickness="1" CornerRadius="10" Padding="10,6" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="READY TO EXPORT" Foreground="#A9CEDD"
                                   FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Current In–Out range or queued segments · MP4"
                                   Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button x:Name="ExportButton" Grid.Column="1" Click="ExportButton_Click"
                            Style="{StaticResource CutterButton}" Content="Export Cut"
                            Width="178" Height="38" Background="#16728B" BorderBrush="#4AB8D5"
                            Foreground="White" FontSize="14" FontWeight="Bold"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
