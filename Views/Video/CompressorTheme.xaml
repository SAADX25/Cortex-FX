<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F3F5FA"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#AAB2C2"/>
    <SolidColorBrush x:Key="TextDim" Color="#929CAD"/>
    <SolidColorBrush x:Key="AccentColor" Color="#EB3652"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#FF91A3"/>
    <SolidColorBrush x:Key="SuccessColor" Color="#8DE0BA"/>
    <SolidColorBrush x:Key="WarningColor" Color="#EBC58A"/>
    <SolidColorBrush x:Key="InfoColor" Color="#9BC4FF"/>
    <SolidColorBrush x:Key="DangerColor" Color="#FF8496"/>
    <Geometry x:Key="SocialIcon">M3,3 H21 V16 H10 L5,21 V16 H3 Z M7,7 H17 M7,11 H14</Geometry>
    <Geometry x:Key="MailIcon">M2,4 H22 V20 H2 Z M2,5 L12,13 L22,5</Geometry>
    <Geometry x:Key="BalanceIcon">M4,4 V20 M12,4 V20 M20,4 V20 M1,9 H7 M9,15 H15 M17,8 H23</Geometry>
    <Geometry x:Key="QualityIcon">M12,2 L15,8 L22,9 L17,14 L18,21 L12,18 L6,21 L7,14 L2,9 L9,8 Z</Geometry>
    <Geometry x:Key="CustomIcon">M3,6 H21 M3,18 H21 M7,2 V10 M17,14 V22</Geometry>
    <Geometry x:Key="FolderIcon">M2,5 H10 L13,8 H23 V21 H2 Z M2,10 H23</Geometry>
    <Geometry x:Key="VideoIcon">M2,4 H17 V20 H2 Z M17,9 L23,5 V19 L17,15 M7,8 L13,12 L7,16 Z</Geometry>
    <Style x:Key="CompressorFocusVisual" TargetType="Control">
        <Setter Property="Template"><Setter.Value><ControlTemplate>
            <Border CornerRadius="10" BorderBrush="#FFC0CC" BorderThickness="2" Margin="-3" IsHitTestVisible="False"/>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CompressorCard" TargetType="Border">
        <Setter Property="Background" Value="#171A22"/>
        <Setter Property="BorderBrush" Value="#303540"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="CompressorButton" TargetType="Button">
        <Setter Property="Background" Value="#252A35"/>
        <Setter Property="BorderBrush" Value="#414958"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#F3F5FA"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{x:Null}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CompressorFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid>
                <Border x:Name="Surface" CornerRadius="9" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <Border x:Name="Highlight" CornerRadius="9" Background="White" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Highlight" Property="Opacity" Value="0.06"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#FF9BAE"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.7"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CompressorPrimaryButton" TargetType="Button" BasedOn="{StaticResource CompressorButton}">
        <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#DE2445" Offset="0"/><GradientStop Color="#F34458" Offset="1"/>
        </LinearGradientBrush></Setter.Value></Setter>
        <Setter Property="BorderBrush" Value="#FF6D83"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="GhostIconButton" TargetType="Button" BasedOn="{StaticResource CompressorButton}">
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="MinHeight" Value="34"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#353B47"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="PresetRadioStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="#B4C4DF"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CompressorFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="PresetBorder" CornerRadius="12" MinHeight="112" Padding="13" Background="#191C25" BorderBrush="#333947" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border x:Name="IconBadge" Width="28" Height="28" Background="#252B37" CornerRadius="8" HorizontalAlignment="Left">
                        <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round"
                              Width="15" Height="15" Stretch="Uniform"/>
                    </Border>
                    <Border x:Name="SelectedBadge" Width="17" Height="17" CornerRadius="9" Background="#F34764" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                        <Path Data="M2,5 L5,8 L10,2" Stroke="White" StrokeThickness="1.5" Width="9" Height="8" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{TemplateBinding Tag}" FontSize="12" FontWeight="SemiBold" Foreground="#F3F5FA" Margin="0,9,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PresetHint" Grid.Row="2" Text="{TemplateBinding ToolTip}" FontSize="11" Foreground="#A4AEC1" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="PresetBorder" Property="BorderBrush" Value="#F0506D"/>
                    <Setter TargetName="PresetBorder" Property="Background" Value="#30202D"/>
                    <Setter TargetName="SelectedBadge" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="IconBadge" Property="Background" Value="#4A293A"/>
                    <Setter TargetName="PresetHint" Property="Foreground" Value="#E1B9C7"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PresetBorder" Property="BorderBrush" Value="#A47791"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PresetBorder" Property="BorderBrush" Value="#FFD0DB"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PresetBorder" Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OptionChipStyle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,7,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CompressorFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Chip" CornerRadius="8" Padding="12,8" Background="#10131B" BorderBrush="#353D4D" BorderThickness="1">
                <ContentPresenter TextElement.Foreground="#B6C0D0" TextElement.FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#372331"/><Setter TargetName="Chip" Property="BorderBrush" Value="#F36B86"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#AC8B9B"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#FFD0DB"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QualitySlider" TargetType="Slider">
        <Setter Property="Height" Value="30"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CompressorFocusVisual}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center" Margin="0,4">
                <Border Height="5" CornerRadius="3" VerticalAlignment="Center">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#68C5B0" Offset="0"/><GradientStop Color="#CE9FBD" Offset="0.5"/><GradientStop Color="#EE5470" Offset="1"/></LinearGradientBrush></Border.Background>
                </Border>
                <Track x:Name="PART_Track" VerticalAlignment="Center">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb Width="19" Height="19" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#F5F6FA" Stroke="#F75575" StrokeThickness="4"/>
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
