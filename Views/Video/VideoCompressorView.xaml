<UserControl x:Class="CortexFX.Views.Video.VideoCompressorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000"
             FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display" Background="#0E1016">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="CompressorTheme.xaml"/>
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border BorderBrush="#282D38" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid MaxWidth="1160">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Style="{StaticResource GhostIconButton}" Click="BackButton_Click" Margin="0,0,13,0"
                        AutomationProperties.Name="Back to tools" ToolTip="Back to tools · your compression session is kept">
                    <Path Data="M16,3 L7,12 L16,21 M7,12 H25" Stroke="#C0C7D5" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform"/>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Video compressor" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="A lighter video. The detail that matters." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BackgroundJobBadge" Visibility="Collapsed" CornerRadius="6" Background="#1D332C" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#8DE0BA" Margin="0,0,7,0"/><TextBlock Text="Processing" FontSize="11" Foreground="#8DE0BA"/></StackPanel>
                    </Border>
                    <Border Background="#1A1F29" BorderBrush="#343D4A" BorderThickness="1" CornerRadius="7" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M8,1 L14,4 V9 C14,13 11,15 8,17 C5,15 2,13 2,9 V4 Z M5,8 L7,10 L11,6" Stroke="#95C4B3" StrokeThickness="1.3" Width="12" Height="14" Stretch="Uniform" Margin="0,0,7,0"/>
                            <TextBlock Text="ON DEVICE" FontSize="10" FontWeight="SemiBold" Foreground="#B4C6C2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="WorkspaceScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel MaxWidth="1160" Margin="20,18,20,20">
                <!-- Empty state: the entire drop target also works with Enter and Space. -->
                <Border x:Name="DropZoneBorder" Height="266" CornerRadius="16" Background="#171720" BorderBrush="#4A3038" BorderThickness="1.5"
                        AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                        MouseLeftButtonUp="DropZone_Click" KeyDown="DropZone_KeyDown" Focusable="True" Cursor="Hand"
                        FocusVisualStyle="{StaticResource CompressorFocusVisual}" AutomationProperties.Name="Select or drop a video to compress">
                    <Grid>
                        <Rectangle Stroke="#554250" StrokeDashArray="5,5" RadiusX="12" RadiusY="12" Margin="9" IsHitTestVisible="False"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="64" Height="54" Background="#342232" BorderBrush="#754158" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <Path Data="{StaticResource VideoIcon}" Width="28" Height="25" Stretch="Uniform" Stroke="#FF98AF" StrokeThickness="1.4" StrokeLineJoin="Round"/>
                            </Border>
                            <TextBlock Text="Make room for more." Foreground="{StaticResource TextPrimary}" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop your video here, or choose a file to get started." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,7,0,16" HorizontalAlignment="Center"/>
                            <Button Content="Choose video" Click="ChooseVideo_Click" Style="{StaticResource CompressorPrimaryButton}" HorizontalAlignment="Center" MinWidth="140" AutomationProperties.Name="Choose a video file"/>
                            <TextBlock Text="MP4 · MOV · MKV · WEBM · AVI and more" FontSize="11" Foreground="#99A4B9" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <UniformGrid Columns="3" Margin="0,22,0,0" Visibility="{Binding Visibility, ElementName=DropZoneBorder}">
                    <StackPanel Margin="8,0"><TextBlock Text="01   Pick your purpose" Foreground="#DFE4EF" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Choose a preset for sharing or storage." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Margin="8,0"><TextBlock Text="02   Make it yours" Foreground="#DFE4EF" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Adjust detail, resolution and codec." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Margin="8,0"><TextBlock Text="03   Save a new copy" Foreground="#DFE4EF" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Your original video stays untouched." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
                </UniformGrid>

                <Border x:Name="FileInfoCard" Visibility="Collapsed" Style="{StaticResource CompressorCard}" Padding="12" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Height="66" Background="#0C0E14" CornerRadius="9" BorderBrush="#363D4B" BorderThickness="1">
                            <Grid>
                                <Path Data="{StaticResource VideoIcon}" Stroke="#8290AA" StrokeThickness="1.4" Width="25" Height="22" Stretch="Uniform"/>
                                <Image x:Name="VideoThumbnail" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,110,64" RadiusX="8" RadiusY="8"/></Image.Clip></Image>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="SOURCE VIDEO" FontSize="10" FontWeight="SemiBold" Foreground="#919DB2"/>
                            <TextBlock x:Name="FileNameText" Text="video.mp4" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock x:Name="FileSizeText" Text="—" Foreground="#D4B0C2" FontSize="12"/>
                                <TextBlock Text="  ·  " Foreground="#626D82"/>
                                <TextBlock x:Name="FileResolutionText" Text="—" Foreground="#A0C1E9" FontSize="12"/>
                                <TextBlock Text="  ·  " Foreground="#626D82"/>
                                <TextBlock x:Name="FileDurationText" Text="—" Foreground="#A9C9C1" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="RemoveVideoButton" Grid.Column="2" Click="RemoveFile_Click" Style="{StaticResource GhostIconButton}" VerticalAlignment="Center"
                                AutomationProperties.Name="Remove video" ToolTip="Remove this video">
                            <Path Data="M3,3 L13,13 M3,13 L13,3" Stroke="#B5BED0" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Results appear above the settings, and scroll into view on completion. -->
                <Border x:Name="ResultCard" Visibility="Collapsed" Style="{StaticResource CompressorCard}" Background="#15241F" BorderBrush="#416F5A" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ResultTitle" Text="Compression complete" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource SuccessColor}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <TextBlock x:Name="ResultBeforeSize" Text="—" Foreground="#B4C0BD" FontSize="14"/>
                                <TextBlock Text="  →  " Foreground="#7E9D8D" FontSize="14"/>
                                <TextBlock x:Name="ResultAfterSize" Text="—" Foreground="#F2FFF8" FontWeight="SemiBold" FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Open folder" Style="{StaticResource CompressorButton}" Click="OpenOutputFolder_Click" VerticalAlignment="Center" AutomationProperties.Name="Open compressed video folder"/>
                        <TextBlock x:Name="ResultSavingsText" Grid.Row="1" Text="Saved space" Foreground="{Binding Foreground, ElementName=ResultTitle}" FontSize="12" TextWrapping="Wrap" Margin="0,12,14,0"/>
                        <Button Grid.Row="1" Grid.Column="1" Content="Another video" Style="{StaticResource CompressorButton}" Background="Transparent" Click="CompressAnother_Click" Margin="0,10,0,0" AutomationProperties.Name="Compress another video"/>
                    </Grid>
                </Border>

                <StackPanel x:Name="PresetsPanel" Visibility="Collapsed" Margin="0,0,0,18">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Compression preset" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="PresetHintText" Grid.Column="1" Text="Choose a starting point." FontSize="12" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right" Margin="16,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <UniformGrid Columns="5">
                        <RadioButton x:Name="PresetSocial" GroupName="Preset" IsChecked="True" Tag="Social Media" Content="{StaticResource SocialIcon}" Foreground="#E7A8C5" ToolTip="720p · Everyday sharing" Style="{StaticResource PresetRadioStyle}" Checked="Preset_Checked" AutomationProperties.Name="Social media preset"/>
                        <RadioButton x:Name="PresetEmail" GroupName="Preset" Tag="Email Ready" Content="{StaticResource MailIcon}" Foreground="#9FC9F4" ToolTip="480p · Compact files" Style="{StaticResource PresetRadioStyle}" Checked="Preset_Checked" AutomationProperties.Name="Email ready preset"/>
                        <RadioButton x:Name="PresetBalanced" GroupName="Preset" Tag="Balanced" Content="{StaticResource BalanceIcon}" Foreground="#9BD8C2" ToolTip="1080p · A balanced mix" Style="{StaticResource PresetRadioStyle}" Checked="Preset_Checked" AutomationProperties.Name="Balanced preset"/>
                        <RadioButton x:Name="PresetHighQ" GroupName="Preset" Tag="High Quality" Content="{StaticResource QualityIcon}" Foreground="#E5C48F" ToolTip="Original · More detail" Style="{StaticResource PresetRadioStyle}" Checked="Preset_Checked" AutomationProperties.Name="High quality preset"/>
                        <RadioButton x:Name="PresetCustom" GroupName="Preset" Tag="Custom" Content="{StaticResource CustomIcon}" Foreground="#B9AEF0" ToolTip="Your own settings" Style="{StaticResource PresetRadioStyle}" Margin="0" Checked="Preset_Checked" AutomationProperties.Name="Custom preset"/>
                    </UniformGrid>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="QualityPanel" Visibility="Collapsed" Style="{StaticResource CompressorCard}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Quality &amp; format" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                <Border CornerRadius="6" Background="#302330" BorderBrush="#614154" BorderThickness="1" Padding="8,3" HorizontalAlignment="Right" Margin="0,-3,0,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="CRF " FontSize="10" Foreground="#CFB6C8" VerticalAlignment="Center"/><TextBlock x:Name="CrfValueText" Text="28" FontSize="12" FontWeight="SemiBold" Foreground="#FFACC0"/></StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="QualityLabelText" Text="Smaller file · made for sharing" Foreground="#E9B69E" FontSize="12" Margin="0,9,0,6" TextWrapping="Wrap"/>
                            <Slider x:Name="CrfSlider" Style="{StaticResource QualitySlider}" Minimum="18" Maximum="40" Value="28" IsSnapToTickEnabled="True" TickFrequency="1"
                                    ValueChanged="CrfSlider_ValueChanged" AutomationProperties.Name="Compression quality CRF" ToolTip="Lower CRF keeps more detail. Higher CRF makes a smaller file. Adjusting selects Custom."/>
                            <Grid Margin="0,2,0,16"><TextBlock Text="More detail" FontSize="11" Foreground="#A1CCC2"/><TextBlock Text="Smaller file" FontSize="11" Foreground="#E4A9B8" HorizontalAlignment="Right"/></Grid>
                            <TextBlock Text="Output resolution" FontSize="12" Foreground="#C1C9D7" Margin="0,0,0,9"/>
                            <WrapPanel>
                                <RadioButton x:Name="ResOriginal" Content="Original" GroupName="Resolution" Style="{StaticResource OptionChipStyle}" Checked="OutputChoices_Changed"/>
                                <RadioButton x:Name="Res1080" Content="1080p" GroupName="Resolution" Style="{StaticResource OptionChipStyle}" Checked="OutputChoices_Changed"/>
                                <RadioButton x:Name="Res720" Content="720p" GroupName="Resolution" IsChecked="True" Style="{StaticResource OptionChipStyle}" Checked="OutputChoices_Changed"/>
                                <RadioButton x:Name="Res480" Content="480p" GroupName="Resolution" Style="{StaticResource OptionChipStyle}" Checked="OutputChoices_Changed"/>
                            </WrapPanel>
                            <TextBlock Text="Video codec" FontSize="12" Foreground="#C1C9D7" Margin="0,16,0,9"/>
                            <WrapPanel>
                                <RadioButton x:Name="CodecH264" Content="H.264 · Compatible" GroupName="Codec" IsChecked="True" Style="{StaticResource OptionChipStyle}" Checked="OutputChoices_Changed" ToolTip="Recommended for broad playback support."/>
                                <RadioButton x:Name="CodecH265" Content="H.265 · Efficient" GroupName="Codec" Style="{StaticResource OptionChipStyle}" Checked="OutputChoices_Changed" ToolTip="Can produce smaller files; CPU encoding may take longer."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="OutputPanel" Grid.Column="2" Visibility="Collapsed" Style="{StaticResource CompressorCard}" VerticalAlignment="Stretch">
                        <StackPanel>
                            <Grid><TextBlock Text="Save destination" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/><Border Background="#28303D" Padding="7,2" CornerRadius="5" HorizontalAlignment="Right"><TextBlock Text="MP4" FontSize="10" Foreground="#C4CFE0"/></Border></Grid>
                            <Border Background="#11151D" BorderBrush="#333C4B" BorderThickness="1" CornerRadius="9" Padding="11" Margin="0,14,0,10">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource FolderIcon}" Stroke="#A1BEE2" StrokeThickness="1.5" Width="17" Height="15" Stretch="Uniform" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="OutputPathText" Grid.Column="1" Text="Same folder as your video" Foreground="#CCD5E5" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                </Grid>
                            </Border>
                            <Button Content="Change folder" Click="ChangeOutput_Click" Style="{StaticResource CompressorButton}" HorizontalAlignment="Left" AutomationProperties.Name="Change output folder"/>
                            <Border BorderBrush="#303744" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,13,0,0">
                                <StackPanel>
                                    <TextBlock Text="ENCODING" Foreground="#8F9CB2" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="EncoderCapabilityText" Text="Checking encoder support…" Foreground="#AFC4E2" FontSize="12" LineHeight="18" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="A new copy is saved. Your original stays intact." FontSize="11" Foreground="#939FB1" LineHeight="17" TextWrapping="Wrap" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Fixed action area: compression and cancellation stay reachable while the workspace scrolls. -->
        <Border x:Name="ActionBar" Grid.Row="2" Background="#151923" BorderBrush="#333A49" BorderThickness="0,1,0,0" Padding="20,14"
                Visibility="{Binding Visibility, ElementName=CompressButton}">
            <StackPanel MaxWidth="1160">
                <Border x:Name="ProgressPanel" Visibility="Collapsed" BorderBrush="#374253" BorderThickness="0,0,0,1" Padding="0,0,0,13" Margin="0,0,0,13" AutomationProperties.LiveSetting="Polite">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ProgressStatusText" Text="Compressing…" Foreground="#E8EBF4" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ProgressPercentText" Grid.Column="1" Text="0%" Foreground="#FF9FB5" FontSize="12" FontWeight="SemiBold" Margin="10,0,0,0"/></Grid>
                            <ProgressBar x:Name="CompressionProgress" Height="5" Foreground="#EF5273" Background="#2F3748" BorderThickness="0" Margin="0,8,0,0"/>
                            <TextBlock x:Name="ProgressDetailText" Foreground="#9BA8BE" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="CancelCompress_Click" Style="{StaticResource CompressorButton}" VerticalAlignment="Center" AutomationProperties.Name="Cancel compression"/>
                    </Grid>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock x:Name="OutputSummaryText" Text="MP4 · H.264 · 720p" Foreground="#EDF0F7" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="OutputSummaryHint" Text="Social Media · CRF 28" Foreground="#A5B0C5" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Button x:Name="CompressButton" Grid.Column="1" Visibility="Collapsed" Click="CompressButton_Click" Style="{StaticResource CompressorPrimaryButton}" Height="44" MinWidth="196" AutomationProperties.Name="Compress video">
                        <StackPanel Orientation="Horizontal"><Path Data="M2,1 L12,7 L2,13 Z" Fill="White" Width="10" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Compress video" FontSize="14"/></StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
