<UserControl x:Class="CortexFX.Views.VideoCompressorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="850"
             Background="#07080B">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Accent brushes -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B1119" Offset="0"/>
            <GradientStop Color="#E11D2E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4D5E" Offset="0"/>
            <GradientStop Color="#B91C1C" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentColor" Color="#E11D2E"/>
        <SolidColorBrush x:Key="AccentSecondary" Color="#FF6B4A"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#2ED47A"/>
        <SolidColorBrush x:Key="DangerColor" Color="#FF4D5E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F7FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B6BAC4"/>
        <SolidColorBrush x:Key="TextDim" Color="#828691"/>
        <SolidColorBrush x:Key="InputBg" Color="#07080B"/>
        <SolidColorBrush x:Key="CardBg" Color="#13141A"/>
        <SolidColorBrush x:Key="CardHover" Color="#1A1519"/>
        <SolidColorBrush x:Key="SubtleBorder" Color="#2B2026"/>
        <SolidColorBrush x:Key="StrongBorder" Color="#473039"/>

        <!-- Preset Radio Button Style -->
        <Style x:Key="PresetRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PresetBorder" CornerRadius="8" Background="{StaticResource InputBg}"
                                BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" Padding="18,12" MinWidth="115">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="PresetIcon" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" 
                                           FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="PresetLabel" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PresetBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="PresetBorder" Property="Background" Value="#211015"/>
                                <Setter TargetName="PresetBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#E11D2E" BlurRadius="12" ShadowDepth="0" Opacity="0.26"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PresetLabel" Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PresetBorder" Property="Background" Value="{StaticResource CardHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim slider thumb -->
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- ═══ Header Bar ═══ -->
        <Grid Grid.Row="0" Margin="20,15,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Click="BackButton_Click"
                    Background="Transparent" BorderThickness="0" BorderBrush="Transparent" Effect="{x:Null}" Cursor="Hand" Padding="0" Width="34" Height="34">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bb" CornerRadius="17" Background="Transparent">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource AccentColor}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bb" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Smart Video Compressor" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                <Border Background="{StaticResource InputBg}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="BETA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ Main Content ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
            <Grid Margin="20,20,15,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Drop Zone -->
                    <RowDefinition Height="Auto"/>  <!-- File Info Card -->
                    <RowDefinition Height="Auto"/>  <!-- Presets -->
                    <RowDefinition Height="Auto"/>  <!-- Quality Slider -->
                    <RowDefinition Height="Auto"/>  <!-- Resolution Picker -->
                    <RowDefinition Height="Auto"/>  <!-- Output Path -->
                    <RowDefinition Height="Auto"/>  <!-- Compress Button -->
                    <RowDefinition Height="Auto"/>  <!-- Progress -->
                    <RowDefinition Height="Auto"/>  <!-- Result Card -->
                </Grid.RowDefinitions>

                <!-- ── Drop Zone ── -->
                <Border x:Name="DropZoneBorder" Grid.Row="0" Height="170" CornerRadius="8"
                        Background="{StaticResource InputBg}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1"
                        AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                        MouseLeftButtonUp="DropZone_Click" Cursor="Hand" Margin="0,0,0,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.16" Color="Black"/>
                    </Border.Effect>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop a Video File Here" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        <TextBlock Text="MP4, MOV, AVI, MKV, WEBM" FontSize="11" Foreground="{StaticResource TextDim}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ── File Info Card ── -->
                <Border x:Name="FileInfoCard" Grid.Row="1" Visibility="Collapsed"
                        Background="{StaticResource CardBg}" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                        BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Thumbnail -->
                        <Border Grid.Column="0" Width="100" Height="60" CornerRadius="8" ClipToBounds="True" 
                                Background="{StaticResource InputBg}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" Margin="0,0,16,0">
                            <Image x:Name="VideoThumbnail" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="FileNameText" Text="video.mp4" FontSize="15" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="FileSizeText" Text="0 MB" Foreground="{StaticResource AccentColor}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="  |  " Foreground="{StaticResource StrongBorder}" FontSize="12"/>
                                <TextBlock x:Name="FileResolutionText" Text="1920×1080" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                <TextBlock Text="  |  " Foreground="{StaticResource StrongBorder}" FontSize="12"/>
                                <TextBlock x:Name="FileDurationText" Text="00:00" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Remove button -->
                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Click="RemoveFile_Click"
                                Background="Transparent" Foreground="{StaticResource DangerColor}" BorderThickness="0" BorderBrush="Transparent" Effect="{x:Null}"
                                FontSize="16" FontWeight="Bold" Cursor="Hand" Padding="8,4" VerticalAlignment="Top">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="xb" CornerRadius="8" Background="Transparent" Padding="8,4">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource DangerColor}" FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="xb" Property="Background" Value="#22FF4D5E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Quality Presets ── -->
                <StackPanel x:Name="PresetsPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="Compression Preset" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                               Margin="0,0,0,10"/>
                    <WrapPanel>
                        <RadioButton x:Name="PresetSocial" Style="{StaticResource PresetRadioStyle}" 
                                     Content="📱" Tag="Social Media" GroupName="Preset" IsChecked="True"
                                     Checked="Preset_Checked"/>
                        <RadioButton x:Name="PresetEmail" Style="{StaticResource PresetRadioStyle}" 
                                     Content="📧" Tag="Email Ready" GroupName="Preset"
                                     Checked="Preset_Checked"/>
                        <RadioButton x:Name="PresetBalanced" Style="{StaticResource PresetRadioStyle}" 
                                     Content="⚖️" Tag="Balanced" GroupName="Preset"
                                     Checked="Preset_Checked"/>
                        <RadioButton x:Name="PresetHighQ" Style="{StaticResource PresetRadioStyle}" 
                                     Content="💎" Tag="High Quality" GroupName="Preset"
                                     Checked="Preset_Checked"/>
                        <RadioButton x:Name="PresetCustom" Style="{StaticResource PresetRadioStyle}" 
                                     Content="🎛️" Tag="Custom" GroupName="Preset"
                                     Checked="Preset_Checked"/>
                    </WrapPanel>
                </StackPanel>

                <!-- ── Quality Slider (visible in Custom mode or always as read-only indicator) ── -->
                <Border x:Name="QualityPanel" Grid.Row="3" Visibility="Collapsed"
                        Background="{StaticResource CardBg}" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                        BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Quality (CRF)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="CrfValueText" Text="23" FontSize="13" FontWeight="Bold" 
                                       Foreground="{StaticResource AccentColor}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="CrfSlider" Minimum="18" Maximum="40" Value="23" 
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="CrfSlider_ValueChanged"/>
                        <Grid Margin="0,4,0,0">
                            <TextBlock Text="Higher Quality" FontSize="10" Foreground="{StaticResource TextDim}"/>
                            <TextBlock Text="Smaller File" FontSize="10" Foreground="{StaticResource TextDim}" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Resolution -->
                        <TextBlock Text="Output Resolution" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,20,0,10"/>
                        <WrapPanel>
                            <RadioButton x:Name="ResOriginal" Content="Original" GroupName="Resolution" IsChecked="True"
                                         Foreground="{StaticResource TextPrimary}" Margin="0,0,15,0" Cursor="Hand"/>
                            <RadioButton x:Name="Res1080" Content="1080p" GroupName="Resolution"
                                         Foreground="{StaticResource TextPrimary}" Margin="0,0,15,0" Cursor="Hand"/>
                            <RadioButton x:Name="Res720" Content="720p" GroupName="Resolution"
                                         Foreground="{StaticResource TextPrimary}" Margin="0,0,15,0" Cursor="Hand"/>
                            <RadioButton x:Name="Res480" Content="480p" GroupName="Resolution"
                                         Foreground="{StaticResource TextPrimary}" Margin="0,0,15,0" Cursor="Hand"/>
                        </WrapPanel>

                        <!-- Codec -->
                        <TextBlock Text="Codec" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,20,0,10"/>
                        <WrapPanel>
                            <RadioButton x:Name="CodecH264" Content="H.264 (Compatible)" GroupName="Codec" IsChecked="True"
                                         Foreground="{StaticResource TextPrimary}" Margin="0,0,15,0" Cursor="Hand"/>
                            <RadioButton x:Name="CodecH265" Content="H.265 (Smaller)" GroupName="Codec"
                                         Foreground="{StaticResource TextPrimary}" Margin="0,0,15,0" Cursor="Hand"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ── Output Path ── -->
                <Border x:Name="OutputPanel" Grid.Row="5" Visibility="Collapsed"
                        Background="{StaticResource CardBg}" CornerRadius="8" Padding="16" Margin="0,0,0,20"
                        BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OutputPathText" Text="Output: Same folder as input" 
                                   Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="Change" Click="ChangeOutput_Click"
                                Background="{StaticResource InputBg}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" Cursor="Hand"
                                Padding="12,6" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ob" CornerRadius="8" Background="{StaticResource InputBg}" BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center"/>
                                            <TextBlock Text="Change" FontSize="12" Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ob" Property="Background" Value="{StaticResource CardHover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Compress Button ── -->
                <Button x:Name="CompressButton" Grid.Row="6" Visibility="Collapsed"
                        Click="CompressButton_Click" Height="52" Cursor="Hand" Margin="0,0,0,20"
                        BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CompBorder" CornerRadius="8" Background="{StaticResource AccentGradient}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#E11D2E" BlurRadius="18" ShadowDepth="0" Opacity="0.28"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="CompressButtonText" Text="Compress Video" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CompBorder" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="CompBorder" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- ── Progress ── -->
                <Border x:Name="ProgressPanel" Grid.Row="7" Visibility="Collapsed"
                        Background="{StaticResource CardBg}" CornerRadius="8" Padding="20" Margin="0,0,0,20"
                        BorderBrush="{StaticResource SubtleBorder}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="ProgressStatusText" Text="Compressing..." FontSize="14" 
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock x:Name="ProgressPercentText" Text="0%" FontSize="14" FontWeight="Bold" 
                                       Foreground="{StaticResource AccentColor}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="CompressionProgress" Height="6" Background="{StaticResource InputBg}"
                                     BorderThickness="0" Foreground="{StaticResource AccentColor}" Value="0"/>
                        <TextBlock x:Name="ProgressDetailText" Text="" FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,8,0,0"/>
                        
                        <Button x:Name="CancelButton" Content="Cancel" Click="CancelCompress_Click"
                                Background="Transparent" Foreground="{StaticResource DangerColor}" BorderThickness="0" BorderBrush="Transparent" Effect="{x:Null}"
                                Cursor="Hand" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="0" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="ct" Text="Cancel" Foreground="{StaticResource DangerColor}" FontSize="12" Cursor="Hand"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ct" Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- ── Result Card ── -->
                <Border x:Name="ResultCard" Grid.Row="8" Visibility="Collapsed"
                        CornerRadius="8" Padding="24" Margin="0,0,0,20"
                        BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#102016"/>
                            <Setter Property="BorderBrush" Value="{StaticResource SuccessColor}"/>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource SuccessColor}" Margin="0,0,10,0"/>
                            <TextBlock x:Name="ResultTitle" Text="Compression Complete" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                        </StackPanel>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Before -->
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Before" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ResultBeforeSize" Text="120.5 MB" FontSize="22" FontWeight="Bold" 
                                           Foreground="{StaticResource DangerColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Arrow -->
                            <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource TextDim}"
                                       VerticalAlignment="Center" Margin="20,8,20,0"/>

                            <!-- After -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="After" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ResultAfterSize" Text="34.2 MB" FontSize="22" FontWeight="Bold" 
                                           Foreground="{StaticResource SuccessColor}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#16321F" CornerRadius="8" Padding="12,8" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <TextBlock x:Name="ResultSavingsText" Text="Saved 72% — 86.3 MB smaller!" 
                                       FontSize="14" FontWeight="Bold" Foreground="{StaticResource SuccessColor}"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="📂 Open Folder" Click="OpenOutputFolder_Click" 
                                    Background="{StaticResource CardBg}" Foreground="White" BorderThickness="0" Cursor="Hand"
                                    Padding="16,8" Margin="0,0,10,0" FontSize="13">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ofb" CornerRadius="10" Background="{StaticResource CardBg}" Padding="16,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Open Folder" FontSize="13" Foreground="White" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ofb" Property="Background" Value="#333333"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Click="CompressAnother_Click"
                                    Background="Transparent" Foreground="{StaticResource DangerColor}" BorderThickness="0" Cursor="Hand"
                                    Padding="16,8" FontSize="13">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="cab" CornerRadius="10" Background="Transparent" Padding="16,8" BorderBrush="{StaticResource DangerColor}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource DangerColor}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Compress Another" FontSize="13" Foreground="{StaticResource DangerColor}" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cab" Property="Background" Value="#11FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
