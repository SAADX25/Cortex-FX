<Window x:Class="CortexFX.Views.Radial.RadialCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CortexFX.Views.Radial"
        Title="Cortex FX · Crop image" Width="590" Height="800" MinWidth="480" MinHeight="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" Background="Transparent" Foreground="#F4F8FF"
        AllowsTransparency="False" FontFamily="Segoe UI" ShowInTaskbar="False" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="74" CornerRadius="20" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CropTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Border x:Name="GlassShell" Background="#F0192432" CornerRadius="20" BorderThickness="1">
        <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#65D8EDFF" Offset="0"/><GradientStop Color="#20FFFFFF" Offset="0.6"/><GradientStop Color="#38B7C9E5" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
        <Grid>
            <Border CornerRadius="19" IsHitTestVisible="False">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1"><GradientStop Color="#16B2DFFF" Offset="0"/><GradientStop Color="#00B2DFFF" Offset="0.48"/><GradientStop Color="#08838EB7" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="20,19,20,17">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="0,0,12,0">
                        <Path Data="M7,1 V17 H23 M1,7 H17 V23 M10,4 H20 V14" Stroke="#FFADC6" StrokeThickness="1.7" Width="21" Height="21" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Crop image" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Drag the edges to adjust the crop." Style="{StaticResource CropLabel}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CropButton}" Width="32" Height="32" MinHeight="32" Padding="9" Background="#0CFFFFFF"
                            VerticalAlignment="Center" Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close crop editor" ToolTip="Close (Esc)">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#D9E5F3" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Background="#200A1220" BorderBrush="#29D2E5FC" BorderThickness="1" CornerRadius="15" Margin="20,0,20,16" Padding="11">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="3,1,3,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="FileTitle" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="#D9E5F4" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="#14FFFFFF" CornerRadius="6" Padding="7,4" Margin="10,0,0,0">
                                <TextBlock x:Name="SourceDimensions" Text="Loading preview…" FontSize="10" Foreground="#BDCEE3"/>
                            </Border>
                        </Grid>
                        <local:ImageCropSurface x:Name="CropSurface" Grid.Row="1" Background="Transparent" FocusVisualStyle="{StaticResource CompressorFocusVisual}"
                                                ToolTip="Drag the corners or edges to crop. Arrow keys move the selection; Shift moves 10 pixels."/>
                    </Grid>
                </Border>
                <StackPanel Grid.Row="2" Margin="20,0,20,16">
                    <Grid><TextBlock Text="Aspect ratio" Style="{StaticResource CropLabel}"/><TextBlock Text="Free or fixed" Style="{StaticResource CropLabel}" Opacity="0.65" HorizontalAlignment="Right"/></Grid>
                    <Border Background="#18070D16" BorderBrush="#1DFFFFFF" BorderThickness="1" CornerRadius="11" Margin="0,8,0,15" Padding="2">
                        <UniformGrid x:Name="RatioPanel" Columns="6" IsEnabled="False">
                            <RadioButton x:Name="FreeRatio" Content="Free" Tag="0" IsChecked="True" GroupName="Ratio" Style="{StaticResource CropRatio}" Checked="Ratio_Checked"/>
                            <RadioButton Content="1:1" Tag="1" GroupName="Ratio" Style="{StaticResource CropRatio}" Checked="Ratio_Checked"/>
                            <RadioButton Content="16:9" Tag="1.777777777777778" GroupName="Ratio" Style="{StaticResource CropRatio}" Checked="Ratio_Checked"/>
                            <RadioButton Content="9:16" Tag="0.5625" GroupName="Ratio" Style="{StaticResource CropRatio}" Checked="Ratio_Checked"/>
                            <RadioButton Content="4:3" Tag="1.3333333333333333" GroupName="Ratio" Style="{StaticResource CropRatio}" Checked="Ratio_Checked"/>
                            <RadioButton Content="3:4" Tag="0.75" GroupName="Ratio" Style="{StaticResource CropRatio}" Checked="Ratio_Checked"/>
                        </UniformGrid>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Width" Style="{StaticResource CropLabel}" Margin="2,0,0,7"/>
                            <TextBox x:Name="WidthInput" Style="{StaticResource CropDimensionInput}" LostKeyboardFocus="Dimension_LostFocus" PreviewKeyDown="Dimension_KeyDown" AutomationProperties.Name="Crop width in pixels"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Height" Style="{StaticResource CropLabel}" Margin="2,0,0,7"/>
                            <TextBox x:Name="HeightInput" Style="{StaticResource CropDimensionInput}" LostKeyboardFocus="Dimension_LostFocus" PreviewKeyDown="Dimension_KeyDown" AutomationProperties.Name="Crop height in pixels"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="px" Style="{StaticResource CropLabel}" VerticalAlignment="Bottom" Margin="10,0,2,14"/>
                    </Grid>
                    <TextBlock x:Name="ValidationText" Foreground="#FFB7C9" FontSize="11" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,9,0,0"/><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Border Grid.Row="3" Background="#0B050B14" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,19,19" Padding="20,14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Button x:Name="ResetButton" Content="Reset" Click="Reset_Click" Style="{StaticResource CropButton}" IsEnabled="False" HorizontalAlignment="Left" MinWidth="86"/>
                        <Button x:Name="ApplyButton" Content="Apply crop" Style="{StaticResource CropPrimaryButton}" HorizontalAlignment="Right" MinWidth="142" IsDefault="True" IsEnabled="False" Click="Apply_Click"/>
                        <TextBlock Grid.Row="1" Text="Saves a new copy · Arrow keys move · Shift for 10 px" Style="{StaticResource CropLabel}" Foreground="#A6B8CF" FontSize="10" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>