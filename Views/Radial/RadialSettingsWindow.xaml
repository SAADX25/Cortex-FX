<Window x:Class="CortexFX.Views.Radial.RadialSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cortex FX · File shortcuts" Width="820" Height="740" MinHeight="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" Foreground="#EDF0F7" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CortexFX;component/Views/Radial/RadialTheme.xaml"/>
                <ResourceDictionary Source="/CortexFX;component/Views/Settings/SettingsTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="#191C24"/>
                <Setter Property="BorderBrush" Value="#303643"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="17"/>
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#ADB5C3"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="LineHeight" Value="17"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#4B5362" CornerRadius="3" Margin="5,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="DialogSurface" Background="#11141B" BorderBrush="#363C49" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,22,24,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="11" Background="#331E2A" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8AB;" Style="{StaticResource SettingsIcon}" Foreground="#FF8799"/>
                </Border>
                <StackPanel Grid.Column="1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="File shortcuts" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Convert and edit files straight from your desktop." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource SettingsIconButton}" Click="Close_Click" VerticalAlignment="Top" AutomationProperties.Name="Close file shortcuts" ToolTip="Close"/>
            </Grid>

            <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,0,18,18">
                <StackPanel Margin="0,0,6,0">
                    <Border Style="{StaticResource Card}" Padding="15" Background="#241B27" BorderBrush="#51303F" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="EnabledToggle" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="Enable file drag shortcuts">
                                <StackPanel><TextBlock Text="Enable drag shortcuts" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Show the action wheel while dragging files." Style="{StaticResource Hint}" Margin="0,3,0,0"/></StackPanel>
                            </CheckBox>
                            <Border Height="1" Background="#47303F" Margin="0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0"><TextBlock Text="1  Drag a file" FontWeight="SemiBold"/><TextBlock Text="From your desktop or a folder." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="2  Hold a shortcut key" FontWeight="SemiBold"/><TextBlock Text="Use one of the keys below." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="3  Drop on an action" FontWeight="SemiBold"/><TextBlock Text="Move onto the action, then release." Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Choose your shortcut keys" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="Each key opens a different group of actions." Style="{StaticResource Hint}" Margin="0,5,0,12"/>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Convert files" FontWeight="SemiBold"/><TextBlock Text="Change a file's format." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
                                    <ComboBox x:Name="ConvertKeyBox" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Convert files shortcut key"/>
                                </Grid>
                                <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Edit &amp; compress" FontWeight="SemiBold"/><TextBlock Text="Resize images, compress files and more." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
                                    <ComboBox x:Name="ToolsKeyBox" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Edit and compress shortcut key"/>
                                </Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="File actions" FontWeight="SemiBold"/><TextBlock Text="Create a ZIP or copy file paths." Style="{StaticResource Hint}" Margin="0,4,0,0"/></StackPanel>
                                    <ComboBox x:Name="QuickKeyBox" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="File actions shortcut key"/>
                                </Grid>
                                <TextBlock Text="Choose a different key for each group." Style="{StaticResource Hint}" FontSize="11" Margin="0,13,0,0"/>
                                <Border Height="1" Background="#303643" Margin="0,15,0,13"/>
                                <CheckBox x:Name="NotificationsToggle" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="Show file shortcut notifications">
                                    <StackPanel Margin="0,0,8,0"><TextBlock Text="Notify me when finished" FontWeight="SemiBold"/><TextBlock Text="Windows alerts for completed or failed actions." Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Output settings" FontSize="15" FontWeight="SemiBold"/>
                                    <DockPanel Margin="0,14,0,5"><TextBlock x:Name="QualityValue" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="#FF91A4"/><TextBlock Text="Conversion quality"/></DockPanel>
                                    <Slider x:Name="QualitySlider" Minimum="10" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Quality_ValueChanged" AutomationProperties.Name="File shortcut conversion quality"/>
                                    <Grid Margin="0,0,0,12"><TextBlock Text="Smaller files" Style="{StaticResource Hint}" FontSize="11"/><TextBlock Text="Higher quality" Style="{StaticResource Hint}" FontSize="11" HorizontalAlignment="Right"/></Grid>
                                    <TextBlock Text="PDF to image detail" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="DpiBox" SelectedValuePath="Value" AutomationProperties.Name="PDF image detail">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Try it without dragging" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="Pick an action group, then choose your files." Style="{StaticResource Hint}" Margin="0,5,0,10"/>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="ModeBox" AutomationProperties.Name="Action group" Margin="0,0,8,0"/>
                                        <Button x:Name="ChooseFilesButton" Grid.Column="1" Content="Choose files" Style="{StaticResource SettingsButton}" Padding="12,8" Click="ChooseFiles_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="New files are saved beside the originals. Your original files stay unchanged." Style="{StaticResource Hint}" FontSize="11" Margin="2,10,0,0"/>
                    <Expander x:Name="AdvancedOptions" Margin="0,9,0,0" Foreground="#B6BECC" FontSize="12">
                        <Expander.Template><ControlTemplate TargetType="Expander"><StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" HorizontalContentAlignment="Left">
                                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="2,5"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Arrow" Text="›" Foreground="#B6BECC" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5"/><TextBlock Text="Advanced settings" Foreground="#B6BECC"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="AdvancedContent" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
                        </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="AdvancedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Expander.Template>
                        <Border Style="{StaticResource Card}" Margin="0,9,0,0">
                            <StackPanel>
                                <TextBlock Text="Custom media engine (FFmpeg)" FontWeight="SemiBold"/>
                                <TextBlock Text="Leave this blank to use the engine included with Cortex FX." Style="{StaticResource Hint}" Margin="0,5,0,9"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="FfmpegBox" AutomationProperties.Name="Optional custom FFmpeg path" TextChanged="Ffmpeg_TextChanged" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource SettingsButton}" Click="Browse_Click"/>
                                </Grid>
                                <TextBlock x:Name="EngineStatus" Style="{StaticResource Hint}" Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#2B303B" BorderThickness="0,1,0,0" Padding="24,14">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SaveStatus" Text="Changes apply after saving." Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Grid.Column="1" Content="Close" Style="{StaticResource SettingsButton}" Click="Close_Click" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" x:Name="SaveButton" Content="Save changes" Style="{StaticResource SettingsPrimaryButton}" Click="Save_Click" IsDefault="True"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
