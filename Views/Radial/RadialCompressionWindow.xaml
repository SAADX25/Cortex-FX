<Window x:Class="CortexFX.Views.Radial.RadialCompressionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cortex FX · Compress" Width="560" Height="610" MinWidth="460" MinHeight="520" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent" Foreground="#F4F8FF" FontFamily="Segoe UI"
        AllowsTransparency="False" ShowInTaskbar="False" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="74" CornerRadius="20" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="CompressionTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Border x:Name="GlassShell" Background="#F0192432" CornerRadius="20" BorderThickness="1">
        <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#65D8EDFF" Offset="0"/><GradientStop Color="#20FFFFFF" Offset="0.6"/><GradientStop Color="#38B7C9E5" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
        <Grid>
            <Border CornerRadius="19" IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1"><GradientStop Color="#16B2DFFF" Offset="0"/><GradientStop Color="#00B2DFFF" Offset="0.48"/><GradientStop Color="#08838EB7" Offset="1"/></LinearGradientBrush></Border.Background></Border>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="20,19,20,17">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="12" Background="#1AFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Margin="0,0,12,0">
                        <Path Data="M2,2 L9,9 M9,3 V9 H3 M22,22 L15,15 M15,21 V15 H21" Stroke="#FFADC6" StrokeThickness="1.7" Width="21" Height="21" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Compress" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Choose how much space to save." Style="{StaticResource CropLabel}" Margin="0,3,0,0"/></StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource CropButton}" Width="32" Height="32" MinHeight="32" Padding="9" Background="#0CFFFFFF" VerticalAlignment="Center"
                            Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close compression options" ToolTip="Close (Esc)">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="#D9E5F3" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <ScrollViewer x:Name="OptionsScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,0,20,18" Focusable="False">
                    <StackPanel>
                        <Border Background="#18080F1B" BorderBrush="#27D2E5FC" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,0,0,17">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Background="#12FFFFFF" CornerRadius="9" Width="34" Height="38" Margin="0,0,11,0">
                                    <Path Data="M3,1 H13 L19,7 V23 H3 Z M13,1 V7 H19 M7,12 H15 M7,17 H12" Stroke="#B8CDE4" StrokeThickness="1.4" Width="18" Height="23" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="FileTitle" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectionHint" Style="{StaticResource CropLabel}" FontSize="10" Margin="0,5,0,0" Opacity="0.8"/></StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="OriginalCaption" Text="Original size" Style="{StaticResource CropLabel}" FontSize="10" HorizontalAlignment="Right"/><TextBlock x:Name="OriginalSize" FontSize="16" FontWeight="SemiBold" Margin="0,3,0,0" HorizontalAlignment="Right"/></StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock Text="Compression mode" Style="{StaticResource CropLabel}" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <RadioButton x:Name="PercentageMode" GroupName="CompressionMode" IsChecked="True" Style="{StaticResource CompressionModeCard}" Checked="Mode_Checked" AutomationProperties.Name="Reduce by percentage">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="%" FontSize="23" FontWeight="Light" Foreground="#FFAEC5" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Percentage" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Reduce by a percentage" Style="{StaticResource CropLabel}" FontSize="10" Margin="0,4,0,0"/></StackPanel></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MaximumMode" Grid.Column="2" GroupName="CompressionMode" Style="{StaticResource CompressionModeCard}" Checked="Mode_Checked" AutomationProperties.Name="Maximum file size">
                                <StackPanel Orientation="Horizontal"><Path Data="M1,2 H19 V18 H1 Z M5,6 H15 M5,10 H11 M5,14 H8" Stroke="#AFCBE2" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Target size" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Set a limit in KB or MB" Style="{StaticResource CropLabel}" FontSize="10" Margin="0,4,0,0"/></StackPanel></StackPanel>
                            </RadioButton>
                        </Grid>
                        <StackPanel x:Name="PercentagePanel">
                            <Grid><TextBlock Text="Reduce size by" Style="{StaticResource CropLabel}" VerticalAlignment="Center"/><Border Background="#17FFFFFF" BorderBrush="#27FFFFFF" BorderThickness="1" CornerRadius="7" Padding="8,4" HorizontalAlignment="Right"><TextBlock x:Name="PercentText" Text="50%" Foreground="#FFD3DF" FontSize="12" FontWeight="SemiBold"/></Border></Grid>
                            <Slider x:Name="ReductionSlider" Minimum="1" Maximum="95" Value="50" IsSnapToTickEnabled="True" TickFrequency="1" Style="{StaticResource QualitySlider}" ValueChanged="Reduction_Changed" Margin="0,8,0,0" AutomationProperties.Name="Reduction percentage"/>
                            <Grid Margin="0,1,0,0"><TextBlock Text="Gentler reduction" Style="{StaticResource CropLabel}" FontSize="10" Opacity="0.7"/><TextBlock Text="More space saved" Style="{StaticResource CropLabel}" FontSize="10" HorizontalAlignment="Right" Opacity="0.7"/></Grid>
                        </StackPanel>
                        <StackPanel x:Name="SizePanel" Visibility="Collapsed">
                            <TextBlock Text="Maximum output size" Style="{StaticResource CropLabel}" Margin="0,0,0,8"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SizeValue" Text="512" Style="{StaticResource CropDimensionInput}" FontSize="18" MinHeight="44" TextChanged="Size_Changed" AutomationProperties.Name="Maximum output size"/>
                                <ComboBox x:Name="SizeUnit" Grid.Column="2" SelectedIndex="0" Style="{StaticResource CompressionSizeUnit}" SelectionChanged="Options_Changed" AutomationProperties.Name="Size unit"><ComboBoxItem Content="KB"/><ComboBoxItem Content="MB"/></ComboBox>
                            </Grid>
                        </StackPanel>
                        <Border Background="#1AFFFFFF" BorderBrush="#30D2E5FC" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,18,0,0">
                            <StackPanel><TextBlock Text="Output limit" Style="{StaticResource CropLabel}"/><TextBlock x:Name="TargetText" Text="At most —" FontSize="24" Foreground="#F4F8FF" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="30" Margin="0,6,0,0"/><TextBlock x:Name="TargetHint" Style="{StaticResource CropLabel}" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"/></StackPanel>
                        </Border>
                        <StackPanel x:Name="PdfOptions" Visibility="Collapsed" Margin="0,15,0,0">
                            <Border Background="#10060D18" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="12" Padding="12">
                                <StackPanel><CheckBox x:Name="RasterizePdf" Content="Allow rasterized PDF pages" Style="{StaticResource CompressionCheckBox}" Checked="Rasterize_Changed" Unchecked="Rasterize_Changed" FontSize="12"/><TextBlock x:Name="PdfHint" Style="{StaticResource CropLabel}" TextWrapping="Wrap" LineHeight="17" FontSize="10" Margin="27,7,0,0"/></StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ValidationText" Visibility="Collapsed" Foreground="#FFB8CC" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2" Background="#0B050B14" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" CornerRadius="0,0,19,19" Padding="20,14">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="Your original stays unchanged." Style="{StaticResource CropLabel}" FontSize="11"/><TextBlock Text="A new copy is saved beside it." Style="{StaticResource CropLabel}" FontSize="10" Opacity="0.7" Margin="0,4,0,0"/></StackPanel>
                        <Button x:Name="ApplyButton" Grid.Column="1" Content="Compress" Style="{StaticResource CropPrimaryButton}" MinWidth="132" IsDefault="True" Click="Apply_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>