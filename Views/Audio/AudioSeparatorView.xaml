<UserControl x:Class="CortexFX.Views.Audio.AudioSeparatorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontFamily="Segoe UI" Foreground="#F5F0FF" UseLayoutRounding="True" AllowDrop="True" Drop="Audio_Drop">
 <UserControl.Resources>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="#170E24"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#62437F" CornerRadius="3" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
    </Track></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PurpleButton" TargetType="Button">
   <Setter Property="Background" Value="#2B1E45"/><Setter Property="Foreground" Value="#EEE5FF"/>
   <Setter Property="BorderBrush" Value="#594079"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="16,10"/><Setter Property="MinHeight" Value="40"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#C5A1FF"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#E3CCFF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource PurpleButton}"/>
  <Style x:Key="PreviewVolumeSlider" TargetType="Slider">
   <Setter Property="IsMoveToPointEnabled" Value="True"/>
   <Setter Property="Height" Value="28"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="Horizontal" VerticalAlignment="Center">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#AE78EF" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="12" Height="12"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#EAD5FF" Stroke="#B77EFC" StrokeThickness="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#4C3263" Height="4" CornerRadius="2"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
    </Track></Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Pill" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#B9A6D0"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="PillBorder" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="PillBorder" Property="Background" Value="#54357B"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PillBorder" Property="BorderBrush" Value="#A47BD5"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PillBorder" Property="BorderBrush" Value="#E3CCFF"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="PillBorder" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Eyebrow" TargetType="TextBlock"><Setter Property="Foreground" Value="#B698DF"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#B6A5CB"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="18"/></Style>
  <Style TargetType="Expander">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
    <StackPanel>
     <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Left">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="0,4"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Chevron" Text="›" FontSize="16" Foreground="#B68AE9" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
      <ContentPresenter Content="{TemplateBinding Header}"/>
     </ToggleButton>
     <ContentPresenter x:Name="AdvancedContent" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
    </StackPanel>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="AdvancedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid>
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1D102E"/><GradientStop Color="#100B1C" Offset="0.55"/><GradientStop Color="#211137" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid x:Name="Workspace" Margin="16,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="1.65*" MinHeight="230"/><RowDefinition Height="12"/><RowDefinition Height="*" MinHeight="160"/></Grid.RowDefinitions>
    <Border Background="#21152F" BorderBrush="#4B3265" BorderThickness="1" CornerRadius="16" Padding="18">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="Source track" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ChooseAudioBtn" Content="Choose song" Click="ChooseAudio_Click" HorizontalAlignment="Right" Padding="12,6" MinHeight="32"/></Grid>
      <Grid Grid.Row="1" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="46" Height="46" Background="#452663" CornerRadius="13"><TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" Foreground="#D0A6FF" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="SourceFileName" Text="Choose your song" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/><TextBlock x:Name="SourceDetails" Text="Drop an audio file here" Style="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      </Grid>
      <Border Grid.Row="2" Background="#160F22" CornerRadius="12" Margin="0,16,0,14" Padding="12,8">
       <Grid x:Name="SourceTimeline" ClipToBounds="True">
        <Border x:Name="SourcePlayedBand" Background="#208F51D5" Width="0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
        <Canvas x:Name="SourceWaveform" SizeChanged="Waveform_SizeChanged" ClipToBounds="True" IsHitTestVisible="False"/>
        <TextBlock x:Name="WaveformPlaceholder" Text="Choose a song to preview" Foreground="#987BB6" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Slider x:Name="SourceSeekSlider" Minimum="0" Maximum="1" SmallChange="5" LargeChange="15"
                IsEnabled="False" Visibility="Collapsed" IsMoveToPointEnabled="True" Background="Transparent" Cursor="Hand"
                ValueChanged="SourceSeek_ValueChanged" Thumb.DragStarted="SourceSeek_DragStarted" Thumb.DragCompleted="SourceSeek_DragCompleted"
                AutomationProperties.Name="Song playback position" AutomationProperties.HelpText="Click or drag to seek. Arrow keys move five seconds."
                ToolTip="Click or drag to seek in the song">
         <Slider.Template><ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
           <Track x:Name="PART_Track" Orientation="Horizontal">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Cursor="SizeWE" Width="12"><Thumb.Template><ControlTemplate TargetType="Thumb">
             <Grid Background="Transparent"><Border Width="2" Background="#F0DEFF"/><Ellipse Width="9" Height="9" Fill="#F4E7FF" Stroke="#A46BE8" StrokeThickness="1" VerticalAlignment="Top"/></Grid>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
           </Track>
          </Grid>
         </ControlTemplate></Slider.Template>
        </Slider>
       </Grid>
      </Border>
      <Grid Grid.Row="3">
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Button x:Name="PreviewSourceBtn" Content="▶  Preview song" Click="Preview_Click" HorizontalAlignment="Left" IsEnabled="False" MinHeight="34" Padding="12,6"/>
       <Button x:Name="PreviewMuteBtn" Grid.Column="1" Click="PreviewMute_Click" Width="32" MinHeight="32" Padding="6" Margin="10,0,0,0" ToolTip="Mute preview sound" AutomationProperties.Name="Mute or unmute preview sound"><TextBlock x:Name="PreviewVolumeIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" Foreground="#DDC0FF" FontSize="16"/></Button>
       <Slider x:Name="PreviewVolume" Grid.Column="2" Style="{StaticResource PreviewVolumeSlider}" Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="10" MinWidth="40" Margin="8,0,6,0" VerticalAlignment="Center" ValueChanged="PreviewVolume_Changed" ToolTip="Preview volume" AutomationProperties.Name="Preview volume"/>
       <TextBlock x:Name="PreviewVolumeText" Grid.Column="3" Text="100%" Foreground="#CBADE8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
       <TextBlock x:Name="SourcePosition" Grid.Column="4" Text="00:00.000" Foreground="#CCAEED" FontFamily="Consolas" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
      </Grid>
     </Grid>
    </Border>
    <Border Grid.Row="2" Background="#20142F" BorderBrush="#4B3265" BorderThickness="1" CornerRadius="16" Padding="18">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Stems" FontSize="17" FontWeight="SemiBold"/>
      <UniformGrid Grid.Row="1" Columns="2" Margin="0,14,0,0">
       <Button x:Name="OpenVocalsBtn" Click="OpenVocals_Click" Margin="0,0,6,0" IsEnabled="False"><TextBlock x:Name="VocalsLabel" Text="▶  Vocals" FontSize="17" FontWeight="SemiBold"/></Button>
       <Button x:Name="OpenMusicBtn" Click="OpenMusic_Click" Margin="6,0,0,0" IsEnabled="False"><TextBlock x:Name="MusicLabel" Text="▶  Instrumental" FontSize="17" FontWeight="SemiBold"/></Button>
      </UniformGrid>
      <StackPanel x:Name="SeparationResultsPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"><TextBlock x:Name="SeparationResultSummary" Foreground="#D5B3FF" FontSize="12"/><Button Content="Open output folder  ↗" Click="OpenFolder_Click" Margin="0,8,0,0"/></StackPanel>
     </Grid>
    </Border>
   </Grid>
   <Border Grid.Column="2" Background="#291A3C" BorderBrush="#60437D" BorderThickness="1" CornerRadius="16" Padding="18">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Separate audio" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
       <Border x:Name="EngineSetupPanel" Background="#352049" CornerRadius="11" Padding="14" Margin="0,0,0,20"><StackPanel><TextBlock Text="AI engine" FontWeight="SemiBold" FontSize="14" Foreground="#E2C7FF"/><TextBlock x:Name="EngineSetupDescription" Text="One-time download · ~82 MB installed" Style="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
       <TextBlock Text="Export format" Foreground="#D7BDEB" FontSize="14" Margin="0,0,0,9"/>
       <Border Background="#1A1028" BorderBrush="#503368" BorderThickness="1" CornerRadius="10" Padding="3"><UniformGrid Columns="2"><RadioButton x:Name="OutputMp3" Content="MP3" GroupName="SeparatorFormat" Style="{StaticResource Pill}" IsChecked="True" Checked="Options_Changed"/><RadioButton x:Name="OutputWav" Content="WAV" GroupName="SeparatorFormat" Style="{StaticResource Pill}" Checked="Options_Changed"/></UniformGrid></Border>
       <TextBlock x:Name="SeparationScopeText" Text="MP3 · 192 kbps" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
       <Expander x:Name="AdvancedOptions" Header="Advanced options" Foreground="#C8ACE5" FontSize="13" Margin="0,20,0,0">
        <StackPanel Margin="0,10,0,0"><TextBlock Text="Processing" Foreground="#D7BDEB" FontSize="13" Margin="0,0,0,8"/><Border Background="#1A1028" CornerRadius="10" Padding="3"><UniformGrid Columns="2"><RadioButton x:Name="ProcessingCpu" Content="Standard" GroupName="SeparatorProcessor" Style="{StaticResource Pill}" IsChecked="True" Checked="Options_Changed"/><RadioButton x:Name="ProcessingGpu" Content="NVIDIA GPU" GroupName="SeparatorProcessor" Style="{StaticResource Pill}" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Checked="Options_Changed"/></UniformGrid></Border></StackPanel>
       </Expander>
      </StackPanel>
     </ScrollViewer>
     <StackPanel Grid.Row="2" Margin="0,18,0,0">
      <Button x:Name="SeparateAudioBtn" Content="Download AI engine" Click="Primary_Click" Background="#9253E8" BorderBrush="#BE8FFF" Foreground="White" FontSize="15" MinHeight="50"/>
      <StackPanel x:Name="AiDownloadProgressPanel" Visibility="Collapsed" Margin="0,14,0,0"><ProgressBar x:Name="AiDownloadProgress" Height="7" Foreground="#C291FF" Background="#49315D" BorderThickness="0" IsIndeterminate="True"/><TextBlock x:Name="AiDownloadProgressText" Text="Preparing download…" Foreground="#D5B3FF" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></StackPanel>
      <TextBlock x:Name="SeparationStatusText" Text="" Style="{StaticResource Muted}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
      <Button x:Name="CancelAiDownloadBtn" Content="Cancel download" Click="CancelDownload_Click" Visibility="Collapsed" Margin="0,8,0,0" MinHeight="32" Padding="10,6"/>
      <StackPanel x:Name="SeparationProgressPanel" Visibility="Collapsed" Margin="0,12,0,0"><ProgressBar x:Name="SeparationProgress" Height="6" Foreground="#BA87FF" Background="#49315D" BorderThickness="0"/><Button Content="Cancel separation" Click="CancelSeparation_Click" Margin="0,8,0,0" MinHeight="32" Padding="10,6"/></StackPanel>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>
