<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CortexFX.Views.Audio.AudioCutterView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                    <!-- Audio Editor View -->
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0B121A" Offset="0"/>
                                <GradientStop Color="#08090D" Offset="0.55"/>
                                <GradientStop Color="#120A10" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Border Background="{DynamicResource AudioEditorPanelGradient}"
                                BorderBrush="#2A4A60" BorderThickness="1"
                                CornerRadius="16" Padding="0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Audio Cutter" Foreground="{DynamicResource TextPrimary}"
                                                       FontSize="22" FontWeight="Bold"/>
                                            <Border Background="#102830" BorderBrush="#38BDF8" BorderThickness="1"
                                                    CornerRadius="8" Padding="9,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="LIVE SPECTRUM" FontSize="9" FontWeight="Bold"
                                                           Foreground="{DynamicResource AudioAccentColor}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="AudioEditorFileNameText" Text="-" Foreground="{DynamicResource TextSecondary}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#0A1520" BorderBrush="#2A4A60"
                                            BorderThickness="1" CornerRadius="10" Padding="12,8" VerticalAlignment="Center">
                                        <TextBlock x:Name="CurrentTimeDisplay" Text="00:00.000" Foreground="{DynamicResource AudioAccentColor}"
                                                   FontFamily="Consolas" FontSize="14" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <Border Grid.Row="1" Height="230" MinHeight="200"
                                        Background="#050A10" CornerRadius="14"
                                        BorderBrush="#2A4A60" BorderThickness="1"
                                        ClipToBounds="True" Margin="0,0,0,10">
                                    <Grid x:Name="WaveformContainer"
                                          MouseLeftButtonDown="Waveform_MouseLeftButtonDown"
                                          MouseMove="Waveform_MouseMove"
                                          MouseLeftButtonUp="Waveform_MouseLeftButtonUp"
                                          SizeChanged="WaveformContainer_SizeChanged"
                                          Cursor="Cross">
                                        <Grid.Background>
                                            <DynamicResource ResourceKey="AudioWaveformBackground"/>
                                        </Grid.Background>
                                        <Rectangle x:Name="SelectionBand" Fill="#3338BDF8"
                                                   HorizontalAlignment="Left" Width="0"/>
                                        <Canvas x:Name="WaveformCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                                        <Rectangle x:Name="DimLeft" Fill="#7D050A10" HorizontalAlignment="Left"
                                                   Width="0" Visibility="Visible"/>
                                        <Rectangle x:Name="DimRight" Fill="#7D050A10" HorizontalAlignment="Left"
                                                   Width="0" Visibility="Visible"/>
                                        <Rectangle x:Name="StartMarker" Width="4" Fill="{DynamicResource AudioMarkerStart}"
                                                   HorizontalAlignment="Left" Visibility="Visible"/>
                                        <Rectangle x:Name="EndMarker" Width="4" Fill="{DynamicResource AudioMarkerEnd}"
                                                   HorizontalAlignment="Left" Visibility="Visible"/>
                                        <Line x:Name="PlaybackCursor" X1="0" Y1="0" X2="0" Y2="230"
                                              Stroke="#FF6B4A" StrokeThickness="2.5" Visibility="Visible"/>
                                    </Grid>
                                </Border>

                                <!-- Live frequency spectrum -->
                                <Border Grid.Row="2" Height="120" CornerRadius="14" Margin="0,0,0,14"
                                        Background="#071018" BorderBrush="#38BDF8" BorderThickness="1" ClipToBounds="True">
                                    <Grid>
                                        <TextBlock Text="Live frequency — press Play to animate" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#7DD3FC" Margin="12,8,0,0" VerticalAlignment="Top"
                                                   IsHitTestVisible="False"/>
                                        <TextBlock x:Name="SpectrumStatusText" Text="Waiting for playback…"
                                                   FontSize="12" Foreground="#6B8A9E" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                                        <Grid x:Name="SpectrumHost" Margin="10,28,10,10"
                                              SizeChanged="SpectrumCanvas_SizeChanged">
                                            <Canvas x:Name="SpectrumCanvas" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
                                        <Border Background="#0A1520" BorderBrush="#2A4A60"
                                                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="Start" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                <TextBlock x:Name="StartTimeDisplay" Text="00:00.000"
                                                           Foreground="{DynamicResource AudioMarkerStart}" FontFamily="Consolas"
                                                           FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0A1520" BorderBrush="#2A4A60"
                                                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="End" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                <TextBlock x:Name="EndTimeDisplay" Text="00:00.000"
                                                           Foreground="{DynamicResource AudioMarkerEnd}" FontFamily="Consolas"
                                                           FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#0A1520" BorderBrush="#2A4A60"
                                                BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Duration" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                                <TextBlock x:Name="DurationTimeDisplay" Text="00:00.000"
                                                           Foreground="{DynamicResource AudioAccentHover}" FontFamily="Consolas"
                                                           FontSize="15" FontWeight="Bold" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#0A1520" BorderBrush="#2A4A60"
                                                BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,12,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{DynamicResource AudioAccentColor}" VerticalAlignment="Center"
                                                           Margin="0,0,8,0"/>
                                                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="1"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="False"
                                                        VerticalAlignment="Center"
                                                        ToolTip="Saved on this PC and applied to every export format"
                                                        ValueChanged="VolumeSlider_ValueChanged"/>
                                                <TextBlock x:Name="VolumePercentText" Grid.Column="2"
                                                           Text="100%" Margin="10,0,0,0" MinWidth="40"
                                                           Foreground="{DynamicResource AudioAccentHover}"
                                                           FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>

                                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <Button x:Name="SetStartBtn" Content="Set Start" Click="SetStart_Click"
                                                    Style="{DynamicResource AudioToolButtonStyle}"
                                                    Width="112" Height="38" Margin="0,0,8,0"
                                                    Background="#06131F" Foreground="{DynamicResource AudioMarkerStart}"
                                                    BorderBrush="{DynamicResource AudioMarkerStart}" BorderThickness="1"
                                                    FontSize="13" FontWeight="SemiBold"/>
                                            <Button x:Name="SetEndBtn" Content="Set End" Click="SetEnd_Click"
                                                    Style="{DynamicResource AudioToolButtonStyle}"
                                                    Width="112" Height="38" Margin="0,0,8,0"
                                                    Background="#07111D" Foreground="{DynamicResource AudioMarkerEnd}"
                                                    BorderBrush="{DynamicResource AudioMarkerEnd}" BorderThickness="1"
                                                    FontSize="13" FontWeight="SemiBold"/>
                                            <Button x:Name="PlaySelectionBtn" Content="Play" Click="PlaySelection_Click"
                                                    Style="{DynamicResource AudioToolButtonStyle}"
                                                    Width="100" Height="38" Margin="0,0,8,0"
                                                    Background="#0369A1" Foreground="White"
                                                    BorderBrush="{DynamicResource AudioAccentColor}" BorderThickness="1"
                                                    FontSize="13" FontWeight="SemiBold"/>
                                            <Button x:Name="StopSelectionBtn" Content="Stop" Click="StopSelection_Click"
                                                    Style="{DynamicResource AudioToolButtonStyle}"
                                                    Width="96" Height="38" Margin="0,0,8,0"
                                                    Background="#1A222C" Foreground="#E8F0F6" BorderBrush="#3D5A6C" BorderThickness="1"
                                                    FontSize="13" FontWeight="SemiBold"/>
                                            <Button x:Name="SaveSelectionBtn" Content="Save Cut" Click="SaveSelection_Click"
                                                    Style="{DynamicResource AudioToolButtonStyle}"
                                                    Width="110" Height="38" Margin="0,0,8,0"
                                                    Background="{DynamicResource AudioSaveColor}" Foreground="White"
                                                    BorderBrush="{DynamicResource AudioSaveBorder}" BorderThickness="1"
                                                    FontSize="13" FontWeight="SemiBold"/>
                                            <Button Content="Close" Click="CloseAudioEditor_Click"
                                                    Style="{DynamicResource AudioToolButtonStyle}"
                                                    Width="86" Height="38"
                                                    Background="#2A1418" Foreground="#FFB4BC"
                                                    BorderBrush="#7A3038" BorderThickness="1"
                                                    FontSize="13" FontWeight="SemiBold"/>
                                        </WrapPanel>
                                    </Grid>
                                </Grid>
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Grid>
    

</UserControl>
