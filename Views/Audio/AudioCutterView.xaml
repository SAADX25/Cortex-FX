<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CortexFX.Views.Audio.AudioCutterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TimeCard" TargetType="Border">
            <Setter Property="Background" Value="#101A24"/>
            <Setter Property="BorderBrush" Value="#294050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="13,8"/>
        </Style>
    </UserControl.Resources>
    <Grid Background="#090E15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="AUDIO CUTTER" Foreground="#79CBEF" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="AudioEditorFileNameText" Text="-" Foreground="#F0F7FB"
                           FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,20,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#10212D" BorderBrush="#315368"
                    BorderThickness="1" CornerRadius="10" Padding="14,8" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="PLAYHEAD" Foreground="#90A8B7" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CurrentTimeDisplay" Text="00:00.000"
                               Foreground="{DynamicResource AudioAccentColor}"
                               FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Visualization flexes; the command deck is anchored below it. -->
        <Grid Grid.Row="1" Margin="20,0,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="96"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource AudioWaveformBackground}"
                    BorderBrush="#2B5267" BorderThickness="1" CornerRadius="13"
                    ClipToBounds="True" Margin="0,0,0,10">
                <Grid>
                    <TextBlock Text="DRAG ACROSS THE WAVEFORM TO SELECT A RANGE"
                               Foreground="#8EB9CD" FontSize="10" FontWeight="SemiBold"
                               Margin="14,10,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
                    <Grid x:Name="WaveformContainer" Margin="0,30,0,0"
                          MouseLeftButtonDown="Waveform_MouseLeftButtonDown"
                          MouseMove="Waveform_MouseMove"
                          MouseLeftButtonUp="Waveform_MouseLeftButtonUp"
                          SizeChanged="WaveformContainer_SizeChanged" Cursor="Cross"
                          Background="Transparent">
                        <Rectangle x:Name="SelectionBand" Fill="#2638BDF8" HorizontalAlignment="Left" Width="0"/>
                        <Canvas x:Name="WaveformCanvas" IsHitTestVisible="False" ClipToBounds="True"/>
                        <Rectangle x:Name="DimLeft" Fill="#99050A10" HorizontalAlignment="Left" Width="0"/>
                        <Rectangle x:Name="DimRight" Fill="#99050A10" HorizontalAlignment="Left" Width="0"/>
                        <Rectangle x:Name="StartMarker" Width="3" Fill="{DynamicResource AudioMarkerStart}" HorizontalAlignment="Left"/>
                        <Rectangle x:Name="EndMarker" Width="3" Fill="{DynamicResource AudioMarkerEnd}" HorizontalAlignment="Left"/>
                        <Line x:Name="PlaybackCursor" X1="0" Y1="0" X2="0" Y2="200"
                              Stroke="#FF8468" StrokeThickness="2"/>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Row="1" Background="#0D1821" BorderBrush="#294050"
                    BorderThickness="1" CornerRadius="11" ClipToBounds="True">
                <Grid>
                    <TextBlock Text="LIVE SPECTRUM" FontSize="10" FontWeight="Bold"
                               Foreground="#7DCBEF" Margin="12,8,0,0" VerticalAlignment="Top"
                               IsHitTestVisible="False"/>
                    <TextBlock x:Name="SpectrumStatusText" Text="Play selection to preview"
                               FontSize="12" Foreground="#7F9CAD" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <Grid x:Name="SpectrumHost" Margin="12,27,12,8"
                          SizeChanged="SpectrumCanvas_SizeChanged">
                        <Canvas x:Name="SpectrumCanvas" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#101820" BorderBrush="#304453"
                BorderThickness="0,1,0,0" Padding="20,10,20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,12">
                    <Border Style="{StaticResource TimeCard}" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="START" Foreground="#91A8B7" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StartTimeDisplay" Text="00:00.000"
                                       Foreground="{DynamicResource AudioMarkerStart}"
                                       FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TimeCard}" Margin="3,0">
                        <StackPanel>
                            <TextBlock Text="END" Foreground="#91A8B7" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="EndTimeDisplay" Text="00:00.000"
                                       Foreground="{DynamicResource AudioMarkerEnd}"
                                       FontFamily="Consolas" FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TimeCard}" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SELECTION LENGTH" Foreground="#91A8B7" FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DurationTimeDisplay" Text="00:00.000"
                                       Foreground="#E5F4FA" FontFamily="Consolas"
                                       FontSize="15" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2.1*"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SetStartBtn" Grid.Column="0" Content="Set Start" Click="SetStart_Click"
                            Style="{DynamicResource AudioToolButtonStyle}" Height="42" Margin="0,0,7,0"
                            Background="#10242C" Foreground="{DynamicResource AudioMarkerStart}"
                            BorderBrush="#277C8A" Effect="{x:Null}"/>
                    <Button x:Name="SetEndBtn" Grid.Column="1" Content="Set End" Click="SetEnd_Click"
                            Style="{DynamicResource AudioToolButtonStyle}" Height="42" Margin="0,0,7,0"
                            Background="#132131" Foreground="{DynamicResource AudioMarkerEnd}"
                            BorderBrush="#3C699D" Effect="{x:Null}"/>
                    <Button x:Name="PlaySelectionBtn" Grid.Column="2" Click="PlaySelection_Click"
                            Style="{DynamicResource AudioToolButtonStyle}" Height="42" Margin="0,0,7,0"
                            Background="#174C67" Foreground="White" BorderBrush="#3B98C1" Effect="{x:Null}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlaybackButtonIcon" Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="15" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="PlaybackButtonLabel" Text="Play" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="3" Background="#202C36" BorderBrush="#526675"
                            BorderThickness="1" CornerRadius="9" Margin="0,0,7,0" Height="42">
                        <Grid Margin="5,0,8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="PreviewSoundBtn" Grid.Column="0" Click="PreviewSound_Click"
                                    Style="{DynamicResource AudioToolButtonStyle}" Background="Transparent"
                                    Foreground="#DCEAF1" BorderThickness="0" Effect="{x:Null}"
                                    ToolTip="Mute preview sound" Padding="4,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PreviewSoundIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="PreviewSoundLabel" Text="Sound" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Slider x:Name="AudioGainSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100"
                                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    ValueChanged="AudioGainSlider_ValueChanged"
                                    ToolTip="Preview volume only — saved audio keeps its original level"/>
                            <TextBlock x:Name="AudioGainText" Grid.Column="2" Text="100%"
                                       Foreground="#DCEAF1" FontFamily="Consolas" FontSize="12"
                                       FontWeight="SemiBold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Button x:Name="SaveSelectionBtn" Grid.Column="4" Content="Save Cut" Click="SaveSelection_Click"
                            Style="{DynamicResource AudioToolButtonStyle}" Height="42"
                            Background="#146B83" Foreground="White" BorderBrush="#4CB5CC" Effect="{x:Null}"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
