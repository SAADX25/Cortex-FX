<UserControl x:Class="CortexFX.Views.WatermarkRemoverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="850"
             Background="#0A0A0A">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Accent brushes matching VideoCompressorView -->
        <LinearGradientBrush x:Key="AccentGradientRed" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF2D55" Offset="0"/>
            <GradientStop Color="#C2185B" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBg" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="SubtleBorder" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="TextDim" Color="#888888"/>

        <!-- Reusable pill button template -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill" CornerRadius="10" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Opacity" Value="0.85"/>
                                <Setter TargetName="pill" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="White" BlurRadius="8" ShadowDepth="0" Opacity="0.15"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="pill" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>     <!-- Video viewport -->
            <RowDefinition Height="Auto"/>  <!-- Timeline strip -->
            <RowDefinition Height="Auto"/>  <!-- Control bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — VIDEO VIEWPORT (rounded card with shadow)
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Margin="16,12,16,0" CornerRadius="14" ClipToBounds="True"
                Background="#111111" BorderBrush="#2A2A2A" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" Color="Black"/>
            </Border.Effect>
            <Grid>
                <!-- Media player -->
                <ffme:MediaElement x:Name="WatermarkVideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   MediaOpened="MediaElement_MediaOpened"
                                   MediaFailed="MediaElement_MediaFailed"/>

                <!-- Snapshot for selection mode -->
                <Image x:Name="SnapshotPreview" Visibility="Collapsed" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Drawing canvas (selection rectangles) -->
                <Canvas x:Name="DrawingCanvas" Background="Transparent"
                        Panel.ZIndex="998"
                        IsHitTestVisible="False"
                        MouseLeftButtonDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseLeftButtonUp="Canvas_MouseUp"
                        Cursor="Arrow">
                    <Rectangle x:Name="SelectionRect" StrokeThickness="2" Visibility="Collapsed"/>
                </Canvas>

                <!-- Region overlay (clickable, above drawing canvas) -->
                <ItemsControl x:Name="RegionsOverlay" IsHitTestVisible="True"
                              Panel.ZIndex="999"
                              Width="{Binding ElementName=WatermarkVideoPlayer, Path=ActualWidth}"
                              Height="{Binding ElementName=WatermarkVideoPlayer, Path=ActualHeight}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                                           Stroke="{Binding Stroke}" Fill="{Binding Fill}" StrokeThickness="2"
                                           Cursor="Hand" MouseLeftButtonDown="Region_MouseLeftButtonDown"/>
                                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                        Background="#CC111111" CornerRadius="6" Padding="6,2" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding TimeLabel}" Foreground="White" FontSize="9.5" FontFamily="Consolas"/>
                                </Border>
                                <Button Content="✕" Click="RegionClose_Click" Tag="{Binding}"
                                        Width="20" Height="20" FontSize="11" FontWeight="Bold" Padding="0" Cursor="Hand"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0"
                                        Foreground="White" BorderThickness="0"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="xb" Width="20" Height="20" CornerRadius="10" Background="#E53935" Cursor="Hand">
                                                <TextBlock Text="✕" Foreground="White" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="xb" Property="Background" Value="#FF1744"/>
                                                    <Setter TargetName="xb" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#FF1744" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Loading Overlay (modern spinner + frosted glass look) -->
                <Grid x:Name="LoadingOverlay" Visibility="Collapsed" Background="#DD0A0A0A">
                    <Border CornerRadius="16" Background="#1A1A1A" Padding="30,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="#2A2A2A" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <Viewbox Width="44" Height="44">
                                <Grid Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Grid.RenderTransform>
                                    <Ellipse Width="20" Height="20" Stroke="#22FF2D55" StrokeThickness="2.5"/>
                                    <Path Data="M 10 0 A 10 10 0 0 1 20 10" Stroke="#FF2D55" StrokeThickness="2.5" Stretch="None"/>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="Loading Video..." Foreground="#CCCCCC" HorizontalAlignment="Center"
                                       Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Processing Overlay (progress bar for watermark removal) -->
                <Grid x:Name="ProcessingOverlay" Visibility="Collapsed" Background="#EE0A0A0A" Panel.ZIndex="1100">
                    <Border CornerRadius="16" Background="#1A1A1A" Padding="36,28" HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="#2A2A2A" BorderThickness="1" MinWidth="340">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Stretch">
                            <!-- Spinner -->
                            <Viewbox Width="40" Height="40" HorizontalAlignment="Center">
                                <Grid Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </Grid.RenderTransform>
                                    <Ellipse Width="20" Height="20" Stroke="#22FF2D55" StrokeThickness="2.5"/>
                                    <Path Data="M 10 0 A 10 10 0 0 1 20 10" Stroke="#FF2D55" StrokeThickness="2.5" Stretch="None"/>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>
                            </Viewbox>

                            <!-- Status text -->
                            <TextBlock x:Name="ProcessingStatusText" Text="Removing watermark..."
                                       Foreground="#CCCCCC" HorizontalAlignment="Center"
                                       Margin="0,14,0,0" FontSize="14" FontWeight="SemiBold"/>

                            <!-- Percentage text -->
                            <TextBlock x:Name="ProcessingPercentText" Text="0 %"
                                       Foreground="#FF2D55" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" FontSize="22" FontWeight="Bold" FontFamily="Consolas"/>

                            <!-- Progress bar track -->
                            <Border CornerRadius="5" Background="#222222" Height="10" Margin="0,14,0,0" ClipToBounds="True">
                                <Border x:Name="ProcessingProgressBar" CornerRadius="5" Height="10"
                                        HorizontalAlignment="Left" Width="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#FF2D55" Offset="0"/>
                                            <GradientStop Color="#FF6B81" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — TIMELINE STRIP (modern editor-style)
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Margin="16,8,16,0" CornerRadius="10" Background="#141414"
                BorderBrush="#2A2A2A" BorderThickness="1" Padding="6,4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <Border x:Name="TimelineBorder" Height="60" Background="Transparent" BorderThickness="0"
                    SizeChanged="TimelineBorder_SizeChanged">
                <Grid>
                    <ListBox x:Name="ThumbnailsTimeline" Height="60" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             SelectionChanged="ThumbnailsTimeline_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="96" Height="54" CornerRadius="5" Margin="2" Background="#1E1E1E"
                                        ClipToBounds="True">
                                    <Image Source="{Binding Image}" Stretch="UniformToFill" Opacity="0">
                                        <Image.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0" To="1" Duration="0:0:0.35"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Image.Triggers>
                                    </Image>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Canvas x:Name="TimelineRegionCanvas" Background="Transparent" IsHitTestVisible="False"/>
                    <Canvas x:Name="TimelineOverlay" Background="Transparent"
                            MouseLeftButtonDown="TimelineOverlay_MouseLeftButtonDown"
                            MouseMove="TimelineOverlay_MouseMove"
                            MouseLeftButtonUp="TimelineOverlay_MouseLeftButtonUp">
                        <Rectangle x:Name="PlayheadLine" Width="2" Height="60" Fill="#FF2D55" RadiusX="1" RadiusY="1"/>
                    </Canvas>
                </Grid>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — CONTROL PANEL (sleek modern bottom bar)
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Margin="16,8,16,12" CornerRadius="14" Padding="20,12"
                Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="Black" Opacity="0.4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Buttons -->
                    <RowDefinition Height="Auto"/>  <!-- Timestamp indicators -->
                </Grid.RowDefinitions>

                <!-- ── Row 0: Action Buttons ── -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">

                    <!-- Open Video -->
                    <Button Content="📂 Open" Click="OpenVideo_Click" Width="88" Height="36" Margin="0,0,4,0"
                            Background="#2A2A2A" Style="{StaticResource PillButton}"/>

                    <!-- Play / Pause -->
                    <Button x:Name="btnPlayPause" Content="▶ Play" Click="PlayPause_Click" Width="78" Height="36" Margin="0,0,8,0"
                            Style="{StaticResource PillButton}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2E7D32" Offset="0"/>
                                <GradientStop Color="#43A047" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="24" Background="#333333" Margin="4,0,12,0" VerticalAlignment="Center"/>

                    <!-- In / Out Points -->
                    <Button Click="WmSetIn_Click" Width="56" Height="36" Margin="0,0,4,0" Style="{StaticResource PillButton}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00838F" Offset="0"/>
                                <GradientStop Color="#00ACC1" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="[ In" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Button>
                    <Button Click="WmSetOut_Click" Width="56" Height="36" Margin="0,0,8,0" Style="{StaticResource PillButton}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#C2185B" Offset="0"/>
                                <GradientStop Color="#E91E63" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="Out ]" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="24" Background="#333333" Margin="4,0,12,0" VerticalAlignment="Center"/>

                    <!-- Select / Add Region -->
                    <Button x:Name="btnSelectRegion" Content="✂ Select" Click="SelectRegion_Click"
                            Width="82" Height="36" Margin="0,0,4,0" Style="{StaticResource PillButton}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6C63FF" Offset="0"/>
                                <GradientStop Color="#8A7CFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Content="+ Add" Click="AddRegion_Click" Width="68" Height="36" Margin="0,0,8,0" Style="{StaticResource PillButton}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00BCD4" Offset="0"/>
                                <GradientStop Color="#00E5FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="24" Background="#333333" Margin="4,0,12,0" VerticalAlignment="Center"/>

                    <!-- Remove Watermark (primary CTA) -->
                    <Button Content="✨ Remove" Click="RemoveWatermark_Click" Width="108" Height="36" Margin="0,0,8,0"
                            Background="{StaticResource AccentGradientRed}" Style="{StaticResource PillButton}" FontSize="13">
                    </Button>

                    <!-- Close -->
                    <Button Click="CancelWatermark_Click" Height="36" Padding="14,0"
                            FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                            Foreground="#FF4060" Background="Transparent">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closePill" CornerRadius="10" Padding="14,0"
                                        Background="#1A1A1A" BorderBrush="#44FF2D55" BorderThickness="1.2">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✕" Foreground="#FF4060" FontSize="11" FontWeight="Bold"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Close" Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closePill" Property="Background" Value="#2A1520"/>
                                        <Setter TargetName="closePill" Property="BorderBrush" Value="#88FF2D55"/>
                                        <Setter TargetName="closePill" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#FF2D55" BlurRadius="10" ShadowDepth="0" Opacity="0.25"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- ── Row 1: Timestamp Display ── -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#111111" CornerRadius="8" Padding="10,4" Margin="0,0,8,0"
                            BorderBrush="#222222" BorderThickness="1">
                        <TextBlock x:Name="WmInPointLabel" Text="IN  00:00:00.0"
                                   Foreground="#00E5FF" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#111111" CornerRadius="8" Padding="10,4"
                            BorderBrush="#222222" BorderThickness="1">
                        <TextBlock x:Name="WmOutPointLabel" Text="OUT  END"
                                   Foreground="#FF4081" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
