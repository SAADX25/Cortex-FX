                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ConvertBorder" CornerRadius="10" Background="{StaticResource InputBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource AccentSecondary}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock Text="{DynamicResource Loc_AudioChoice_Convert}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_AudioChoice_ConvertSub}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ConvertBorder" Property="Background" Value="{StaticResource NavButtonHover}"/>
                                            <Setter TargetName="ConvertBorder" Property="BorderBrush" Value="{StaticResource AccentSecondary}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Button Content="{DynamicResource Loc_Dlg_Cancel}" Click="CancelChoice_Click" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderBrush="Transparent" BorderThickness="0" Effect="{x:Null}" Cursor="Hand" HorizontalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings Overlay (Obsidian & Crimson + Flagship Language Switcher) -->
        <Grid x:Name="SettingsOverlay" Background="#DF05060A" Visibility="Collapsed"
