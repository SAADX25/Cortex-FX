                                                  AutomationProperties.Name="Add Convert with Cortex FX to the Windows context menu"
                                                  ToolTip="{DynamicResource Loc_Settings_ContextMenuTip}">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource Loc_Settings_ContextMenu}" FontSize="12" FontWeight="SemiBold" Foreground="#E4E7F0"/>
