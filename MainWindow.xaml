                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="13" Background="#24121B" BorderBrush="#5A2536" BorderThickness="1" Margin="0,0,14,0">
                            <TextBlock Text="&#xE713;" Style="{StaticResource SettingsIcon}" FontSize="22" Foreground="#FF6378"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc_Settings_Title}" FontSize="24" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                            <TextBlock Text="{DynamicResource Loc_Settings_Subtitle}" FontSize="12" Foreground="#9EA5B5" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button x:Name="SettingsDismissButton" Grid.Column="2" Content="&#xE8BB;" Style="{StaticResource SettingsIconButton}"
                                Click="CloseSettings_Click" VerticalAlignment="Top" ToolTip="{DynamicResource Loc_Settings_CloseTip}"
                                AutomationProperties.Name="Close settings"/>
                    </Grid>

                    <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="24,0,24,18" Focusable="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.08*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="240"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
