                    <ResourceDictionary.MergedDictionaries>
                        <ResourceDictionary Source="Views/Settings/SettingsTheme.xaml"/>
                    </ResourceDictionary.MergedDictionaries>
                </ResourceDictionary>
            </Grid.Resources>
            <Border x:Name="SettingsDialog" Width="806" MaxHeight="606" Margin="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#101118" CornerRadius="18" BorderBrush="#412432" BorderThickness="1"
                    Style="{StaticResource RefinedEntranceStyle}"
                    AutomationProperties.Name="Cortex FX settings">
                <Border.Effect><DropShadowEffect BlurRadius="44" ShadowDepth="12" Opacity="0.62" Color="Black"/></Border.Effect>
