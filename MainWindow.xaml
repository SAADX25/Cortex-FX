<Window x:Class="CortexFX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CortexFX"
        mc:Ignorable="d"
        Title="Cortex FX" Height="650" Width="800"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Icon="logo.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" ResizeBorderThickness="5" CornerRadius="10" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBackground" Color="#181818"/>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#252525"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentHover" Color="#009BE0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3E3E42"/>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="#666666"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Category Toggle Button Style -->
        <Style x:Key="CategoryToggleStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                        Grid.ColumnSpan="2"
                        CornerRadius="2"
                        Background="{StaticResource SecondaryBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1" />
                <Path x:Name="Arrow" 
                      Grid.Column="1" 
                      Fill="{StaticResource TextSecondary}"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z" />
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,3,23,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}" 
                                     Template="{x:Null}" 
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center" 
                                     Margin="3,3,23,3"
                                     Focusable="True" 
                                     Background="Transparent"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2D2D30"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource BorderColor}"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Border" 
                                            Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Style -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="4" BorderBrush="#3E3E42" BorderThickness="1" Margin="0,2">
                            <Grid Margin="10,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                    <ColumnDefinition Width="*"/>    <!-- Name -->
                                    <ColumnDefinition Width="Auto"/> <!-- Remove -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📄" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Grid.Column="1"/>
                                <Button Content="✕" Grid.Column="2" Click="RemoveFile_Click" Tag="{Binding FullPath}"
                                        Background="Transparent" Foreground="#FF5555" BorderThickness="0" Padding="8,0" Cursor="Hand"
                                        FontSize="14" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Border Background="#181818" CornerRadius="10" BorderBrush="#3E3E42" BorderThickness="1">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/> <!-- Custom Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Category Selector -->
                    <RowDefinition Height="*"/>    <!-- Main Content (Scrollable) -->
                    <RowDefinition Height="Auto"/> <!-- Footer (Fixed) -->
                </Grid.RowDefinitions>

                <!-- Custom Title Bar (Row 0) -->
                <Grid Grid.Row="0" Background="#1E1E1E">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <Image Source="logo.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Cortex FX" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⚙️" Background="Transparent" Foreground="#AAAAAA" FontSize="14" Click="SettingsButton_Click" Padding="10,0" Width="40" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="_" Click="MinimizeButton_Click" Background="Transparent" Foreground="White" FontSize="14" Padding="10,0" Width="40" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Click="CloseButton_Click" Background="Transparent" Foreground="White" FontSize="14" Padding="10,0" Width="40" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Category Selector (Row 1) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,15,20,15">
                    <RadioButton x:Name="RadioImage" Content="🖼️ Image" Style="{StaticResource CategoryToggleStyle}" GroupName="Category" IsChecked="True" Checked="Category_Checked"/>
                    <RadioButton x:Name="RadioVideo" Content="🎥 Video" Style="{StaticResource CategoryToggleStyle}" GroupName="Category" Checked="Category_Checked"/>
                    <RadioButton x:Name="RadioAudio" Content="🎵 Audio" Style="{StaticResource CategoryToggleStyle}" GroupName="Category" Checked="Category_Checked"/>
                </StackPanel>

                <!-- Scrollable Content (Row 2) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0,10,0" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- Drop Zone -->
                        <Border x:Name="DropZone" 
                                Height="150"
                                Background="#1E1E1E" 
                                BorderBrush="#444444" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                AllowDrop="True"
                                Drop="DropZone_Drop"
                                DragEnter="DropZone_DragEnter"
                                DragLeave="DropZone_DragLeave"
                                MouseLeftButtonUp="DropZone_Click"
                                Cursor="Hand"
                                Margin="0,0,0,20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="☁" FontSize="48" HorizontalAlignment="Center" Foreground="{StaticResource AccentColor}"/>
                                <TextBlock Text="Drag &amp; Drop Files Here" FontSize="18" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- File List Preview -->
                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Selected Files:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                            <ListBox x:Name="FilesList" Height="150" Background="#202020" BorderThickness="0" Foreground="#CCCCCC"/>
                        </Grid>

                        <!-- Output Path Selection -->
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Output Folder:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/>
                            <TextBox x:Name="OutputPathBox" Grid.Column="1" Height="30" VerticalContentAlignment="Center" Background="#252525" Foreground="#E0E0E0" BorderBrush="#3E3E42" BorderThickness="1" Padding="5,0"/>
                            <Button x:Name="BrowseButton" Grid.Column="2" Content="Browse..." Margin="10,0,0,0" Padding="10,5" Click="BrowseButton_Click" Background="#3E3E42"/>
                        </Grid>
                        <TextBlock x:Name="OutputWarningText" Text="⚠️ Please select an output folder" Foreground="#FF5555" FontSize="12" Margin="95,0,0,20" Visibility="Collapsed"/>

                        <!-- Quality Control -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Quality:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1">
                                <Slider x:Name="QualitySlider" Minimum="1" Maximum="3" Value="2" IsSnapToTickEnabled="True" TickFrequency="1"
                                        Foreground="{StaticResource AccentColor}" Background="#444444" AutoToolTipPlacement="None"/>
                                <Grid Margin="0,2,0,0">
                                    <TextBlock Text="Small Size" Foreground="#888888" FontSize="11" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Balanced" Foreground="#AAAAAA" FontSize="11" HorizontalAlignment="Center"/>
                                    <TextBlock Text="High Quality" Foreground="#E0E0E0" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Advanced Image Settings -->
                        <Expander Header="Advanced Settings ⚙️" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,20">
                            <Border Background="#252525" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Padding="10" CornerRadius="4">
                                <StackPanel>
                                    <!-- Resize -->
                                    <TextBlock Text="Resize:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBox x:Name="ResizeWidthBox" Width="60" Height="25" VerticalContentAlignment="Center" Background="#333333" Foreground="White" BorderThickness="0" Padding="5,0" Margin="0,0,5,0" PreviewTextInput="NumberValidationTextBox"/>
                                        <TextBlock Text="x" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBox x:Name="ResizeHeightBox" Width="60" Height="25" VerticalContentAlignment="Center" Background="#333333" Foreground="White" BorderThickness="0" Padding="5,0" Margin="0,0,10,0" PreviewTextInput="NumberValidationTextBox"/>
                                        <CheckBox x:Name="AspectRatioCheckBox" Content="Maintain Aspect Ratio" Foreground="{StaticResource TextSecondary}" IsChecked="True" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- DPI -->
                                    <TextBlock Text="DPI (Density):" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                                    <TextBox x:Name="DpiBox" Width="60" Height="25" HorizontalAlignment="Left" VerticalContentAlignment="Center" Background="#333333" Foreground="White" BorderThickness="0" Padding="5,0" Margin="0,0,0,10" PreviewTextInput="NumberValidationTextBox"/>

                                    <!-- Effects -->
                                    <TextBlock Text="Effects:" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="SharpenCheckBox" Content="Sharpen" Foreground="{StaticResource TextSecondary}" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="GrayscaleCheckBox" Content="Grayscale" Foreground="{StaticResource TextSecondary}" Margin="0,0,15,0"/>
                                        <CheckBox x:Name="AutoEnhanceCheckBox" Content="Auto-Enhance" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <!-- Fixed Footer (Row 3) -->
                <Border Grid.Row="3" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="20,15" CornerRadius="0,0,10,10">
                    <StackPanel>
                        <!-- Conversion Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                            <TextBlock Text="Convert to:" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" Margin="0,0,10,0"/>
                            <ComboBox x:Name="FormatComboBox" Width="120" SelectedIndex="0">
                                <!-- Items populated dynamically -->
                            </ComboBox>
                            <Button x:Name="ConvertButton" Content="Convert" Margin="20,0,0,0" Width="120" Click="ConvertButton_Click"/>
                        </StackPanel>

                        <!-- Progress -->
                        <StackPanel>
                            <Grid Margin="0,0,0,5">
                                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="VersionText" Text="v1.0.0" Foreground="#666666" HorizontalAlignment="Right" FontSize="10"/>
                            </Grid>
                            <ProgressBar x:Name="ConversionProgress" Height="10" Background="#333333" BorderThickness="0" Foreground="{StaticResource AccentColor}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Success Overlay -->
        <Grid x:Name="SuccessOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#252525" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" BorderBrush="{StaticResource AccentColor}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎉" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="All Tasks Finished!" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Great!" Click="CloseOverlay_Click" Width="150" Height="40" FontSize="16"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings Overlay -->
        <Grid x:Name="SettingsOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#252525" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Width="400">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                    
                    <CheckBox x:Name="ContextMenuCheckBox" Content="Add 'Convert with Cortex FX' to Context Menu" 
                              Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,20"
                              Checked="ContextMenuCheckBox_Checked" Unchecked="ContextMenuCheckBox_Unchecked">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <Button Content="Close" Click="CloseSettings_Click" Width="100" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>