                                    <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                        <GradientStop Color="#16141E" Offset="0"/>
                                        <GradientStop Color="#2D1422" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Viewbox Width="112" Height="112" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-6,0" IsHitTestVisible="False">
