                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TrimBorder" CornerRadius="10" Background="{StaticResource InputBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <TextBlock Text="{DynamicResource Loc_AudioChoice_Trim}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Loc_AudioChoice_TrimSub}" FontSize="11" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TrimBorder" Property="Background" Value="{StaticResource NavButtonHover}"/>
                                            <Setter TargetName="TrimBorder" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Option B: Convert Format -->
                        <Button Grid.Column="2" Click="ConvertChoice_Click" Height="140" Cursor="Hand" BorderThickness="0" Background="Transparent" Effect="{x:Null}">
