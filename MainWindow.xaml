<Window x:Class="CortexFX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CortexFX"
        xmlns:conv="clr-namespace:CortexFX.Converters"
        xmlns:ctrl="clr-namespace:CortexFX.Controls"
        xmlns:views="clr-namespace:CortexFX.Views.Video"
        xmlns:audio="clr-namespace:CortexFX.Views.Audio"
        xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
        mc:Ignorable="d"
        Title="Cortex FX" Height="650" Width="950"
        MinWidth="950" MinHeight="650" ResizeMode="CanResize"
        Background="#08090D" AllowsTransparency="False" WindowStyle="None"
        Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        Icon="Assets/logo.ico"
        Loaded="MainWindow_Loaded"
        StateChanged="MainWindow_StateChanged"
        >

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="5" CornerRadius="12" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:StringToBrushConverter x:Key="StringToBrushConverter"/>

        <!-- Obsidian & Crimson Flagship Palette -->
        <SolidColorBrush x:Key="PrimaryBackground" Color="#07080C"/>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#0D0E14"/>
        <SolidColorBrush x:Key="CardBackground" Color="#13141C"/>
        <SolidColorBrush x:Key="AccentColor" Color="#E11D2E"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF3348"/>
        <SolidColorBrush x:Key="AccentSecondary" Color="#FF5468"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#8A1E2D"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#34D399"/>
        <SolidColorBrush x:Key="DangerColor" Color="#FF4D5E"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AudioAccentColor" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AudioAccentHover" Color="#7DD3FC"/>
        <SolidColorBrush x:Key="AudioMarkerStart" Color="#22D3EE"/>
        <SolidColorBrush x:Key="AudioMarkerEnd" Color="#60A5FA"/>
        <SolidColorBrush x:Key="AudioSaveColor" Color="#075985"/>
        <SolidColorBrush x:Key="AudioSaveBorder" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AudioPanelBorder" Color="#1E3A5F"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A6AEBE"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6E7586"/>
        <SolidColorBrush x:Key="BorderColor" Color="#25212B"/>
        <SolidColorBrush x:Key="ActionButtonBackground" Color="#C8182A"/>
        <SolidColorBrush x:Key="ActionButtonHover" Color="#E11D2E"/>
        <SolidColorBrush x:Key="ActionButtonBorder" Color="#FF4A5C"/>
        <LinearGradientBrush x:Key="ActionButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#D61C2F" Offset="0"/>
            <GradientStop Color="#A81122" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ActionButtonHoverGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EF2338" Offset="0"/>
            <GradientStop Color="#BE1427" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ConvertButtonBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E11D2E" Offset="0"/>
            <GradientStop Color="#B81325" Offset="0.55"/>
            <GradientStop Color="#8F0E1D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ConvertButtonHoverBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF2940" Offset="0"/>
            <GradientStop Color="#D1162B" Offset="0.55"/>
            <GradientStop Color="#A61022" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ConvertButtonPressedBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B41323" Offset="0"/>
            <GradientStop Color="#8B0E1D" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ConvertButtonDisabledBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#15141C" Offset="0"/>
            <GradientStop Color="#111017" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBackground" Color="#0A0B10"/>
        <SolidColorBrush x:Key="PanelBackgroundSubtle" Color="#12131A"/>
        <LinearGradientBrush x:Key="LuxuryCardBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#15161F" Offset="0"/>
            <GradientStop Color="#0F1017" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="InputBackground" Color="#090A0F"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#24212C"/>
        <SolidColorBrush x:Key="PanelBorderStrong" Color="#4D2634"/>
        <SolidColorBrush x:Key="CrimsonMedallionBg" Color="#1E1017"/>
        <SolidColorBrush x:Key="CrimsonMedallionBorder" Color="#441E2B"/>
        <SolidColorBrush x:Key="NavButtonBackground" Color="#13141B"/>
        <SolidColorBrush x:Key="NavButtonHover" Color="#1D161E"/>
        <SolidColorBrush x:Key="NavButtonChecked" Color="#28141C"/>
        <LinearGradientBrush x:Key="WindowBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D0C12" Offset="0"/>
            <GradientStop Color="#07080C" Offset="0.56"/>
            <GradientStop Color="#17090F" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CrimsonProgressBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#961224" Offset="0"/>
            <GradientStop Color="#E11D2E" Offset="0.6"/>
            <GradientStop Color="#FF4D5E" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AudioEditorPanelGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0F16" Offset="0"/>
            <GradientStop Color="#07111B" Offset="0.55"/>
            <GradientStop Color="#0B1117" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AudioWaveformBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#050A10" Offset="0"/>
            <GradientStop Color="#061525" Offset="0.52"/>
            <GradientStop Color="#04111F" Offset="1"/>
        </LinearGradientBrush>

        <!-- Global Effects -->
        <DropShadowEffect x:Key="ElevationShadow" BlurRadius="14" ShadowDepth="3" Opacity="0.28" Color="Black"/>
        <DropShadowEffect x:Key="GlowShadow" BlurRadius="16" ShadowDepth="0" Opacity="0.38" Color="Black"/>
        <DropShadowEffect x:Key="CrimsonSoftGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.32" Color="#E11D2E"/>

        <!-- Luxury Card Hover Container Style (GPU Opacity Border Glow, Zero Frozen-Brush Risk) -->
        <Style x:Key="LuxuryCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LuxuryCardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect" Value="{StaticResource ElevationShadow}"/>
        </Style>

        <!-- Button Style (Modern Ruby-Crimson Pill with Smooth Hover & Press Scale) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ActionButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ActionButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RefinedFocusVisualStyle}"/>
            <Setter Property="Effect" Value="{StaticResource ElevationShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="BtnRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="ActionSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Border>
                            <!-- Subtle top specular rim -->
                            <Border CornerRadius="8" BorderThickness="0,1,0,0" BorderBrush="#26FFFFFF" IsHitTestVisible="False"/>
                            <Border x:Name="ActionHighlight" Background="White" Opacity="0" CornerRadius="8" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActionHighlight" Storyboard.TargetProperty="Opacity" To="0.09" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActionHighlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="BtnScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionSurface" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="ActionHighlight" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ActionButtonHoverGradient}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#17161F"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                    <Setter Property="Effect" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AudioToolButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0A151D"/>
            <Setter Property="Foreground" Value="{StaticResource AudioAccentColor}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AudioAccentColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RefinedFocusVisualStyle}"/>
            <Setter Property="Effect" Value="{StaticResource ElevationShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow"
                                    Background="{TemplateBinding BorderBrush}"
                                    CornerRadius="10"
                                    Margin="-2"
                                    Opacity="0">
                                <Border.Effect>
                                    <BlurEffect Radius="12"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="ButtonChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.32"/>
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.18"/>
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Glow" Property="Opacity" Value="0"/>
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.55"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified Obsidian-Crimson Segmented Category Nav Pills (Animated) -->
        <Style x:Key="PremiumNavBaseStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#9BA3B5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RefinedFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="NavRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="NavScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>

                            <!-- Soft Crimson Ambient Bloom (Active Only) -->
                            <Border x:Name="ActiveGlow" CornerRadius="10" Margin="-1" Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E11D2E" Offset="0"/>
                                        <GradientStop Color="#991124" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <BlurEffect Radius="13"/>
                                </Border.Effect>
                            </Border>

                            <!-- Hover Obsidian-Ruby Plate -->
                            <Border x:Name="HoverPlate" CornerRadius="10" Background="#1B1823"
                                    BorderBrush="#422430" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>

                            <!-- Active Ruby-Crimson Pill -->
                            <Border x:Name="ActivePlate" CornerRadius="10" BorderBrush="#FF5C70" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#DC1D34" Offset="0"/>
                                        <GradientStop Color="#9D1123" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <!-- Top Specular Line on Active Pill -->
                            <Border x:Name="ActiveSheen" CornerRadius="10" BorderThickness="0,1,0,0"
                                    BorderBrush="#40FFFFFF" Opacity="0" IsHitTestVisible="False"/>

                            <!-- Content -->
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1.025" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1.025" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverPlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActivePlate" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ActiveSheen" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ActivePlate" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveSheen" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="ActiveGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Preserve All 6 Category Style Keys Under Unified Obsidian-Crimson Brand -->
        <Style x:Key="ImageNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}"/>
        <Style x:Key="VideoNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}"/>
        <Style x:Key="AudioNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}"/>
        <Style x:Key="DocumentNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}"/>
        <Style x:Key="ArchiveNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}"/>
        <Style x:Key="EbookNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Custom Flagship Crimson Precision Slider -->
        <Style x:Key="CrimsonSliderStyle" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RefinedFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <!-- Recessed Obsidian Trough -->
                            <Border Height="6" CornerRadius="3" Background="#0A0B10" BorderBrush="#262330" BorderThickness="1" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3,0,0,3" Background="{StaticResource CrimsonProgressBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Cursor="Hand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="18" Height="18" Cursor="Hand" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>
                                                    <Ellipse x:Name="ThumbHalo" Width="18" Height="18" Fill="#E11D2E" Opacity="0.22">
                                                        <Ellipse.Effect>
                                                            <BlurEffect Radius="8"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <Ellipse x:Name="ThumbOuter" Width="16" Height="16" Fill="#F8FAFC" Stroke="#E11D2E" StrokeThickness="2.5"/>
                                                    <Ellipse Width="5" Height="5" Fill="#E11D2E"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="0:0:0.15">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbHalo" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbHalo" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.16"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.26" Duration="0:0:0.10"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.26" Duration="0:0:0.10"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbHalo" Storyboard.TargetProperty="Opacity" To="0.72" Duration="0:0:0.10"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ThumbHalo" Storyboard.TargetProperty="Opacity" To="0.22" Duration="0:0:0.15"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style (Animated Chevron Rotation & Crimson Focus Ring) -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="8"
                        Background="{StaticResource InputBackground}"
                        BorderBrush="{StaticResource PanelBorder}"
                        BorderThickness="1" />
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      Fill="{StaticResource TextSecondary}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      RenderTransformOrigin="0.5,0.5"
                      Data="M0,0 L0,1.6 L4.2,5.8 L8.4,1.6 L8.4,0 L4.2,4.2 z">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="ArrowRotate" Angle="0"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentSecondary}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RefinedFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot">
                            <ToggleButton Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Grid.Column="2"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,3,28,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center"
                                     Margin="3,3,25,3"
                                     Focusable="True"
                                     Background="Transparent" Foreground="{TemplateBinding Foreground}" CaretBrush="{StaticResource AccentColor}"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#14151E"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource PanelBorderStrong}"
                                            CornerRadius="9"
                                            Effect="{StaticResource ElevationShadow}"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                            <Border x:Name="ComboFocusOutline" CornerRadius="8" BorderBrush="{StaticResource AccentColor}"
                                    BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ComboFocusOutline" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ComboFocusOutline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFocusOutline" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboFocusOutline" Property="Opacity" Value="1"/></Trigger>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboRoot" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Border"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Margin="2,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#25171F"/>
                                        </Trigger>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#25171F"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource ActionButtonBackground}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentColor}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="InputBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <Border x:Name="InputGlowBorder" CornerRadius="8" BorderBrush="{StaticResource AccentColor}"
                                    BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{StaticResource PanelBorderStrong}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InputGlowBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="InputGlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RefinedFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBorder"
                                    Width="17" Height="17"
                                    Background="{StaticResource InputBackground}"
                                    BorderBrush="{StaticResource PanelBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Path x:Name="CheckMark"
                                      Data="M3.2,8.4 L6.6,11.8 L13.4,4.5"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentColor}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.12"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1.0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY">
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="1.12"/>
                                                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1.0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#0A0B11"/>
            <Setter Property="Foreground" Value="{StaticResource CrimsonProgressBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border x:Name="PART_Track"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#23202B"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Indicator"
                                  HorizontalAlignment="Left"
                                  ClipToBounds="True">
                                <Border Background="{TemplateBinding Foreground}"
                                        CornerRadius="3.5"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Style (Animated File Item Entrance & Sleek Obsidian Cards) -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#161721" CornerRadius="10" BorderBrush="#262430" BorderThickness="1" Margin="0,0,0,8">
                            <Grid Margin="10,8" MinHeight="50" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="48" Height="48" CornerRadius="9" Background="{Binding FileBadgeColor, Converter={StaticResource StringToBrushConverter}}" ClipToBounds="True" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Path Data="M13,7 H30 L38,15 V41 H13 Z M30,7 V15 H38"
                                                  Stroke="#D9FFFFFF" StrokeThickness="1.5" Fill="#1FFFFFFF"/>
                                            <TextBlock Text="{Binding FileBadgeText}" Foreground="White" FontWeight="Bold"
                                                       FontSize="10" TextAlignment="Center" HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                                        </Grid>
                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailPath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="0" Margin="0,0,6,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding FileName}" ToolTip="{Binding FileName}" Foreground="{StaticResource TextPrimary}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <Grid Grid.Row="1" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding FileDetails}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,62,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Grid>

                                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Grid.Column="2" Click="RemoveFile_Click" Tag="{Binding FullPath}"
                                        ToolTip="Remove file" AutomationProperties.Name="Remove selected file"
                                        Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" BorderBrush="Transparent"
                                        Effect="{x:Null}" Padding="0" Cursor="Hand" FontSize="11" Width="28" Height="28"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="RemoveBg" CornerRadius="14" Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RemoveBg" Property="Background" Value="#2D141C"/>
                                                    <Setter Property="Foreground" Value="#FF5C6E"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="RemoveBg" Property="Background" Value="#481926"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid x:Name="ItemRoot">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="ItemSlide" Y="0"/>
                                        </Grid.RenderTransform>
                                        <ContentPresenter HorizontalAlignment="Stretch"/>
                                        <Border x:Name="FileRowOutline" BorderBrush="#6E2839" BorderThickness="1"
                                                CornerRadius="10" Margin="0,0,0,8" Opacity="0" IsHitTestVisible="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ItemSlide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="FileRowOutline" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="FileRowOutline" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="FileRowOutline" Property="Opacity" Value="1"/></Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FileRowOutline" Property="BorderBrush" Value="{StaticResource AccentSecondary}"/><Setter TargetName="FileRowOutline" Property="Opacity" Value="1"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Caption controls stay refined until hovered or keyboard focused, with smooth transitions. -->
        <Style x:Key="RefinedCaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderBrush" Value="#1BFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource RefinedFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="2" Background="Transparent">
                            <Border x:Name="CaptionHighlight" Background="{TemplateBinding BorderBrush}" CornerRadius="6" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CaptionHighlight" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CaptionHighlight" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="CaptionHighlight" Property="Opacity" Value="0.6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RefinedCloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource RefinedCaptionButtonStyle}">
            <Setter Property="BorderBrush" Value="#D62336"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Border x:Name="MainWindowBorder" Background="{StaticResource WindowBackgroundGradient}" CornerRadius="12" BorderBrush="#2D1D25" BorderThickness="1">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/> <!-- Custom Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Category Selector -->
                    <RowDefinition Height="*"/>    <!-- Main Content (Scrollable) -->
                    <RowDefinition Height="Auto"/> <!-- Footer (Fixed) -->
                </Grid.RowDefinitions>

                <!-- Custom Title Bar (Row 0) -->
                <Grid Grid.Row="0" Background="#08090E">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="Assets/logo.ico" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Cortex FX" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Sleek Version Capsule Pill -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#170C12" BorderBrush="#3E1B27" BorderThickness="1"
                            CornerRadius="10" Padding="10,2.5" IsHitTestVisible="False">
                        <TextBlock x:Name="VersionText" Text="v1.9.5" Foreground="#FF4D60"
                                   FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock x:Name="CurrentToolTitle" Visibility="Collapsed"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Content="&#xE713;" FontSize="14" Style="{StaticResource RefinedCaptionButtonStyle}" Click="SettingsButton_Click"
                                ToolTip="{DynamicResource Loc_Tip_Settings}" AutomationProperties.Name="Settings" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="&#xE921;" Style="{StaticResource RefinedCaptionButtonStyle}" Click="MinimizeButton_Click"
                                ToolTip="{DynamicResource Loc_Tip_Minimize}" AutomationProperties.Name="Minimize window" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource RefinedCaptionButtonStyle}" Click="MaximizeButton_Click"
                                ToolTip="{DynamicResource Loc_Tip_Maximize}" AutomationProperties.Name="Maximize window" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource RefinedCloseCaptionButtonStyle}" Click="CloseButton_Click"
                                ToolTip="{DynamicResource Loc_Tip_HideToTray}" AutomationProperties.Name="Hide Cortex FX to tray" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>

                    <!-- Subtle Crimson-Tinted Bottom Hairline -->
                    <Border Height="1" VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#18FFFFFF" Offset="0"/>
                                <GradientStop Color="#55E11D2E" Offset="0.5"/>
                                <GradientStop Color="#18FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- Category Selector (Row 1) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Obsidian Glass Segmented Navigation Dock -->
                    <Border Grid.Column="0" HorizontalAlignment="Left" Margin="12,10,12,10"
                            Background="#0C0D13" BorderBrush="#231F2B" BorderThickness="1"
                            CornerRadius="14" Padding="5"
                            Visibility="{Binding Visibility, ElementName=TopNavPanel}">
                        <StackPanel x:Name="TopNavPanel" Orientation="Horizontal" Visibility="Collapsed">
                            <RadioButton x:Name="RadioImage" Style="{StaticResource ImageNavStyle}" GroupName="Category" Click="Category_Click" Tag="Image">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Loc_Nav_Image}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioVideo" Style="{StaticResource VideoNavStyle}" GroupName="Category" Click="Category_Click" Tag="Video">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Loc_Nav_Video}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioAudio" Style="{StaticResource AudioNavStyle}" GroupName="Category" Click="Category_Click" Tag="Audio">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Loc_Nav_Audio}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioDocument" Style="{StaticResource DocumentNavStyle}" GroupName="Category" Click="Category_Click" Tag="Document">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Loc_Nav_Document}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioArchive" Style="{StaticResource ArchiveNavStyle}" GroupName="Category" Click="Category_Click" Tag="Archive">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Loc_Nav_Archive}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="RadioEbook" Style="{StaticResource EbookNavStyle}" GroupName="Category" Click="Category_Click" Tag="Ebook">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Loc_Nav_Ebook}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Sleek Animated Back Pill -->
                    <Button x:Name="BackBtn" Grid.Column="1" Click="BackToHome_Click"
                            Width="98" Height="36" Margin="12,10,12,10"
                            Background="#160E13" Foreground="#FF5C6E"
                            BorderBrush="#49222E" BorderThickness="1"
                            Visibility="Collapsed" ToolTip="{DynamicResource Loc_Tip_BackToHome}"
                            Cursor="Hand" Effect="{x:Null}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid x:Name="BackRoot" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform x:Name="BackScale" ScaleX="1" ScaleY="1"/>
                                    </Grid.RenderTransform>
                                    <Border x:Name="BackBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10"/>
                                    <Border x:Name="BackHoverOverlay" CornerRadius="10"
                                            Background="#26121A" BorderBrush="#E11D2E" BorderThickness="1"
                                            Opacity="0" IsHitTestVisible="False"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="BackArrow" Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12.5"
                                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"
                                                   Margin="0,0,7,0">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="BackArrowSlide" X="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <TextBlock Text="{DynamicResource Loc_Btn_Back}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BackHoverOverlay" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                                    <DoubleAnimation Storyboard.TargetName="BackArrowSlide" Storyboard.TargetProperty="X" To="-3" Duration="0:0:0.16">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BackHoverOverlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetName="BackArrowSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BackScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08"/>
                                                    <DoubleAnimation Storyboard.TargetName="BackScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="BackScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                                    <DoubleAnimation Storyboard.TargetName="BackScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="BackRoot" Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Scrollable Content (Row 2) -->
                <Grid Grid.Row="2" Margin="12,0,12,12">
                    <!-- Dashboard View -->
                    <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,0">
                        <StackPanel Width="820" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Grid Margin="7,0,7,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="4" Height="22" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#FF3348" Offset="0"/>
                                                <GradientStop Color="#A81122" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Loc_Dash_Title}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                        <TextBlock Text="{DynamicResource Loc_Dash_Subtitle}" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <UniformGrid x:Name="PopularToolsPanel" Columns="5" HorizontalAlignment="Center">
                                <!-- PDF to Word -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_PdfToWord}"
                                               IconBackground="#2B579A" Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="PDF_DOCX" ToolTip="{DynamicResource Loc_Tool_PdfToWord_Tip}">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M16,11V13H13V15H16V17H13V19H11V11H16Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- Word to PDF -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_WordToPdf}"
                                               IconBackground="#2B579A" Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="DOCX_PDF" ToolTip="{DynamicResource Loc_Tool_WordToPdf_Tip}">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M15,16H13V19H11V16H9V14H11V11H13V14H15V16Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- PDF to PowerPoint -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_PdfToPpt}"
                                               IconBackground="#D24726" Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="PDF_PPTX" ToolTip="{DynamicResource Loc_Tool_PdfToPpt_Tip}">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M16,13H13V19H11V13H8V11H16V13Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- PowerPoint to PDF -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_PptToPdf}"
                                               IconBackground="#D24726" Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="PPTX_PDF" ToolTip="{DynamicResource Loc_Tool_PptToPdf_Tip}">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M16,15H13V19H11V15H9V13H11V10H13V13H16V15Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- Excel to PDF -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_ExcelToPdf}"
                                               IconBackground="#217346" Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="XLSX_PDF" ToolTip="{DynamicResource Loc_Tool_ExcelToPdf_Tip}">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M16,17H8V15H16V17M16,13H8V11H16V13M16,9H8V7H16V9Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- PDF to Image -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_PdfToImage}"
                                               IconBackground="#FBC02D" IconForeground="#3B2C08" Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="PDF_JPG" ToolTip="{DynamicResource Loc_Tool_PdfToImage_Tip}">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M11,15L13,18L16,14L20,19H4L8,13L11,15Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- Video Compressor -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_VideoCompressor}"
                                               Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="VIDEO_COMPRESSOR" ToolTip="{DynamicResource Loc_Tool_VideoCompressor_Tip}">
                                    <ctrl:ToolCard.IconBackground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0F766E" Offset="0"/>
                                            <GradientStop Color="#2DD4BF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ctrl:ToolCard.IconBackground>
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M17.25,12L10,17.94V6.06L17.25,12M21.5,4L17.5,4L17.5,2L6.5,2L6.5,4L2.5,4L2.5,6L6.5,6L6.5,8L2.5,8L2.5,10L6.5,10L6.5,20L2.5,20L2.5,22L21.5,22L21.5,20L17.5,20L17.5,10L21.5,10L21.5,8L17.5,8L17.5,6L21.5,6L21.5,4Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- Video Cutter (Featured Flagship Studio + BETA Badge) -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_VideoCutter}"
                                               BadgeText="BETA" IsFeatured="True"
                                               Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="VIDEO_CUTTER" ToolTip="{DynamicResource Loc_Tool_VideoCutter_Tip}">
                                    <ctrl:ToolCard.IconBackground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF2E47" Offset="0"/>
                                            <GradientStop Color="#CE162C" Offset="0.55"/>
                                            <GradientStop Color="#8A0D1E" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ctrl:ToolCard.IconBackground>
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M4,3 H8.2 L6.4,6.8 H2 V5 A2,2 0 0,1 4,3 Z M10.4,3 H15.0 L13.2,6.8 H8.6 Z M17.2,3 H20 A2,2 0 0,1 22,5 V6.8 H15.4 Z M2,8.4 H22 V19 A2,2 0 0,1 20,21 H4 A2,2 0 0,1 2,19 Z M9.6,11.4 L16.2,14.7 L9.6,18.0 Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- Audio Cutter -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_AudioCutter}"
                                               Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="AUDIO_CUTTER" ToolTip="{DynamicResource Loc_Tool_AudioCutter_Tip}">
                                    <ctrl:ToolCard.IconBackground>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0369A1" Offset="0"/>
                                            <GradientStop Color="#38BDF8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </ctrl:ToolCard.IconBackground>
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M12,3V13.55C11.41,13.21 10.73,13 10,13A3,3 0 0,0 7,16A3,3 0 0,0 10,19A3,3 0 0,0 13,16V7H17V3H12Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_AudioSeparator}" IconBackground="#7660CB"
                                               Margin="7,7,7,9" MouseLeftButtonUp="AudioSeparatorCard_Click" ToolTip="{DynamicResource Loc_Tool_AudioSeparator_Tip}">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M4,8H6V16H4Z M9,3H11V21H9Z M14,6H16V18H14Z M19,10H21V14H19Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>
                                <!-- More Tools (+) -->
                                <ctrl:ToolCard Title="{DynamicResource Loc_Tool_MoreTools}"
                                               IconBackground="#27272A" Margin="7,7,7,9" MouseLeftButtonUp="ToolCard_MouseLeftButtonUp" Tag="MORE_TOOLS" ToolTip="{DynamicResource Loc_Tool_MoreTools_Tip}">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Conversion View (Hidden by default) -->
                    <Grid x:Name="ConversionView" Margin="0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Drop zone and selected files -->
                            <Border x:Name="ConversionColLeft" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0">
                                <Border.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <Border x:Name="DropZone"
                                            Style="{StaticResource LuxuryCardBorderStyle}"
                                            Padding="14"
                                            AllowDrop="True"
                                            Drop="DropZone_Drop"
                                            DragEnter="DropZone_DragEnter"
                                            DragLeave="DropZone_DragLeave">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Header Row -->
                                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource CrimsonMedallionBg}"
                                                            BorderBrush="{StaticResource CrimsonMedallionBorder}" BorderThickness="1" Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                   Foreground="{StaticResource AccentSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{DynamicResource Loc_Conv_SelectedFiles}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Background="{StaticResource CrimsonMedallionBg}" BorderBrush="{StaticResource CrimsonMedallionBorder}"
                                                        BorderThickness="1" CornerRadius="10" Padding="9,2">
                                                    <TextBlock x:Name="SelectedFilesCountText" Text="0" Foreground="#FF5C6E" FontSize="11.5" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <!-- Recessed Dashed Drop Cavity + File List -->
                                            <Grid Grid.Row="1">
                                                <Border Background="#0A0B10" CornerRadius="10"/>
                                                <Rectangle x:Name="DropZoneDashedRect" RadiusX="10" RadiusY="10"
                                                           Stroke="#2C2532" StrokeThickness="1.2" StrokeDashArray="5,4"
                                                           IsHitTestVisible="False"/>

                                                <ListBox x:Name="FilesList" VerticalAlignment="Stretch"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" Padding="8,8,8,0"/>

                                                <!-- Flagship Empty State -->
                                                <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="230">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasItems, ElementName=FilesList}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>

                                                    <Border x:Name="DropZoneIconBadge" Width="64" Height="64" CornerRadius="32"
                                                            HorizontalAlignment="Center" BorderBrush="#592232" BorderThickness="1.2"
                                                            RenderTransformOrigin="0.5,0.5">
                                                        <Border.Background>
                                                            <RadialGradientBrush>
                                                                <GradientStop Color="#2B121B" Offset="0"/>
                                                                <GradientStop Color="#140A0F" Offset="1"/>
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#E11D2E" BlurRadius="22" ShadowDepth="0" Opacity="0.28"/>
                                                        </Border.Effect>
                                                        <Border.RenderTransform>
                                                            <TransformGroup>
                                                                <ScaleTransform x:Name="DropZoneIconScale" ScaleX="1" ScaleY="1"/>
                                                                <TranslateTransform x:Name="DropZoneIconTranslate" Y="0"/>
                                                            </TransformGroup>
                                                        </Border.RenderTransform>
                                                        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                                                   Foreground="#FF4D60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Text="{DynamicResource Loc_Conv_DropTitle}" Foreground="{StaticResource TextPrimary}"
                                                               FontSize="13.5" FontWeight="SemiBold" TextAlignment="Center" Margin="0,14,0,0"/>
                                                    <TextBlock Text="{DynamicResource Loc_Conv_DropSubtitle}"
                                                               Foreground="{StaticResource TextMuted}" FontSize="11.5" TextAlignment="Center"
                                                               TextWrapping="Wrap" Margin="0,5,0,0"/>

                                                    <Border HorizontalAlignment="Center" Margin="0,12,0,0"
                                                            Background="#141118" BorderBrush="#29212D" BorderThickness="1"
                                                            CornerRadius="10" Padding="10,3">
                                                        <TextBlock Text="{DynamicResource Loc_Conv_DropBadge}" FontSize="10.5" Foreground="#989EAE"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Tactile Dark-Crimson Glass Add Files CTA -->
                                            <Border Grid.Row="2" Height="40" CornerRadius="9" Margin="0,12,0,0" Cursor="Hand"
                                                    MouseLeftButtonUp="DropZone_Click" RenderTransformOrigin="0.5,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="AddMoreScale" ScaleX="1" ScaleY="1"/>
                                                </Border.RenderTransform>
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#1B1016" Offset="0"/>
                                                        <GradientStop Color="#120C11" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#542331"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="BorderBrush" Value="#E11D2E"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Border x:Name="AddMoreHoverGlow" CornerRadius="8" Background="#2B121B" Opacity="0" IsHitTestVisible="False"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                        <Border Width="20" Height="20" CornerRadius="10" Background="#2E131D" BorderBrush="#6B2436" BorderThickness="1" Margin="0,0,9,0">
                                                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Foreground="#FF5468" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{DynamicResource Loc_Conv_AddMore}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="MouseEnter">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="AddMoreHoverGlow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                    <EventTrigger RoutedEvent="MouseLeave">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="AddMoreHoverGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Drag-Over Animated Crimson Glow Frame -->
                                    <Border x:Name="DropZoneHoverBorder" CornerRadius="12" BorderBrush="#FF3348" BorderThickness="1.5"
                                            Background="#12E11D2E" Opacity="0" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>

                            <!-- Middle Column: Output and Conversion Options -->
                            <ScrollViewer x:Name="ConversionColMid" Grid.Column="1" Margin="0,0,10,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ScrollViewer.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </ScrollViewer.RenderTransform>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Output Card -->
                                    <Border Grid.Row="0" Style="{StaticResource LuxuryCardBorderStyle}" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource CrimsonMedallionBg}"
                                                        BorderBrush="{StaticResource CrimsonMedallionBorder}" BorderThickness="1" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{StaticResource AccentSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Loc_Conv_Output}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{DynamicResource Loc_Conv_OutputFolder}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="OutputPathBox" AutomationProperties.Name="Output folder" Grid.Column="0" Height="36" VerticalContentAlignment="Center"
                                                         FlowDirection="LeftToRight"
                                                         Background="{StaticResource InputBackground}" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                                         Padding="10,0" Margin="0,0,8,0" TextChanged="OutputPathBox_TextChanged"
                                                         ToolTip="{DynamicResource Loc_Conv_OutputFolderTip}"/>
                                                <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click" Height="36" Padding="14,0"
                                                        BorderBrush="#FF4D5E" BorderThickness="1"
                                                        ToolTip="{DynamicResource Loc_Conv_BrowseTip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Loc_Conv_Browse}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="7,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock x:Name="OutputWarningText" Text="{DynamicResource Loc_Conv_SelectOutputWarning}" Foreground="{StaticResource DangerColor}" FontSize="11"
                                                           VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="2,0,0,-17" Visibility="Collapsed"/>
                                            </Grid>
                                            <CheckBox x:Name="chkCreateSubfolder" Content="{DynamicResource Loc_Conv_SaveSubfolder}" Foreground="{StaticResource TextSecondary}"
                                                      IsChecked="True" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Format and Quality Card -->
                                    <Border Grid.Row="1" Style="{StaticResource LuxuryCardBorderStyle}" Padding="14" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource CrimsonMedallionBg}"
                                                        BorderBrush="{StaticResource CrimsonMedallionBorder}" BorderThickness="1" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE771;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{StaticResource AccentSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Loc_Conv_FormatQuality}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <TextBlock Text="{DynamicResource Loc_Conv_OutputFormat}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="FormatComboBox" AutomationProperties.Name="Output format" Height="36" SelectedIndex="0" SelectionChanged="FormatComboBox_SelectionChanged" Margin="0,0,0,15"/>

                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="{DynamicResource Loc_Conv_Quality}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                <Border HorizontalAlignment="Right" Background="{StaticResource CrimsonMedallionBg}"
                                                        BorderBrush="{StaticResource CrimsonMedallionBorder}" BorderThickness="1"
                                                        CornerRadius="7" Padding="8,2">
                                                    <TextBlock x:Name="QualityValueText" Text="75%" Foreground="#FF5C6E" FontSize="11.5" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>

                                            <Slider x:Name="QualitySlider" Style="{StaticResource CrimsonSliderStyle}"
                                                    AutomationProperties.Name="Output quality" Minimum="0" Maximum="100" Value="75"
                                                    AutoToolTipPlacement="TopLeft" IsSnapToTickEnabled="True" TickFrequency="5"
                                                    ValueChanged="QualitySlider_ValueChanged"/>
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{DynamicResource Loc_Conv_Small}" FontSize="10.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{DynamicResource Loc_Conv_Balanced}" FontSize="10.5" Foreground="#C4B5BF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{DynamicResource Loc_Conv_Best}" FontSize="10.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- GIF Size Optimization Card (Format & Units Stay English) -->
                                    <Border Grid.Row="2" x:Name="GifOptionsCard" Visibility="Collapsed" Style="{StaticResource LuxuryCardBorderStyle}" Padding="14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,11">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource CrimsonMedallionBg}"
                                                            BorderBrush="{StaticResource CrimsonMedallionBorder}" BorderThickness="1" Margin="0,0,10,0">
                                                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                   Foreground="{StaticResource AccentSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{DynamicResource Loc_Conv_GifOpt}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Background="{StaticResource CrimsonMedallionBg}" BorderBrush="{StaticResource CrimsonMedallionBorder}"
                                                        BorderThickness="1" CornerRadius="7" Padding="7,2">
                                                    <TextBlock x:Name="GifProfileSummaryText" Text="480px · 12 fps · 128c" Foreground="#FF5C6E"
                                                               FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <Grid Margin="0,0,0,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="8"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Conv_GifMaxSize}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="GifMaxSizeCombo" AutomationProperties.Name="GIF max file size" Height="32" SelectionChanged="GifOption_Changed">
                                                        <ComboBoxItem Content="{DynamicResource Loc_Conv_GifAutoNoCap}" Tag="" IsSelected="True"/>
                                                        <ComboBoxItem Content="2 MB" Tag="2"/>
                                                        <ComboBoxItem Content="5 MB (WhatsApp)" Tag="5"/>
                                                        <ComboBoxItem Content="8 MB (Discord)" Tag="8"/>
                                                        <ComboBoxItem Content="10 MB" Tag="10"/>
                                                        <ComboBoxItem Content="15 MB" Tag="15"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Row="0" Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Conv_GifResolution}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="GifResolutionCombo" AutomationProperties.Name="GIF max dimension" Height="32" SelectionChanged="GifOption_Changed">
                                                        <ComboBoxItem Content="{DynamicResource Loc_Conv_GifAutoQuality}" Tag="" IsSelected="True"/>
                                                        <ComboBoxItem Content="320px" Tag="320"/>
                                                        <ComboBoxItem Content="400px" Tag="400"/>
                                                        <ComboBoxItem Content="480px" Tag="480"/>
                                                        <ComboBoxItem Content="600px (HD)" Tag="600"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Conv_GifFps}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="GifFpsCombo" AutomationProperties.Name="GIF frame rate" Height="32" SelectionChanged="GifOption_Changed">
                                                        <ComboBoxItem Content="{DynamicResource Loc_Conv_GifAutoQuality}" Tag="" IsSelected="True"/>
                                                        <ComboBoxItem Content="8 fps" Tag="8"/>
                                                        <ComboBoxItem Content="10 fps" Tag="10"/>
                                                        <ComboBoxItem Content="12 fps" Tag="12"/>
                                                        <ComboBoxItem Content="15 fps" Tag="15"/>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Row="2" Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Conv_GifColors}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
                                                    <ComboBox x:Name="GifColorsCombo" AutomationProperties.Name="GIF color palette" Height="32" SelectionChanged="GifOption_Changed">
                                                        <ComboBoxItem Content="{DynamicResource Loc_Conv_GifAutoQuality}" Tag="" IsSelected="True"/>
                                                        <ComboBoxItem Content="64" Tag="64"/>
                                                        <ComboBoxItem Content="96" Tag="96"/>
                                                        <ComboBoxItem Content="128" Tag="128"/>
                                                        <ComboBoxItem Content="256" Tag="256"/>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="GifExtraCompressionCheck" Content="{DynamicResource Loc_Conv_GifSmartComp}"
                                                      Foreground="{StaticResource TextSecondary}" FontSize="11.5" IsChecked="True"
                                                      Checked="GifOption_Changed" Unchecked="GifOption_Changed"
                                                      ToolTip="{DynamicResource Loc_Conv_GifSmartCompTip}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Resize and Advanced Card -->
                                    <Border Grid.Row="2" x:Name="ImageOptionsCard" Visibility="Collapsed" Style="{StaticResource LuxuryCardBorderStyle}" Padding="14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,13">
                                                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource CrimsonMedallionBg}"
                                                        BorderBrush="{StaticResource CrimsonMedallionBorder}" BorderThickness="1" Margin="0,0,10,0">
                                                    <TextBlock Text="&#xE7A8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               Foreground="{StaticResource AccentSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{DynamicResource Loc_Conv_ResizeAdv}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <CheckBox x:Name="AspectRatioCheckBox" Content="{DynamicResource Loc_Conv_KeepRatio}" Foreground="{StaticResource TextSecondary}" IsChecked="True" Margin="0,0,0,13"/>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{DynamicResource Loc_Conv_Width}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="ResizeWidthBox" AutomationProperties.Name="Resize width in pixels" Height="34" VerticalContentAlignment="Center" Background="{StaticResource InputBackground}" Foreground="White"
                                                             BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="10,0" PreviewTextInput="NumberValidationTextBox"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="10,0,10,9"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource Loc_Conv_Height}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="ResizeHeightBox" AutomationProperties.Name="Resize height in pixels" Height="34" VerticalContentAlignment="Center" Background="{StaticResource InputBackground}" Foreground="White"
                                                             BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="10,0" PreviewTextInput="NumberValidationTextBox"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="chkMergePdf" Content="{DynamicResource Loc_Conv_MergePdf}" Foreground="{StaticResource TextSecondary}" Margin="0,13,0,0"/>

                                            <!-- Extra hidden but required fields to avoid build errors -->
                                            <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                                                <TextBox x:Name="DpiBox" Text="300"/>
                                                <CheckBox x:Name="SharpenCheckBox"/>
                                                <CheckBox x:Name="GrayscaleCheckBox"/>
                                                <CheckBox x:Name="AutoEnhanceCheckBox"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <!-- Right Column: Summary -> Open Output Folder -> Flagship CONVERT CTA -->
                            <Grid x:Name="ConversionColRight" Grid.Column="2">
                                <Grid.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </Grid.RenderTransform>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Conversion Summary Card -->
                                <Border Grid.Row="0" Style="{StaticResource LuxuryCardBorderStyle}" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource CrimsonMedallionBg}"
                                                    BorderBrush="{StaticResource CrimsonMedallionBorder}" BorderThickness="1" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                           Foreground="{StaticResource AccentSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{DynamicResource Loc_Conv_Summary}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <Grid Margin="0,0,0,9">
                                            <TextBlock Text="{DynamicResource Loc_Conv_Mode}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SummaryModeText" Text="-" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="165"/>
                                        </Grid>
                                        <Border Height="1" Background="#1D1B25" Margin="0,0,0,9"/>

                                        <Grid Margin="0,0,0,9">
                                            <TextBlock Text="{DynamicResource Loc_Conv_Files}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                            <Border HorizontalAlignment="Right" Background="{StaticResource CrimsonMedallionBg}"
                                                    BorderBrush="{StaticResource CrimsonMedallionBorder}" BorderThickness="1" CornerRadius="7" Padding="8,1">
                                                <TextBlock x:Name="SummaryFilesText" Text="0" Foreground="#FF5C6E" FontSize="11.5" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                        <Border Height="1" Background="#1D1B25" Margin="0,0,0,9"/>

                                        <Grid Margin="0,0,0,9">
                                            <TextBlock Text="{DynamicResource Loc_Conv_Output}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                            <Border HorizontalAlignment="Right" Background="#14151E" BorderBrush="#292634" BorderThickness="1" CornerRadius="7" Padding="8,1">
                                                <TextBlock x:Name="SummaryOutputText" Text="-" Foreground="#E2E8F0" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <Border Height="1" Background="#1D1B25" Margin="0,0,0,9"/>

                                        <Grid Margin="0,0,0,14">
                                            <TextBlock Text="{DynamicResource Loc_Conv_Status}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SummaryEstimateText" Text="{DynamicResource Loc_Conv_Pending}" Foreground="#8C94A6" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>

                                        <ProgressBar x:Name="ConversionProgress" Height="7" Background="#0A0B11" BorderThickness="0" Foreground="{StaticResource CrimsonProgressBrush}"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                            <Ellipse x:Name="StatusIndicatorDot" Width="7" Height="7" Fill="#34D399" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StatusText" Text="{DynamicResource Loc_Conv_Ready}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Row 1: Interactive Open Output Folder Card (Animated Arrow Glide + Hover Glow) -->
                                <Grid Grid.Row="1" Cursor="Hand" MouseLeftButtonUp="OpenOutputFolderCard_MouseLeftButtonUp">
                                    <Border Style="{StaticResource LuxuryCardBorderStyle}" Padding="14"/>
                                    <Border x:Name="OpenFolderHoverBorder" CornerRadius="12" Background="#16E11D2E"
                                            BorderBrush="#7A293B" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                                    <Grid Margin="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9" Background="{StaticResource CrimsonMedallionBg}"
                                                BorderBrush="{StaticResource CrimsonMedallionBorder}" BorderThickness="1" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                       Foreground="{StaticResource AccentSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource Loc_Conv_OpenOutput}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource Loc_Conv_OpenOutputSub}" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock x:Name="OpenFolderArrow" Grid.Column="2" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="{StaticResource AccentSecondary}" VerticalAlignment="Center" Margin="6,0,2,0">
                                            <TextBlock.RenderTransform>
                                                <TranslateTransform x:Name="OpenFolderArrowSlide" X="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="OpenFolderHoverBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                                                    <DoubleAnimation Storyboard.TargetName="OpenFolderArrowSlide" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="OpenFolderHoverBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.20"/>
                                                    <DoubleAnimation Storyboard.TargetName="OpenFolderArrowSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.20">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>

                                <!-- Row 3: Flagship CONVERT Call-to-Action -->
                                <Border Grid.Row="3" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,12,0,0">
                                    <Button x:Name="ConvertButton" Content="{DynamicResource Loc_Conv_ConvertBtn}" Tag="CONVERT" Click="ConvertButton_Click"
                                            Height="56" VerticalAlignment="Bottom" FontSize="14.5" FontWeight="Bold" Foreground="White"
                                            Background="{StaticResource ConvertButtonBackground}"
                                            BorderBrush="#FF4F62" BorderThickness="1"
                                            Padding="18,0" IsEnabled="False" ToolTip="{DynamicResource Loc_Conv_ConvertTip}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid x:Name="ConvertRoot" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <ScaleTransform x:Name="ConvertScale" ScaleX="1" ScaleY="1"/>
                                                    </Grid.RenderTransform>

                                                    <!-- Soft Crimson Bloom Behind Enabled CTA -->
                                                    <Border x:Name="ConvertGlow" CornerRadius="12" Background="#E11D2E" Margin="2" Opacity="0.34" IsHitTestVisible="False">
                                                        <Border.Effect>
                                                            <BlurEffect Radius="18"/>
                                                        </Border.Effect>
                                                    </Border>

                                                    <Border x:Name="ButtonChrome" SnapsToDevicePixels="True"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock x:Name="ConvertButtonText"
                                                                           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                                           FontSize="{TemplateBinding FontSize}"
                                                                           FontWeight="{TemplateBinding FontWeight}"
                                                                           Foreground="{TemplateBinding Foreground}"
                                                                           VerticalAlignment="Center"/>
                                                                <TextBlock x:Name="ConvertButtonIcon" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="15" Foreground="{TemplateBinding Foreground}"
                                                                           VerticalAlignment="Center" Margin="10,0,0,0">
                                                                    <TextBlock.RenderTransform>
                                                                        <TranslateTransform x:Name="ConvertArrowSlide" X="0"/>
                                                                    </TextBlock.RenderTransform>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Top Specular Glass Rim -->
                                                    <Border x:Name="ConvertSheen" CornerRadius="12" BorderThickness="0,1,0,0"
                                                            BorderBrush="#40FFFFFF" IsHitTestVisible="False"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ConvertButtonHoverBackground}"/>
                                                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#FF6B7B"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertScale" Storyboard.TargetProperty="ScaleX" To="1.015" Duration="0:0:0.16">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertScale" Storyboard.TargetProperty="ScaleY" To="1.015" Duration="0:0:0.16">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertArrowSlide" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.18">
                                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                    </DoubleAnimation>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertGlow" Storyboard.TargetProperty="Opacity" To="0.54" Duration="0:0:0.18"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertArrowSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertGlow" Storyboard.TargetProperty="Opacity" To="0.34" Duration="0:0:0.18"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ConvertButtonPressedBackground}"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertScale" Storyboard.TargetProperty="ScaleX" To="0.975" Duration="0:0:0.08"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertScale" Storyboard.TargetProperty="ScaleY" To="0.975" Duration="0:0:0.08"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                                                    <DoubleAnimation Storyboard.TargetName="ConvertScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                    <Trigger Property="Tag" Value="CANCEL">
                                                        <Setter TargetName="ConvertButtonIcon" Property="Text" Value="&#xE711;"/>
                                                        <Setter TargetName="ButtonChrome" Property="Background" Value="#381822"/>
                                                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#A32E43"/>
                                                        <Setter TargetName="ConvertGlow" Property="Opacity" Value="0.18"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ConvertButtonDisabledBackground}"/>
                                                        <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#25222E"/>
                                                        <Setter TargetName="ConvertButtonIcon" Property="Foreground" Value="#5C6273"/>
                                                        <Setter TargetName="ConvertButtonText" Property="Foreground" Value="#6D7385"/>
                                                        <Setter TargetName="ConvertGlow" Property="Visibility" Value="Collapsed"/>
                                                        <Setter TargetName="ConvertSheen" Property="Opacity" Value="0.25"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Border>
                            </Grid>
                        </Grid>

                    </Grid>

                    <!-- Audio Editor View -->
                    <audio:AudioCutterView x:Name="AudioEditorGrid" Visibility="Collapsed" Margin="-12,0,-12,-12"/>
                    <audio:AudioSeparatorView x:Name="AudioSeparatorEditor" Visibility="Collapsed" Margin="-12,0,-12,-12"/>

                    <!-- Video Compressor View -->
                    <views:VideoCompressorView x:Name="VideoCompressorEditor" Visibility="Collapsed"/>

                    <!-- Video Cutter View -->
                    <views:VideoCutterView x:Name="VideoCutterEditor" Visibility="Collapsed" Margin="-12,0,-12,-12"/>
                </Grid>

            </Grid>
        </Border>

        <!-- Conversion Progress Overlay -->
        <Grid x:Name="ConversionOverlay" Background="#A0000000" Visibility="Collapsed" Panel.ZIndex="20">
            <Border Width="540"
                    Background="{StaticResource PanelBackgroundSubtle}"
                    BorderBrush="{StaticResource PanelBorderStrong}"
