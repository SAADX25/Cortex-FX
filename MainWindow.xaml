                                            AutomationProperties.Name="Tool status" ToolTip="{DynamicResource Loc_Settings_ToolStatusTip}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="8" Background="#20362D" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <TextBlock Text="&#xE9D9;" Style="{StaticResource SettingsIcon}" FontSize="15" Foreground="#89D8B0"/>
                                            </Border>
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#7F899A" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Loc_Settings_ToolStatus}" FontSize="12" Foreground="#EDF0F7" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{DynamicResource Loc_Settings_CheckAvail}" FontSize="11" FontWeight="Normal" Foreground="#A6AEBD" Margin="0,2,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="SettingsLogsButton" Grid.Column="2" Style="{StaticResource SettingsToolCard}" Click="OpenLogFolder_Click"
                                            AutomationProperties.Name="Open log folder" ToolTip="{DynamicResource Loc_Settings_LogFolderTip}">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="8" Background="#372D21" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                <Path Data="M2,5 H10 L13,8 H23 V21 H2 Z M2,10 H23" Width="17" Height="15" Stretch="Uniform"
                                                      Stroke="#E8BF7E" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                            </Border>
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#7F899A" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                                            <TextBlock Grid.Row="1" Text="{DynamicResource Loc_Settings_LogFolder}" FontSize="12" Foreground="#EDF0F7" Margin="0,4,0,0"/>
                                            <TextBlock Grid.Row="2" Text="{DynamicResource Loc_Settings_ViewDiag}" FontSize="11" FontWeight="Normal" Foreground="#A6AEBD" Margin="0,2,0,0"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>

                            <!-- Row 2: Flagship Language Switcher Card -->
                            <Border x:Name="SettingsLanguageCard" Grid.Row="2" Grid.ColumnSpan="3"
                                    CornerRadius="13" BorderBrush="#492534" BorderThickness="1" Padding="16">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#161722" Offset="0"/>
                                        <GradientStop Color="#1C141D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#29141E" BorderBrush="#572638" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE774;" Style="{StaticResource SettingsIcon}" FontSize="17" Foreground="#FF6B7F"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc_Settings_Language}" FontSize="13.5" FontWeight="SemiBold" Foreground="#F4F6FB"/>
                                        <TextBlock Text="{DynamicResource Loc_Settings_LanguageDesc}" Foreground="#A6AEBD" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <!-- Animated Obsidian-Crimson Segmented Language Switcher -->
                                    <Border Grid.Column="2" Background="#0D0E15" BorderBrush="#2C2634" BorderThickness="1"
                                            CornerRadius="10" Padding="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="LangEnRadio" Content="English" GroupName="AppLanguage" Tag="en"
                                                         Style="{StaticResource SettingsLangRadio}" Margin="0,0,4,0"
                                                         Click="LanguageOption_Click" AutomationProperties.Name="English language"/>
                                            <RadioButton x:Name="LangArRadio" Content="العربية" GroupName="AppLanguage" Tag="ar"
                                                         Style="{StaticResource SettingsLangRadio}"
                                                         Click="LanguageOption_Click" AutomationProperties.Name="Arabic language"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Row 4: App Updates Card -->
                            <Border x:Name="SettingsUpdateCard" Grid.Row="4" Grid.ColumnSpan="3" Background="#161821" CornerRadius="13" BorderBrush="#2B2C38" BorderThickness="1" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" Background="#28223A" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource SettingsIcon}" FontSize="17" Foreground="#BDA5F0"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource Loc_Settings_AppUpdates}" FontSize="13.5" FontWeight="SemiBold" Foreground="#EDF0F7"/>
                                            <Border Background="#231620" BorderBrush="#4C2635" BorderThickness="1" CornerRadius="5" Padding="6,1" Margin="9,-1,0,0">
                                                <TextBlock Text="{Binding Text, ElementName=VersionText}" FontSize="10" Foreground="#FF8C9C"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="UpdateStatusText" Text="{DynamicResource Loc_Settings_UpdatesDefault}"
                                                   Foreground="#A6AEBD" FontSize="11.5" LineHeight="17" TextWrapping="Wrap" Margin="0,5,0,0"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                    <Button x:Name="CheckForUpdatesButton" Grid.Column="2" Style="{StaticResource SettingsButton}"
                                            Click="CheckForUpdates_Click" VerticalAlignment="Center" AutomationProperties.Name="Check for updates">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{DynamicResource Loc_Settings_CheckUpdates}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="#25242E" BorderThickness="0,1,0,0" Padding="24,12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc_Settings_LocalPrivacy}" FontSize="11.5" Foreground="#99A3B3" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="SettingsDoneButton" Content="{DynamicResource Loc_Dlg_Done}" Click="CloseSettings_Click" Style="{StaticResource SettingsButton}" MinWidth="92" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
