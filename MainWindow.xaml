<Window x:Class="CortexFX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CortexFX"
        xmlns:ctrl="clr-namespace:CortexFX.Controls"
        xmlns:views="clr-namespace:CortexFX.Views"
        xmlns:ffme="clr-namespace:Unosquare.FFME;assembly=ffme.win"
        mc:Ignorable="d"
        Title="Cortex FX" Height="650" Width="850"
        MinWidth="950" MinHeight="650" ResizeMode="CanResize"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        Foreground="#E0E0E0"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Icon="logo.ico"
        Loaded="MainWindow_Loaded"
        KeyDown="Window_KeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="35" ResizeBorderThickness="5" CornerRadius="10" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Colors -->
        <SolidColorBrush x:Key="PrimaryBackground" Color="#181818"/>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#202020"/>
        <SolidColorBrush x:Key="CardBackground" Color="#252525"/>
        <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
        <SolidColorBrush x:Key="AccentHover" Color="#009BE0"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="BorderColor" Color="#333333"/>

        <!-- Global Effects -->
        <DropShadowEffect x:Key="ElevationShadow" BlurRadius="12" ShadowDepth="2" Opacity="0.3" Color="Black"/>
        <DropShadowEffect x:Key="GlowShadow" BlurRadius="15" ShadowDepth="0" Opacity="0.6" Color="Black"/>

        <!-- Button Style (Modern Pill) -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{StaticResource ElevationShadow}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#333333"/>
                    <Setter Property="Foreground" Value="#666666"/>
                    <Setter Property="Effect" Value="{x:Null}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Premium Nav Button Base Style -->
        <Style x:Key="PremiumNavBaseStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,15,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Glow" Background="{TemplateBinding Background}" CornerRadius="20" Opacity="0" Margin="-2">
                                <Border.Effect>
                                    <BlurEffect Radius="15"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="PillBorder" Background="{TemplateBinding Background}" 
                                    CornerRadius="20" BorderBrush="White" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="PillBorder" Property="Opacity" Value="1.0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0288D1" Offset="0"/>
                        <GradientStop Color="#29B6F6" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VideoNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D32F2F" Offset="0"/>
                        <GradientStop Color="#9C27B0" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AudioNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#388E3C" Offset="0"/>
                        <GradientStop Color="#00796B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DocumentNavStyle" TargetType="RadioButton" BasedOn="{StaticResource PremiumNavBaseStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF8F00" Offset="0"/>
                        <GradientStop Color="#FF6F00" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" 
                        Grid.ColumnSpan="2"
                        CornerRadius="2"
                        Background="{StaticResource SecondaryBackground}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1" />
                <Path x:Name="Arrow" 
                      Grid.Column="1" 
                      Fill="{StaticResource TextSecondary}"
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Data="M0,0 L0,2 L4,6 L8,2 L8,0 L4,4 z" />
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Grid.Column="2" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="6,3,23,3"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     Style="{x:Null}" 
                                     Template="{x:Null}" 
                                     HorizontalAlignment="Left" 
                                     VerticalAlignment="Center" 
                                     Margin="3,3,23,3"
                                     Focusable="True" 
                                     Background="Transparent"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"/>
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#2D2D30"
                                            BorderThickness="1"
                                            BorderBrush="{StaticResource BorderColor}"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Border" 
                                            Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#3E3E42"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ListBox Style -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#2D2D30" CornerRadius="4" BorderBrush="#3E3E42" BorderThickness="1" Margin="0,2">
                            <Grid Margin="10,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                    <ColumnDefinition Width="*"/>    <!-- Name -->
                                    <ColumnDefinition Width="Auto"/> <!-- Status -->
                                    <ColumnDefinition Width="Auto"/> <!-- Remove -->
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📄" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Grid.Column="1"/>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" VerticalAlignment="Center" Margin="10,0,10,0" Grid.Column="2" FontSize="12"/>
                                <Button Content="✕" Grid.Column="3" Click="RemoveFile_Click" Tag="{Binding FullPath}"
                                        Background="Transparent" Foreground="#FF5555" BorderThickness="0" Padding="8,0" Cursor="Hand"
                                        FontSize="14" FontWeight="Bold"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Border Background="#181818" CornerRadius="10" BorderBrush="#3E3E42" BorderThickness="1">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/> <!-- Custom Title Bar -->
                    <RowDefinition Height="Auto"/> <!-- Category Selector -->
                    <RowDefinition Height="*"/>    <!-- Main Content (Scrollable) -->
                    <RowDefinition Height="Auto"/> <!-- Footer (Fixed) -->
                </Grid.RowDefinitions>

                <!-- Custom Title Bar (Row 0) -->
                <Grid Grid.Row="0" Background="#1E1E1E">
                    <!-- Title & Icon -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                        <Image Source="logo.ico" Width="20" Height="20" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Cortex FX" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Center Version Indicator -->
                    <TextBlock x:Name="VersionText" Text="v0.5.0" 
                               Foreground="#00E5FF" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Window Controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⚙️" Background="Transparent" Foreground="#AAAAAA" FontSize="14" Click="SettingsButton_Click" Padding="10,0" Width="40" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="_" Click="MinimizeButton_Click" Background="Transparent" Foreground="White" FontSize="14" Padding="10,0" Width="40" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Click="CloseButton_Click" Background="Transparent" Foreground="White" FontSize="14" Padding="10,0" Width="40" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E81123"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Category Selector (Row 1) -->
                <StackPanel x:Name="TopNavPanel" Grid.Row="1" Orientation="Horizontal" Margin="20,15,20,15" Visibility="Collapsed">
                    <RadioButton x:Name="RadioImage" Style="{StaticResource ImageNavStyle}" GroupName="Category" Click="Category_Click" Tag="Image">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Image" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton x:Name="RadioVideo" Style="{StaticResource VideoNavStyle}" GroupName="Category" Click="Category_Click" Tag="Video">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Video" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton x:Name="RadioAudio" Style="{StaticResource AudioNavStyle}" GroupName="Category" Click="Category_Click" Tag="Audio">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Audio" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton x:Name="RadioDocument" Style="{StaticResource DocumentNavStyle}" GroupName="Category" Click="Category_Click" Tag="Document">
                         <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Document" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Scrollable Content (Row 2) -->
                <Grid Grid.Row="2" Margin="20,0,10,0">
                    <!-- Dashboard View -->
                    <ScrollViewer x:Name="DashboardView" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Popular Tools" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,10,0,15"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <!-- PDF to Word -->
                                <ctrl:ToolCard Title="PDF to Word" 
                                               IconBackground="#2B579A" Margin="0,0,15,15" MouseDown="ToolCard_MouseDown" Tag="PDF_DOCX">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M16,11V13H13V15H16V17H13V19H11V11H16Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- Word to PDF -->
                                <ctrl:ToolCard Title="Word to PDF" 
                                               IconBackground="#2B579A" Margin="0,0,15,15" MouseDown="ToolCard_MouseDown" Tag="DOCX_PDF">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M15,16H13V19H11V16H9V14H11V11H13V14H15V16Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- PDF to PowerPoint -->
                                <ctrl:ToolCard Title="PDF to PowerPoint" 
                                               IconBackground="#D24726" Margin="0,0,15,15" MouseDown="ToolCard_MouseDown" Tag="PDF_PPTX">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M16,13H13V19H11V13H8V11H16V13Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- PowerPoint to PDF -->
                                <ctrl:ToolCard Title="PowerPoint to PDF" 
                                               IconBackground="#D24726" Margin="0,0,15,15" MouseDown="ToolCard_MouseDown" Tag="PPTX_PDF">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M16,15H13V19H11V15H9V13H11V10H13V13H16V15Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- Excel to PDF -->
                                <ctrl:ToolCard Title="Excel to PDF" 
                                               IconBackground="#217346" Margin="0,0,15,15" MouseDown="ToolCard_MouseDown" Tag="XLSX_PDF">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M16,17H8V15H16V17M16,13H8V11H16V13M16,9H8V7H16V9Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- PDF to Image -->
                                <ctrl:ToolCard Title="PDF to Image" 
                                               IconBackground="#FBC02D" Margin="0,0,15,15" MouseDown="ToolCard_MouseDown" Tag="PDF_JPG">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M11,15L13,18L16,14L20,19H4L8,13L11,15Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>

                                <!-- Watermark Remover -->
                                <Border Background="#252525" CornerRadius="15" Width="150" Height="150" Margin="0,0,15,15" Cursor="Hand" Tag="WATERMARK_REMOVER" MouseDown="ToolCard_MouseDown">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1.0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="50" Height="50" CornerRadius="25" Background="#FF2D55" Margin="0,0,0,10">
                                            <Path Data="M16.24,3.56L21.19,8.5C21.97,9.29 21.97,10.55 21.19,11.34L12,20.53C10.44,22.09 7.91,22.09 6.34,20.53L2.81,17C2.03,16.21 2.03,14.95 2.81,14.16L13.41,3.56C14.2,2.78 15.46,2.78 16.24,3.56M4.22,15.58L7.76,19.11C8.54,19.9 9.8,19.9 10.59,19.11L14.12,15.58L9.17,10.63L4.22,15.58Z" 
                                                  Fill="White" Stretch="Uniform" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Watermark Remover" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- Video Compressor -->
                                <Border Background="#252525" CornerRadius="15" Width="150" Height="150" Margin="0,0,15,15" Cursor="Hand" Tag="VIDEO_COMPRESSOR" MouseDown="ToolCard_MouseDown">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1.0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.8"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="4" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Border Width="50" Height="50" CornerRadius="25" Margin="0,0,0,10">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#6C63FF" Offset="0"/>
                                                    <GradientStop Color="#3F51B5" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Path Data="M17.25,12L10,17.94V6.06L17.25,12M21.5,4L17.5,4L17.5,2L6.5,2L6.5,4L2.5,4L2.5,6L6.5,6L6.5,8L2.5,8L2.5,10L6.5,10L6.5,20L2.5,20L2.5,22L21.5,22L21.5,20L17.5,20L17.5,10L21.5,10L21.5,8L17.5,8L17.5,6L21.5,6L21.5,4Z" 
                                                  Fill="White" Stretch="Uniform" Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Video Compressor" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- More Tools (+) -->
                                <ctrl:ToolCard Title="More Tools" 
                                               IconBackground="#333333" Margin="0,0,15,15" MouseDown="ToolCard_MouseDown" Tag="MORE_TOOLS">
                                    <ctrl:ToolCard.IconData>
                                        <PathGeometry Figures="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                                    </ctrl:ToolCard.IconData>
                                </ctrl:ToolCard>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Conversion View (Hidden by default) -->
                    <Grid x:Name="ConversionView" Margin="0,0,10,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- DropZone -->
                            <RowDefinition Height="*"/>    <!-- FileList -->
                        </Grid.RowDefinitions>

                        <!-- Back Button Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Button x:Name="BackBtn" HorizontalAlignment="Left" Background="Transparent" 
                                    BorderThickness="0" Padding="0" Click="BackToHome_Click" Cursor="Hand" Width="30" Height="30">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BackBorder" CornerRadius="15" Background="Transparent">
                                            <TextBlock Text="🡠" FontSize="20" Foreground="{StaticResource AccentColor}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,2,2"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BackBorder" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock x:Name="CurrentToolTitle" Text="PDF to Word" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18" Foreground="White" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Drop Zone -->
                        <Border Grid.Row="1" x:Name="DropZone" 
                                Height="160"
                                Background="#05FFFFFF" 
                                BorderBrush="{StaticResource AccentColor}" 
                                BorderThickness="2" 
                                CornerRadius="16" 
                                AllowDrop="True"
                                Drop="DropZone_Drop"
                                DragEnter="DropZone_DragEnter"
                                DragLeave="DropZone_DragLeave"
                                MouseLeftButtonUp="DropZone_Click"
                                Cursor="Hand"
                                Margin="0,0,0,25">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.25" Color="Black"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="☁" FontSize="56" HorizontalAlignment="Center" Foreground="{StaticResource AccentColor}"/>
                                <TextBlock Text="Drag &amp; Drop Files Here" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- StrokeDashArray is not a property of Border in WPF, removing it -->
                                </Style>
                            </Border.Style>
                        </Border>
    
                        <!-- File List Preview -->
                        <Grid Grid.Row="2" Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Selected Files" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                            <ListBox Grid.Row="1" x:Name="FilesList" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#1A1A1A" BorderThickness="0" Foreground="#CCCCCC" Padding="5"/>
                        </Grid>

                        <!-- Audio Editor Grid (Replaces DropZone/Files when active) -->
                        <Grid x:Name="AudioEditorGrid" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="#1E1E1E" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>    <!-- Waveform -->
                                <RowDefinition Height="Auto"/> <!-- Controls -->
                            </Grid.RowDefinitions>

                            <!-- Waveform Area -->
                            <Border Grid.Row="0" Background="#111111" CornerRadius="12" BorderBrush="#00E5FF" BorderThickness="1" Margin="0,0,0,15" ClipToBounds="True">
                                <Grid x:Name="WaveformContainer" MouseLeftButtonDown="Waveform_MouseLeftButtonDown">
                                    <!-- The Waveform Visual -->
                                    <Polyline x:Name="WaveformLine" Stroke="#00E5FF" StrokeThickness="1" Points="" VerticalAlignment="Center" Stretch="Fill"/>
             
                                    <!-- Dimmed Overlay Logic -->
                                    <!-- Left Dim (Before Start) -->
                                    <Rectangle x:Name="DimLeft" Fill="#AA000000" HorizontalAlignment="Left" Width="0" Height="NaN" Visibility="Visible"/>
                                    
                                    <!-- Right Dim (After End) -->
                                    <Rectangle x:Name="DimRight" Fill="#AA000000" HorizontalAlignment="Left" Width="0" Height="NaN" Visibility="Visible"/>

                                    <!-- Start Marker (Cyan Line) -->
                                    <Rectangle x:Name="StartMarker" Width="2" Fill="#00E5FF" HorizontalAlignment="Left" Visibility="Visible"/>
                                    
                                    <!-- End Marker (Pink Line) -->
                                    <Rectangle x:Name="EndMarker" Width="2" Fill="#FF4081" HorizontalAlignment="Left" Visibility="Visible"/>
             
                                    <!-- Playback Cursor (Needle) -->
                                    <Line x:Name="PlaybackCursor" X1="0" Y1="0" X2="0" Y2="2000" Stroke="#FF0055" StrokeThickness="2" Visibility="Visible"/>
                                </Grid>
                            </Border>

                            <!-- Controls Row -->
                        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center">
                            <!-- Time Display -->
                            <TextBlock x:Name="TimeDisplay" Text="Start: 00:00.000 | End: 00:00.000 | Duration: 00:00.000" 
                                       Foreground="#00E5FF" FontFamily="Consolas" FontSize="16" FontWeight="Bold" 
                                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Volume Control -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                    <TextBlock Text="🔊" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Slider x:Name="VolumeSlider" Width="100" Minimum="0" Maximum="1" Value="1" TickFrequency="0.1" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
                                </StackPanel>
    
                                <Button x:Name="SetStartBtn" Click="SetStart_Click" Margin="0,0,10,0" Width="130" Height="40" Cursor="Hand" BorderThickness="0" Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" CornerRadius="15" BorderThickness="1" BorderBrush="#00B8D4">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#00838F" Offset="0"/>
                                                    <GradientStop Color="#00E5FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="[ " Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>
                                                <TextBlock Text="Set Start" Foreground="White" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                                <Setter TargetName="border" Property="Effect">
                                                    <Setter.Value>
                                                         <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="SetEndBtn" Click="SetEnd_Click" Margin="0,0,20,0" Width="130" Height="40" Cursor="Hand" BorderThickness="0" Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" CornerRadius="15" BorderThickness="1" BorderBrush="#F50057">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#C2185B" Offset="0"/>
                                                    <GradientStop Color="#FF4081" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="Set End" Foreground="White" FontWeight="Bold" Margin="0,0,5,0"/>
                                                <TextBlock Text=" ]" Foreground="White" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                                <Setter TargetName="border" Property="Effect">
                                                    <Setter.Value>
                                                         <DropShadowEffect Color="#FF4081" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
        
                            <Button x:Name="PlaySelectionBtn" Click="PlaySelection_Click" Margin="0,0,10,0" Width="160" Height="40" Cursor="Hand" BorderThickness="0" Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" CornerRadius="15" BorderThickness="1" BorderBrush="#00C853">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2E7D32" Offset="0"/>
                                                    <GradientStop Color="#64DD17" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="▶" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" FontSize="14"/>
                                                <TextBlock Text="Play Selection" Foreground="White" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                                <Setter TargetName="border" Property="Effect">
                                                    <Setter.Value>
                                                         <DropShadowEffect Color="#64DD17" BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                                <Button Content="💾 Save Selection" Click="SaveSelection_Click" Width="130" Background="#007ACC" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
        
                                <Button Content="Cancel" Click="CloseAudioEditor_Click" Margin="20,0,0,0" Background="Transparent" Foreground="#FF5555" BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>
                        </Grid>
    
                    </Grid>

                    <!-- Watermark Remover View (extracted to Views/WatermarkRemoverView.xaml) -->
                    <views:WatermarkRemoverView x:Name="WatermarkEditor" Visibility="Collapsed"/>

                    <!-- Video Compressor View -->
                    <views:VideoCompressorView x:Name="VideoCompressorEditor" Visibility="Collapsed"/>
                </Grid>

                <!-- Fixed Footer (Row 3) -->
                <Border Grid.Row="3" Visibility="{Binding Visibility, ElementName=ConversionView}" Background="#252526" CornerRadius="16,16,0,0" Padding="20" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Configurations -->
                            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                <!-- Row 0: Output Path -->
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBox x:Name="OutputPathBox" Grid.Column="0" Height="35" VerticalContentAlignment="Center" 
                                             Background="#1E1E1E" Foreground="#E0E0E0" BorderThickness="0" Padding="10,0" Margin="0,0,10,0">
                                        <TextBox.Resources>
                                            <Style TargetType="{x:Type Border}">
                                                <Setter Property="CornerRadius" Value="8"/>
                                            </Style>
                                        </TextBox.Resources>
                                        <!-- Placeholder Text using a trick (optional but nice) -->
                                    </TextBox>
                                    <!-- Placeholder Text Overlay -->
                                    <TextBlock Text="Select Output Folder..." Foreground="#666666" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=OutputPathBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button x:Name="BrowseButton" Grid.Column="1" Click="BrowseButton_Click" 
                                            Height="35" Padding="15,0" Cursor="Hand" BorderThickness="0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder" CornerRadius="8" BorderBrush="#FFA000" BorderThickness="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFD54F" Offset="0"/>
                                                            <GradientStop Color="#FFC107" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#FFE082" Offset="0"/>
                                                                    <GradientStop Color="#FFC107" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#3E2723" VerticalAlignment="Center"/>
                                            <TextBlock Text="Browse" FontSize="14" FontWeight="SemiBold" Foreground="#3E2723" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <TextBlock x:Name="OutputWarningText" Text="⚠️ Select output folder" Foreground="#FF5555" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,100,0" Visibility="Collapsed"/>
                                </Grid>

                                <!-- Row 1: Format & Quality & Advanced -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Format -->
                                        <ColumnDefinition Width="Auto"/> <!-- Quality -->
                                        <ColumnDefinition Width="*"/>    <!-- Advanced -->
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Format Selector -->
                                    <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                        <TextBlock Text="Format" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" FontSize="12"/>
                                        <ComboBox x:Name="FormatComboBox" Width="100" Height="35" 
                                                  SelectedIndex="0" SelectionChanged="FormatComboBox_SelectionChanged"/>
                                    </StackPanel>

                                    <!-- Quality -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Quality" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5" FontSize="12"/>
                                        <Grid Width="250">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Size" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Slider Grid.Column="1" x:Name="QualitySlider" Minimum="0" Maximum="100" Value="75" 
                                                    AutoToolTipPlacement="TopLeft" IsSnapToTickEnabled="True" TickFrequency="5" 
                                                    VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="Quality" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Advanced Settings (Expand Up) -->
                                    <Expander Grid.Column="2" Header="Advanced" ExpandDirection="Up" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right">
                                        <Border Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#333333" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <CheckBox x:Name="chkCreateSubfolder" Content="Subfolder" Foreground="{StaticResource TextSecondary}" IsChecked="True" Margin="0,0,15,0"/>
                                                    <CheckBox x:Name="chkMergePdf" Content="Merge PDF" Foreground="{StaticResource TextSecondary}" Margin="0,0,15,0"/>
                                                </StackPanel>
                                                
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Resize -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                                        <TextBlock Text="Resize:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBox x:Name="ResizeWidthBox" Width="50" Height="25" VerticalContentAlignment="Center" Background="#101010" Foreground="White" BorderThickness="0" PreviewTextInput="NumberValidationTextBox"/>
                                                        <TextBlock Text="x" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="5,0"/>
                                                        <TextBox x:Name="ResizeHeightBox" Width="50" Height="25" VerticalContentAlignment="Center" Background="#101010" Foreground="White" BorderThickness="0" PreviewTextInput="NumberValidationTextBox"/>
                                                        <CheckBox x:Name="AspectRatioCheckBox" Content="Ratio" Foreground="{StaticResource TextSecondary}" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>
                                                    </StackPanel>

                                                    <!-- Extra hidden but required fields to avoid build errors -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                                                        <TextBox x:Name="DpiBox" Text="300"/>
                                                        <CheckBox x:Name="SharpenCheckBox"/>
                                                        <CheckBox x:Name="GrayscaleCheckBox"/>
                                                        <CheckBox x:Name="AutoEnhanceCheckBox"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Grid>
                            </StackPanel>

                            <!-- Column 1: Big Action Button -->
                            <Button x:Name="ConvertButton" Grid.Column="1" Content="CONVERT" 
                                    Click="ConvertButton_Click" 
                                    MinWidth="130" Height="60" VerticalAlignment="Center" Margin="20,0,0,0"
                                    FontSize="16" FontWeight="Bold" Foreground="White" BorderThickness="0">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#007ACC" Offset="0.0"/>
                                        <GradientStop Color="#005A9E" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Button.Background>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                            <Grid>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.4" Color="Black"/>
                                </Button.Effect>
                            </Button>
                        </Grid>

                        <!-- Progress Section (Row 1) -->
                        <StackPanel Grid.Row="1">
                             <ProgressBar x:Name="ConversionProgress" Height="4" Background="#333333" BorderThickness="0" Foreground="{StaticResource AccentColor}"/>
                             <Grid Margin="0,5,0,0">
                                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                             </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Success Overlay -->
        <Grid x:Name="SuccessOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#252525" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40" BorderBrush="{StaticResource AccentColor}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎉" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="All Tasks Finished!" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <Button Content="Great!" Click="CloseOverlay_Click" Width="150" Height="40" FontSize="16"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Audio Choice Overlay -->
        <Grid x:Name="AudioChoiceOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#252525" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Width="500">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Audio Detected" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBlock Text="What would you like to do with this file?" FontSize="14" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                    
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Option A: Trim / Cut -->
                        <Button Grid.Column="0" Click="TrimChoice_Click" Height="140" Cursor="Hand" BorderThickness="0" Background="Transparent">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="TrimBorder" CornerRadius="12" Background="#1E1E1E" BorderBrush="#00E5FF" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="✂" FontSize="40" Foreground="#00E5FF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Trim / Cut" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Open Waveform Editor" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TrimBorder" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.1">
                                                        <GradientStop Color="#00E5FF" Offset="0"/>
                                                        <GradientStop Color="Transparent" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="TrimBorder" Property="Effect">
                                                 <Setter.Value>
                                                     <DropShadowEffect Color="#00E5FF" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                                                 </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <!-- Option B: Convert Format -->
                        <Button Grid.Column="2" Click="ConvertChoice_Click" Height="140" Cursor="Hand" BorderThickness="0" Background="Transparent">
                             <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ConvertBorder" CornerRadius="12" Background="#1E1E1E" BorderBrush="#D500F9" BorderThickness="1">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="🔄" FontSize="40" Foreground="#D500F9" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="Convert" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Change Format (MP3/WAV)" FontSize="11" Foreground="#888888" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ConvertBorder" Property="Background">
                                                <Setter.Value>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.1">
                                                        <GradientStop Color="#D500F9" Offset="0"/>
                                                        <GradientStop Color="#FF6D00" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="ConvertBorder" Property="Effect">
                                                 <Setter.Value>
                                                     <DropShadowEffect Color="#D500F9" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                                                 </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    
                    <Button Content="Cancel" Click="CancelChoice_Click" Background="Transparent" Foreground="#666666" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Settings Overlay -->
        <Grid x:Name="SettingsOverlay" Background="#CC000000" Visibility="Collapsed">
            <Border Background="#252525" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" Width="400">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                    
                    <CheckBox x:Name="ContextMenuCheckBox" Content="Add 'Convert with Cortex FX' to Context Menu" 
                              Foreground="{StaticResource TextPrimary}" FontSize="14" Margin="0,0,0,20"
                              Checked="ContextMenuCheckBox_Checked" Unchecked="ContextMenuCheckBox_Unchecked">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </CheckBox.LayoutTransform>
                    </CheckBox>

                    <Button Content="Close" Click="CloseSettings_Click" Width="100" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
