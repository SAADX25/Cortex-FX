<Window x:Class="CortexFX.Dialogs.ModernConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm"
        Width="420" Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="#13141A" CornerRadius="12" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E11D2E" Offset="0"/>
                <GradientStop Color="#473039" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TitleText" Grid.Row="0" Text="Close Video"
                       FontSize="18" FontWeight="SemiBold" Foreground="White"
                       FontFamily="Segoe UI" Margin="0,0,0,8"/>

            <!-- Message -->
            <TextBlock x:Name="MessageText" Grid.Row="1"
                       Text="Do you want to close the current video?"
                       FontSize="13.5" Foreground="#B6BAC4"
                       FontFamily="Segoe UI" TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <!-- No, Stay -->
                <Button x:Name="BtnNo" Content="No, Stay" Click="BtnNo_Click"
                        MinWidth="100" Height="36" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand" Margin="0,0,12,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="#B6BAC4"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" Background="#1A1519" CornerRadius="8"
                                                BorderBrush="#2B2026" BorderThickness="1"
                                                Padding="18,6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background" Value="#23171D"/>
                                                <Setter TargetName="bg" Property="BorderBrush" Value="#473039"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Yes, Close -->
                <Button x:Name="BtnYes" Content="Yes, Close" Click="BtnYes_Click"
                        MinWidth="100" Height="36" FontSize="13" FontWeight="SemiBold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bg" CornerRadius="8" Padding="18,6">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#8B1119" Offset="0"/>
                                                    <GradientStop Color="#E11D2E" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#B91C1C" Offset="0"/>
                                                            <GradientStop Color="#FF3348" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="bg" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FF3348" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
