<Window x:Class="CortexFX.Dialogs.ResourceStatusDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Tool status" Width="650" Height="640" MinHeight="440" WindowStartupLocation="CenterOwner"
 ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
 FontFamily="Segoe UI" Foreground="#EDF0F7" UseLayoutRounding="True" KeyboardNavigation.TabNavigation="Cycle">
 <Window.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/CortexFX;component/Views/Settings/SettingsTheme.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style TargetType="ScrollBar"><Setter Property="Width" Value="6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#11141B"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#4E5667" Margin="5,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
   <Style TargetType="Expander"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
    <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" Cursor="Hand" HorizontalContentAlignment="Left"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" Padding="1,7"><StackPanel Orientation="Horizontal"><TextBlock x:Name="Chevron" Text="›" FontSize="16" Foreground="#A6AEBD" Margin="0,0,9,0" RenderTransformOrigin="0.5,0.5"/><ContentPresenter VerticalAlignment="Center"/></StackPanel></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template><ContentPresenter Content="{TemplateBinding Header}"/></ToggleButton>
    <ContentPresenter x:Name="ExpandedContent" Content="{TemplateBinding Content}" Visibility="Collapsed"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
   <DataTemplate x:Key="ToolRow">
    <Border Background="#191D26" BorderBrush="#2E3542" BorderThickness="1" CornerRadius="10" Padding="13,11" Margin="0,0,0,8">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Border Width="28" Height="28" Background="{Binding Background}" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{Binding Foreground}" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
      <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#A6AEBD" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="16"/></StackPanel>
      <Border Grid.Column="2" Background="{Binding Background}" CornerRadius="7" Padding="9,5" VerticalAlignment="Center"><TextBlock Text="{Binding Status}" Foreground="{Binding Foreground}" FontSize="11" FontWeight="SemiBold"/></Border>
     </Grid>
    </Border>
   </DataTemplate>
  </ResourceDictionary>
 </Window.Resources>
 <Border x:Name="DialogSurface" Background="#11141B" BorderBrush="#363C49" BorderThickness="1" CornerRadius="14">
  <Grid Margin="22,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,17">
    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Width="36" Height="36" Background="#22372F" CornerRadius="10" VerticalAlignment="Center" HorizontalAlignment="Left"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="#89D8B0" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel Grid.Column="1" MouseLeftButtonDown="Header_MouseLeftButtonDown"><TextBlock Text="{DynamicResource Loc_Res_Title}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Loc_Res_Subtitle}" Foreground="#A6AEBD" FontSize="12" Margin="0,5,0,0"/></StackPanel>
    <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource SettingsButton}" Width="30" Height="30" MinHeight="30" Padding="0" VerticalAlignment="Top" Click="Close_Click" ToolTip="{DynamicResource Loc_Dlg_Close}" AutomationProperties.Name="Close tool status"/>
   </Grid>
   <Border x:Name="SummaryPanel" Grid.Row="1" Background="#1C3029" BorderBrush="#355144" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,17">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock x:Name="SummaryHeading" Text="{Binding Heading}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#B3C8BE" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="16"/></StackPanel><TextBlock x:Name="SummaryCount" Grid.Column="1" Text="{Binding Count}" Foreground="#B2E5C7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid>
   </Border>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,9,0">
    <StackPanel>
     <TextBlock Text="{DynamicResource Loc_Res_Included}" Foreground="#919CAB" FontSize="10" FontWeight="SemiBold" Margin="1,0,0,10"/>
     <ItemsControl x:Name="CoreToolList" ItemsSource="{Binding CoreTools}" ItemTemplate="{StaticResource ToolRow}"/>
     <Expander x:Name="AdditionalFeatures" Header="{DynamicResource Loc_Res_Additional}" Foreground="#ADB6C5" FontSize="12" Margin="0,4,0,0"><ItemsControl x:Name="OptionalToolList" ItemsSource="{Binding OptionalTools}" ItemTemplate="{StaticResource ToolRow}" Margin="0,8,0,0"/></Expander>
     <Expander x:Name="TechnicalDetails" Header="{DynamicResource Loc_Res_TechDetails}" Foreground="#ADB6C5" FontSize="12" Margin="0,10,0,8">
      <StackPanel Margin="0,10,0,0"><TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="170" VerticalScrollBarVisibility="Auto" Background="#191D26" Foreground="#B4BDCC" BorderBrush="#323A48" Padding="10" FontSize="11"/><Button x:Name="CopyDetailsButton" Content="{DynamicResource Loc_Dlg_CopyDetails}" Click="CopyDetails_Click" Style="{StaticResource SettingsButton}" HorizontalAlignment="Left" Margin="0,9,0,0"/></StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="3" Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Button Content="{DynamicResource Loc_Res_Recheck}" Click="Recheck_Click" Style="{StaticResource SettingsButton}"/>
    <Button x:Name="OpenToolsButton" Grid.Column="1" Content="{DynamicResource Loc_Res_OpenTools}" Click="OpenTools_Click" Style="{StaticResource SettingsButton}" Margin="8,0,0,0"/>
    <Button Grid.Column="3" Content="{DynamicResource Loc_Dlg_Done}" Click="Close_Click" IsCancel="True" IsDefault="True" Style="{StaticResource SettingsPrimaryButton}" MinWidth="86"/>
   </Grid>
  </Grid>
 </Border>
</Window>
