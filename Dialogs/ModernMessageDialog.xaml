<Window x:Class="CortexFX.Dialogs.ModernMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cortex FX"
        Width="428" MinHeight="178" SizeToContent="Height"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" KeyboardNavigation.TabNavigation="Cycle"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="-2" CornerRadius="7" BorderBrush="#6B7280"
                                BorderThickness="1.2" IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleDialogButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource DialogFocusVisual}"/>
            <Setter Property="Foreground" Value="#A1A7B3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#32353F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#252730"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#464A57"/>
                                <Setter Property="Foreground" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="10" Background="#1B1C22" BorderBrush="#333640" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid Style="{DynamicResource RefinedEntranceStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Minimal Draggable Studio Header -->
            <Grid Grid.Row="0" Background="Transparent" Margin="18,12,12,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/CortexFX;component/Assets/logo.ico" Width="14" Height="14"
                           Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Cortex FX" FontSize="11" FontWeight="SemiBold" Foreground="#8C93A0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="CloseCornerBtn" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="24" Height="24" Cursor="Hand" Click="BtnOk_Click"
                        ToolTip="Close (Esc)" AutomationProperties.Name="Close dialog">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9.5"
                                           Foreground="#858B97" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#2A2D36"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="20,12,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="IconBadge" Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        Background="#252832" VerticalAlignment="Top" Margin="0,1,13,0">
                    <TextBlock x:Name="IconGlyph" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                               FontSize="16" Foreground="#93C5FD"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Notice"
                               FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F6"
                               TextWrapping="Wrap" LineHeight="21"/>
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,5,0,0">
                        <TextBlock x:Name="MessageText" Text=""
                                   FontSize="12.5" Foreground="#A5ABB8" LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <!-- Clean Matte Footer -->
            <Border Grid.Row="2" Background="#16171C" BorderBrush="#292B33" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Padding="18,11">
                <Grid>
                    <Button x:Name="BtnCopy" Content="Copy details" Click="BtnCopy_Click"
                            Style="{StaticResource SubtleDialogButton}" HorizontalAlignment="Left"
                            Visibility="Collapsed"/>

                    <Button x:Name="BtnOk" Content="OK" Click="BtnOk_Click"
                            FocusVisualStyle="{StaticResource DialogFocusVisual}"
                            IsDefault="True" IsCancel="True"
                            MinWidth="88" Height="32" FontSize="12.5" FontWeight="SemiBold"
                            HorizontalAlignment="Right" Cursor="Hand" Foreground="#F3F4F6">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="18,4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Chrome" Property="Opacity" Value="0.74"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
