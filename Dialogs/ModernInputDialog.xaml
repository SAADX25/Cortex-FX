<Window x:Class="CortexFX.Dialogs.ModernInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input"
        Width="444" MinHeight="196" SizeToContent="Height"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" KeyboardNavigation.TabNavigation="Cycle"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="InputFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Margin="-2" CornerRadius="7" BorderBrush="#4EA1FF"
                                BorderThickness="1.2" IsHitTestVisible="False"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" Background="#1B1C22" CornerRadius="10" BorderBrush="#333640" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid Style="{DynamicResource RefinedEntranceStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Background="Transparent" Margin="18,12,12,0"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/CortexFX;component/Assets/logo.ico" Width="14" Height="14"
                           Margin="0,0,7,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Cortex FX" FontSize="11" FontWeight="SemiBold" Foreground="#8C93A0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="24" Height="24" Cursor="Hand" Click="BtnCancel_Click"
                        ToolTip="Cancel (Esc)" AutomationProperties.Name="Cancel dialog">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="9.5"
                                           Foreground="#858B97" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#2A2D36"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="20,12,20,16">
                <TextBlock x:Name="TitleText" Text="Project Name"
                           FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F6"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Text="Enter a name for this saved project:"
                           FontSize="12.5" Foreground="#A5ABB8" TextWrapping="Wrap" Margin="0,5,0,11"/>
                <TextBox x:Name="InputBox" Height="34" Padding="10,0"
                         Background="#12141A" Foreground="#F3F4F6"
                         BorderBrush="#373E4E" BorderThickness="1"
                         CaretBrush="#4EA1FF" SelectionBrush="#2D8CFF"
                         FontSize="13" VerticalContentAlignment="Center"
                         MaxLength="64">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="BoxBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#2D8CFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </StackPanel>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#16171C" BorderBrush="#292B33" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10" Padding="18,11">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                            FocusVisualStyle="{StaticResource InputFocusVisual}" IsCancel="True"
                            MinWidth="88" Height="32" FontSize="12.5" FontWeight="SemiBold"
                            Cursor="Hand" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#C4CAD4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="#22242C" CornerRadius="6"
                                                    BorderBrush="#353844" BorderThickness="1" Padding="14,4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#2C2F39"/>
                                                    <Setter TargetName="bg" Property="BorderBrush" Value="#484C5C"/>
                                                    <Setter Property="Foreground" Value="#F3F4F6"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bg" Property="Opacity" Value="0.78"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button x:Name="BtnOk" Content="Save" Click="BtnOk_Click"
                            FocusVisualStyle="{StaticResource InputFocusVisual}" IsDefault="True"
                            MinWidth="104" Height="32" FontSize="12.5" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="#2172D4" BorderBrush="#4CA1FF"
                                                    BorderThickness="1" CornerRadius="6" Padding="16,4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#2B84EF"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bg" Property="Opacity" Value="0.78"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
